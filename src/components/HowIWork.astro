---
---
<section id="how-i-work" class="journey-section">
  <div class="journey-container">
    
    <div class="section-kicker" data-es="Proceso Humano" data-en="Human Process">
      Proceso Humano
    </div>

    <div class="journey-header">
      <h2 data-es="Cómo trabajo." data-en="How I work.">Cómo trabajo.</h2>
      <p data-es="Un camino creativo estructurado que conecta empatía, dirección y optimización continua."
         data-en="A structured creative journey connecting empathy, direction, and continuous optimization.">
        Un camino creativo estructurado que conecta empatía, dirección y optimización continua.
      </p>
    </div>

    <!-- RECORRIDO VERTICAL CON LÍNEA CONECTORA -->
    <div class="vertical-path-track">
      <div class="spine-line"></div>

      <!-- PASO 1 -->
      <div class="journey-milestone">
        <div class="node-bullet">01</div>
        <div class="milestone-box">
          <h3 data-es="1. Entendemos la idea" data-en="1. Understanding the idea">1. Entendemos la idea</h3>
          <p data-es="Conozco el objetivo, la audiencia y el mensaje antes de crear."
             data-en="I understand the objective, the audience, and the core message before creating.">
            Conozco el objetivo, la audiencia y el mensaje antes de crear.
          </p>
        </div>
      </div>

      <!-- PASO 2 -->
      <div class="journey-milestone">
        <div class="node-bullet">02</div>
        <div class="milestone-box">
          <h3 data-es="2. Construimos la dirección" data-en="2. Defining direction">2. Construimos la dirección</h3>
          <p data-es="Definimos estrategia, estilo visual y ruta creativa."
             data-en="We define strategy, visual tone, and the creative roadmap.">
            Definimos estrategia, estilo visual y ruta creativa.
          </p>
        </div>
      </div>

      <!-- PASO 3 -->
      <div class="journey-milestone">
        <div class="node-bullet">03</div>
        <div class="milestone-box">
          <h3 data-es="3. Creamos la experiencia" data-en="3. Creating the experience">3. Creamos la experiencia</h3>
          <p data-es="Transformo ideas en contenido, piezas digitales y soluciones visuales."
             data-en="I transform concepts into content, digital assets, and visual solutions.">
            Transformo ideas en contenido, piezas digitales y soluciones visuales.
          </p>
        </div>
      </div>

      <!-- PASO 4 -->
      <div class="journey-milestone">
        <div class="node-bullet">04</div>
        <div class="milestone-box">
          <h3 data-es="4. Evolucionamos el resultado" data-en="4. Evolving the outcome">4. Evolucionamos el resultado</h3>
          <p data-es="Analizamos, ajustamos y optimizamos para mejorar."
             data-en="We analyze, adjust, and optimize for continuous improvement.">
            Analizamos, ajustamos y optimizamos para mejorar.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .journey-section {
    position: relative;
    width: 100%;
    padding: 130px 24px;
    background: transparent;
    display: flex;
    justify-content: center;
    z-index: 5;
  }

  .journey-container {
    max-width: 860px;
    width: 100%;
  }

  .journey-header {
    margin-bottom: 60px;
  }

  .journey-header h2 {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .journey-header p {
    font-size: 1.1rem;
    color: #64748b;
  }

  /* TRACK VERTICAL */
  .vertical-path-track {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-left: 20px;
  }

  .spine-line {
    position: absolute;
    top: 25px;
    bottom: 25px;
    left: 45px;
    width: 2px;
    background: linear-gradient(180deg, #b91c1c 0%, rgba(185, 28, 28, 0.2) 100%);
    z-index: 1;
  }

  .journey-milestone {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    gap: 30px;
  }

  .node-bullet {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #0f172a;
    color: #fef08a;
    font-family: monospace;
    font-weight: 900;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 3px solid #ffffff;
    box-shadow: 0 4px 14px rgba(0,0,0,0.1);
  }

  .milestone-box {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    padding: 26px 30px;
    flex-grow: 1;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .milestone-box:hover {
    transform: translateX(6px);
    border-color: #0f172a;
  }

  .milestone-box h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 8px;
  }

  .milestone-box p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }

  @media (max-width: 600px) {
    .vertical-path-track { padding-left: 0; }
    .spine-line { left: 24px; }
    .node-bullet { width: 44px; height: 44px; font-size: 1rem; }
    .journey-milestone { gap: 16px; }
  }
</style>
