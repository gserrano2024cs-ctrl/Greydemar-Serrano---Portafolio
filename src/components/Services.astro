---
---
<section id="services" class="services-clean-section">
  <div class="services-clean-container">
    
    <div class="section-tag" data-es="Qué hago" data-en="What I do">
      Qué hago
    </div>

    <div class="section-header-clean">
      <h2 data-es="Servicios." data-en="Services.">Servicios.</h2>
      <p data-es="Soluciones especializadas para conectar marcas y audiencias a través de contenido, video y diseño funcional."
         data-en="Specialized solutions to connect brands and audiences through content, video, and functional design.">
        Soluciones especializadas para conectar marcas y audiencias a través de contenido, video y diseño funcional.
      </p>
    </div>

    <!-- 1. CARDS MINIMALISTAS DE SERVICIOS -->
    <div class="services-cards-grid">
      
      <div class="service-clean-card">
        <div class="card-icon-tag">01</div>
        <h3>Social Media</h3>
        <p class="service-desc">Estrategias integrales para construir comunidad, conectar con la audiencia correcta y generar autoridad.</p>
        <ul class="service-bullets">
          <li>Estrategia de contenido</li>
          <li>Community Management</li>
          <li>Calendario editorial</li>
          <li>Análisis de métricas</li>
        </ul>
      </div>

      <div class="service-clean-card">
        <div class="card-icon-tag">02</div>
        <h3>Video Editing</h3>
        <p class="service-desc">Edición dinámica adaptada a la velocidad de consumo actual en plataformas móviles y redes sociales.</p>
        <ul class="service-bullets">
          <li>Reels & TikToks de alto impacto</li>
          <li>Short-form content</li>
          <li>Storytelling visual</li>
          <li>Edición audiovisual dinámica</li>
        </ul>
      </div>

      <div class="service-clean-card">
        <div class="card-icon-tag">03</div>
        <h3>UX Landing Pages</h3>
        <p class="service-desc">Diseño y maquetación web enfocada en claridad, experiencia de usuario y conversión de visitantes.</p>
        <ul class="service-bullets">
          <li>Arquitectura UX</li>
          <li>Diseño 100% responsive</li>
          <li>Landing pages optimizadas</li>
          <li>Optimización visual & velocidad</li>
        </ul>
      </div>

    </div>

    <!-- 2. CÓMO TRABAJO (PROCESO EN 4 PASOS) -->
    <div class="process-sub-section">
      <div class="section-tag" data-es="Proceso" data-en="Process">
        Proceso
      </div>
      <h3 class="process-title" data-es="Cómo trabajo." data-en="How I work.">Cómo trabajo.</h3>
      
      <div class="process-steps-grid">
        
        <div class="step-card">
          <span class="step-num">01</span>
          <h4>Descubrimiento</h4>
          <p>Analizo objetivos, audiencia, necesidades y contexto del proyecto.</p>
        </div>

        <div class="step-card">
          <span class="step-num">02</span>
          <h4>Estrategia</h4>
          <p>Defino la dirección creativa, el formato del contenido y la experiencia.</p>
        </div>

        <div class="step-card">
          <span class="step-num">03</span>
          <h4>Producción</h4>
          <p>Desarrollo piezas digitales, contenido audiovisual o soluciones web.</p>
        </div>

        <div class="step-card">
          <span class="step-num">04</span>
          <h4>Optimización</h4>
          <p>Analizo resultados, mido el impacto y aplico mejoras continuas.</p>
        </div>

      </div>
    </div>

    <!-- 3. FAQ ACORDEÓN INTEGRADO -->
    <div class="faq-sub-section">
      <div class="section-tag" data-es="Dudas habituales" data-en="Common questions">
        Dudas habituales
      </div>
      <h3 class="process-title" data-es="Preguntas frecuentes." data-en="Frequently asked questions.">Preguntas frecuentes.</h3>
      
      <div class="faq-accordion-list">
        
        <div class="faq-item" onclick="toggleFaq(this)">
          <div class="faq-question">
            <span>¿Cómo comienza un proyecto?</span>
            <span class="faq-icon">+</span>
          </div>
          <div class="faq-answer">
            <p>Primero realizamos una reunión inicial para conocer objetivos, alcance y necesidades específicas. Luego te presento una propuesta formal con tiempos, entregables y condiciones claras.</p>
          </div>
        </div>

        <div class="faq-item" onclick="toggleFaq(this)">
          <div class="faq-question">
            <span>¿Cómo funcionan los pagos?</span>
            <span class="faq-icon">+</span>
          </div>
          <div class="faq-answer">
            <p>Para reservar disponibilidad en agenda e iniciar un proyecto se requiere un pago inicial del 50%. El 50% restante se abona una vez completados y aprobados los entregables acordados.</p>
          </div>
        </div>

        <div class="faq-item" onclick="toggleFaq(this)">
          <div class="faq-question">
            <span>¿Trabajas con contratos?</span>
            <span class="faq-icon">+</span>
          </div>
          <div class="faq-answer">
            <p>Sí, absolutamente. Cada proyecto incluye un acuerdo de colaboración donde se establecen por escrito el alcance, los entregables, cronogramas, rondas de revisiones y términos de pago para tranquilidad de ambas partes.</p>
          </div>
        </div>

        <div class="faq-item" onclick="toggleFaq(this)">
          <div class="faq-question">
            <span>¿Cuántas revisiones incluye?</span>
            <span class="faq-icon">+</span>
          </div>
          <div class="faq-answer">
            <p>Cada servicio incluye una cantidad definida de revisiones (habitualmente entre 2 y 3 rondas) especificada con total transparencia antes de comenzar la producción.</p>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script is:inline>
  function toggleFaq(element) {
    const wasOpen = element.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(item => {
      item.classList.remove('open');
      const ans = item.querySelector('.faq-answer');
      if (ans) ans.style.maxHeight = null;
    });

    if (!wasOpen) {
      element.classList.add('open');
      const ans = element.querySelector('.faq-answer');
      if (ans) {
        ans.style.maxHeight = ans.scrollHeight + 'px';
      }
    }
  }
</script>

<style>
  .services-clean-section {
    position: relative;
    width: 100%;
    padding: 130px 24px;
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    display: flex;
    justify-content: center;
    z-index: 5;
  }

  .services-clean-container {
    max-width: 1140px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .section-header-clean {
    margin-bottom: 50px;
  }

  .section-header-clean h2 {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 10px;
    letter-spacing: -0.02em;
  }

  .section-header-clean p {
    font-size: 1.1rem;
    color: #64748b;
    max-width: 680px;
    line-height: 1.6;
    margin: 0;
  }

  /* 1. CARDS DE SERVICIOS */
  .services-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 24px;
    width: 100%;
    margin-bottom: 90px;
  }

  .service-clean-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 32px 28px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .service-clean-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    border-color: #cbd5e1;
  }

  .card-icon-tag {
    font-family: monospace;
    font-size: 12px;
    font-weight: 800;
    color: #64748b;
    margin-bottom: 16px;
  }

  .service-clean-card h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 10px;
  }

  .service-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 22px;
  }

  .service-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid #f1f5f9;
    padding-top: 18px;
    margin-top: auto;
  }

  .service-bullets li {
    font-size: 0.88rem;
    font-weight: 600;
    color: #1e293b;
    display: flex;
    align-items: center;
  }

  .service-bullets li::before {
    content: "✓";
    color: #22c55e;
    font-weight: 800;
    margin-right: 10px;
  }

  /* 2. CÓMO TRABAJO */
  .process-sub-section {
    width: 100%;
    margin-bottom: 90px;
  }

  .process-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: #0f172a;
    margin: 8px 0 32px;
  }

  .process-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    width: 100%;
  }

  .step-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 24px;
  }

  .step-num {
    font-family: monospace;
    font-size: 1.3rem;
    font-weight: 800;
    color: #3b82f6;
    display: block;
    margin-bottom: 8px;
  }

  .step-card h4 {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 8px;
  }

  .step-card p {
    font-size: 0.92rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
  }

  /* 3. FAQ ACORDEÓN */
  .faq-sub-section {
    width: 100%;
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 860px;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .faq-item:hover {
    border-color: #cbd5e1;
  }

  .faq-item.open {
    border-color: #0f172a;
    box-shadow: 0 8px 24px rgba(0,0,0,0.04);
  }

  .faq-question {
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    font-size: 1.05rem;
    color: #0f172a;
  }

  .faq-icon {
    font-size: 1.4rem;
    font-weight: 600;
    color: #64748b;
    transition: transform 0.3s ease;
  }

  .faq-item.open .faq-icon {
    transform: rotate(45deg);
    color: #0f172a;
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-answer p {
    padding: 0 24px 22px;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #475569;
  }

  @media (max-width: 768px) {
    .services-clean-section {
      padding: 80px 20px;
    }
    .services-cards-grid {
      grid-template-columns: 1fr;
      margin-bottom: 60px;
    }
    .process-steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
