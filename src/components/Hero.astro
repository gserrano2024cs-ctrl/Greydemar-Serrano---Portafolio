---
<section class="hero-wrapper fade-in-section delay-1">
  
  <!-- 1. FONDO DE VIDEO (EL ÁVILA) Y CAPA DE CONTRASTE -->
  <div class="hero-bg-video-container">
    <video autoplay loop muted playsinline class="hero-bg-video">
      <!-- Asegúrate de subir tu video a public/avila.mp4 -->
      <source src="/avila.mp4" type="video/mp4" />
    </video>
    <div class="bg-overlay"></div>
  </div>

  <!-- 2. HEADER Y BOTONES DE IDIOMA ESTILO GLASS -->
  <header class="top-header">
    <div class="brand-centered text-white">GREY SERRANO®</div>
    <div class="lang-switch glass-pill">
      <button class="lang-btn active" onclick="setLanguage('es')">ES</button>
      <button class="lang-btn" onclick="setLanguage('en')">EN</button>
    </div>
  </header>

  <!-- 3. CONTENIDO CENTRAL: TIPOGRAFÍA GIGANTE TIPO EDITORIAL -->
  <main class="hero-container-editorial">
    
    <div class="hero-text-content">
      <h1 class="hero-title-giant">
        <span class="hi-text">hi, I'm Grey</span>
        <span class="role-line-1">Digital Content</span>
        <span class="role-line-2">& Social Media Specialist.</span>
      </h1>
      
      <!-- Subtítulo de especialidades integrado al hero text -->
      <div class="hero-specialties-row">
        <span>Social Media</span>
        <span class="dot-separator">·</span>
        <span>Community Management</span>
        <span class="dot-separator">·</span>
        <span>Video Editing</span>
        <span class="dot-separator">·</span>
        <span>Landing Pages UX</span>
      </div>
      
      <!-- Descripción enfocada a recruiters -->
      <p class="hero-description" data-es="Creo estrategias y contenidos digitales que ayudan a las marcas a captar atención, construir comunidad y convertir visitas en acciones." data-en="I create digital strategies and content that help brands capture attention, build community, and turn visits into actions.">
        Creo estrategias y contenidos digitales que ayudan a las marcas a captar atención, construir comunidad y convertir visitas en acciones.
      </p>

      <!-- Botones de acción principales -->
      <div class="hero-actions">
        <a href="#projects" class="btn-primary" data-es="Ver mis proyectos" data-en="View my projects">Ver mis proyectos</a>
        <a href="#contact" class="btn-secondary" data-es="Contactarme" data-en="Contact me">Contactarme</a>
      </div>
    </div>

  </main>

  <!-- 4. CINTA MARQUEE HORIZONTAL INFINITA (Base del Hero) -->
  <div class="hero-marquee-strip">
    <div class="hero-marquee-track">
      <span>COMMUNITY MANAGEMENT ✦ VIDEO EDITING ✦ CONTENT CREATION ✦ GROWTH MARKETING ✦ ASTRO DEVELOPMENT ✦ LANDING PAGES ✦ ANALYTICS ✦ </span>
      <span>COMMUNITY MANAGEMENT ✦ VIDEO EDITING ✦ CONTENT CREATION ✦ GROWTH MARKETING ✦ ASTRO DEVELOPMENT ✦ LANDING PAGES ✦ ANALYTICS ✦ </span>
      <span>COMMUNITY MANAGEMENT ✦ VIDEO EDITING ✦ CONTENT CREATION ✦ GROWTH MARKETING ✦ ASTRO DEVELOPMENT ✦ LANDING PAGES ✦ ANALYTICS ✦ </span>
    </div>
  </div>
</section>

<style>
  /* =========================================
     ESTILOS DEL HERO (Basado en la ref editorial)
     ========================================= */

  .hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    z-index: 10;
    display: flex;
    flex-direction: column;
  }

  /* FONDO DE VIDEO (EL ÁVILA) */
  .hero-bg-video-container {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 0;
    overflow: hidden;
  }
  
  .hero-bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Asegura que el video llene toda la pantalla 1920x1080 */
    object-position: center;
  }
  
  /* OVERLAY PARA CONTRASTE (Ajusta la opacidad según necesites para que el texto resalte) */
  .bg-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to bottom, rgba(15, 23, 42, 0.5) 0%, rgba(15, 23, 42, 0.9) 100%);
    z-index: 1;
  }

  /* HEADER TOP */
  .top-header {
    position: relative;
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
    padding: 30px 40px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    z-index: 20;
  }
  
  .brand-centered {
    position: absolute;
    top: 38px; left: 50%;
    transform: translateX(-50%);
    font-weight: 900;
    font-size: 20px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .text-white {
    color: #ffffff !important;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  /* BOTÓN DE IDIOMA GLASS */
  .glass-pill {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 8px;
    border-radius: 40px;
    display: flex;
    gap: 4px;
  }

  .glass-pill .lang-btn {
    color: #ffffff;
    opacity: 0.6;
    padding: 8px 18px;
    border-radius: 30px;
    font-weight: 700;
    font-size: 13px;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .glass-pill .lang-btn.active {
    background: rgba(255, 255, 255, 0.2);
    opacity: 1;
    font-weight: 900;
  }

  /* =========================================
     CONTENIDO CENTRAL EDITORIAL (Aprovecha 1920x1080)
     ========================================= */
  .hero-container-editorial {
    position: relative;
    width: 100%;
    max-width: 1600px; /* Más ancho para usar la pantalla completa */
    margin: auto auto;
    padding: 40px 40px 140px; /* Padding bottom extra para el marquee */
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10;
    flex-grow: 1;
  }

  .hero-text-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  /* LA TIPOGRAFÍA GIGANTE */
  .hero-title-giant {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #ffffff;
    line-height: 0.9;
    text-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .hi-text {
    font-family: 'Times New Roman', Times, serif; /* O usa la fuente serif que prefieras para el itálico */
    font-size: clamp(3rem, 6vw, 6rem);
    font-style: italic;
    font-weight: 400;
    margin-bottom: -15px;
    z-index: 2;
  }

  .role-line-1, .role-line-2 {
    font-size: clamp(4rem, 8vw, 9rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .role-line-1 {
    color: #ffffff;
  }
  
  .role-line-2 {
    color: #ffffff;
    /* Puedes darle un toque de tu color amarillo o dejarlo blanco, según prefieras. Aquí lo dejo blanco por la referencia */
  }

  /* SUBTÍTULOS Y DESCRIPCIÓN */
  .hero-specialties-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    color: var(--pastel-yellow, #fef08a);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 10px;
  }

  .dot-separator {
    opacity: 0.5;
  }

  .hero-description {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.4rem;
    line-height: 1.6;
    max-width: 800px;
    font-weight: 500;
    margin-top: 10px;
  }

  /* BOTONES GRANDES */
  .hero-actions {
    display: flex;
    gap: 20px;
    margin-top: 20px;
  }

  .btn-primary, .btn-secondary {
    padding: 16px 36px;
    border-radius: 40px;
    font-size: 1.1rem;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: #ffffff;
    color: #0f172a;
  }
  
  .btn-primary:hover {
    background: var(--pastel-yellow, #fef08a);
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #ffffff;
    transform: translateY(-4px);
  }

  /* =========================================
     CINTA MARQUEE HORIZONTAL INFINITA
     ========================================= */
  .hero-marquee-strip {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--pastel-yellow, #fef08a);
    padding: 20px 0; /* Cinta más alta */
    z-index: 20;
    overflow: hidden;
    display: flex;
  }

  .hero-marquee-track {
    display: flex;
    white-space: nowrap;
    width: max-content;
    gap: 40px;
    padding-right: 40px;
    font-weight: 900;
    font-size: 1.3rem; /* Letra más grande */
    letter-spacing: 2px;
    animation: scroll-hero-marquee 30s linear infinite;
  }

  @keyframes scroll-hero-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .hi-text { font-size: 2.5rem; }
    .role-line-1, .role-line-2 { font-size: 3rem; }
    .hero-specialties-row { font-size: 0.9rem; }
    .hero-description { font-size: 1.1rem; }
    .hero-actions { flex-direction: column; width: 100%; max-width: 300px; }
    .btn-primary, .btn-secondary { width: 100%; text-align: center; }
  }
</style>
