---
---
<section class="hero-wrapper">
  
  <!-- 1. FONDO DE VIDEO (EL ÁVILA) Y CAPA DE CONTRASTE -->
  <div class="hero-bg-video-container">
    <video autoplay loop muted playsinline preload="auto" class="hero-bg-video">
      <source src="/avila.mp4" type="video/mp4" />
    </video>
    <div class="bg-overlay"></div>
  </div>

  <!-- 2. NAVBAR REFINADA / IDENTIDAD COMO FIRMA -->
  <header class="top-navbar">
    <div class="brand-signature">
      <span>GREY SERRANO ®</span>
    </div>
    
    <div class="lang-switch-minimal">
      <button class="lang-btn active" onclick="setLanguage('es')">ES</button>
      <span class="lang-divider">/</span>
      <button class="lang-btn" onclick="setLanguage('en')">EN</button>
    </div>
  </header>

  <!-- 3. CONTENIDO HERO: NARRATIVA DIRECTA -->
  <div class="hero-center-content">
    
    <div class="hero-lead-group">
      <h1 class="hero-main-title">
        <span class="greeting-text" data-es="Hola, soy" data-en="Hi, I'm">Hola, soy</span>
        <span class="highlight-name">Grey</span>
      </h1>
      
      <h2 class="hero-role-title">
        Digital Content &<br />Social Media Specialist
      </h2>
      
      <div class="hero-subspecialties">
        <span>Social Media</span>
        <span class="dot">·</span>
        <span>Community Management</span>
        <span class="dot">·</span>
        <span>Video Editing</span>
        <span class="dot">·</span>
        <span>Landing Pages UX</span>
      </div>

      <p class="hero-description"
         data-es="Creo estrategias y contenidos digitales que ayudan a las marcas a conectar con sus audiencias, crear comunidad y transformar ideas en experiencias digitales."
         data-en="I create digital strategies and content that help brands connect with audiences, build communities and transform ideas into digital experiences.">
        Creo estrategias y contenidos digitales que ayudan a las marcas a conectar con sus audiencias, crear comunidad y transformar ideas en experiencias digitales.
      </p>
    </div>

    <!-- 4. INDICADOR DE SCROLL MINIMALISTA (Reemplazo de botones invasivos) -->
    <a href="#about" class="scroll-indicator" aria-label="Scroll down to explore">
      <span class="scroll-text" data-es="Scroll para explorar" data-en="Scroll to explore">Scroll para explorar</span>
      <svg class="scroll-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <polyline points="19 12 12 19 5 12"></polyline>
      </svg>
    </a>

  </div>

</section>

<style>
  .hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    z-index: 10;
  }

  .hero-bg-video-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }

  .hero-bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.6) 0%, rgba(15, 23, 42, 0.88) 100%);
    z-index: 1;
  }

  /* 1. NAVBAR / FIRMA PERSONAL */
  .top-navbar {
    position: relative;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 34px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 20;
  }

  .brand-signature {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: #ffffff;
    text-transform: uppercase;
    opacity: 0.92;
    transition: opacity 0.3s ease;
  }

  .brand-signature:hover {
    opacity: 1;
  }

  /* 2. SELECTOR DE IDIOMA MINIMALISTA */
  .lang-switch-minimal {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 5px 12px;
    border-radius: 20px;
  }

  .lang-btn {
    background: none;
    border: none;
    color: #ffffff;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    opacity: 0.55;
    padding: 2px 4px;
    transition: all 0.25s ease;
    font-family: inherit;
  }

  .lang-btn:hover {
    opacity: 0.9;
  }

  .lang-btn.active {
    opacity: 1;
    font-weight: 700;
    color: #fef08a;
  }

  .lang-divider {
    color: rgba(255, 255, 255, 0.3);
    font-size: 12px;
  }

  /* 3. HERO CONTENT */
  .hero-center-content {
    position: relative;
    z-index: 10;
    max-width: 960px;
    margin: auto auto;
    padding: 20px 24px 70px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-lead-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .hero-main-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    line-height: 1.1;
  }

  .greeting-text {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    margin-right: 8px;
    opacity: 0.95;
  }

  .highlight-name {
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
    color: #fef08a;
    letter-spacing: -0.02em;
    position: relative;
    cursor: default;
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }

  .highlight-name:hover {
    color: #ffffff;
    text-shadow: 0 0 20px rgba(254, 240, 138, 0.7);
  }

  .hero-role-title {
    font-size: clamp(1.8rem, 3.8vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #ffffff;
    line-height: 1.15;
    text-transform: uppercase;
    margin: 0;
  }

  .hero-subspecialties {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
    margin-top: 4px;
  }

  .dot {
    color: #fef08a;
    opacity: 0.7;
  }

  .hero-description {
    font-size: 1.12rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.8);
    max-width: 720px;
    margin-top: 10px;
    font-weight: 400;
  }

  /* 4. SCROLL INDICATOR */
  .scroll-indicator {
    margin-top: 45px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
    transition: all 0.3s ease;
  }

  .scroll-text {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .scroll-arrow {
    animation: gentle-bounce 2.2s infinite ease-in-out;
  }

  .scroll-indicator:hover {
    color: #fef08a;
  }

  @keyframes gentle-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @media (max-width: 768px) {
    .top-navbar {
      padding: 24px 20px;
    }
    .brand-signature {
      font-size: 11px;
    }
    .hero-center-content {
      padding: 10px 20px 50px;
    }
    .hero-subspecialties {
      font-size: 0.78rem;
      gap: 6px;
    }
    .hero-description {
      font-size: 0.98rem;
    }
  }
</style>
