---
---
<section class="hero-clean-container">
  
  <!-- 1. VIDEO DE FONDO Y OVERLAY EDITORIAL -->
  <div class="video-canvas">
    <video autoplay loop muted playsinline preload="auto" class="video-bg">
      <source src="/avila.mp4" type="video/mp4" />
    </video>
    <div class="video-contrast-layer"></div>
  </div>

  <!-- 2. NAVBAR MINIMALISTA -->
  <header class="top-signature-bar">
    <div class="brand-logotype">
      <span class="brand-full">GREYDEMAR SERRANO</span>
      <span class="brand-badge-dot">•</span>
      <span class="brand-creative">GREY ®</span>
    </div>

    <!-- SELECTOR DE IDIOMA MINIMALISTA (ES POR DEFECTO) -->
    <div class="lang-switch-editorial">
      <button class="lang-btn active" onclick="setLanguage('es')">ES</button>
      <span class="lang-sep">/</span>
      <button class="lang-btn" onclick="setLanguage('en')">EN</button>
    </div>
  </header>

  <!-- 3. CONTENIDO HERO NARRATIVO Y ROTATIVO -->
  <div class="hero-center-stage">
    
    <div class="hero-titles-group">
      <!-- TÍTULO EXACTO SOLICITADO -->
      <h1 class="hero-title-main">
        <span class="title-salute" data-es="Hola, soy" data-en="Hi, I'm">Hola, soy</span>
        <span class="title-name">Grey</span>
        <span class="red-asterisk" title="Creative Identity">*</span>
      </h1>
      
      <h2 class="hero-profession" data-es="Digital Content & Social Media Specialist." data-en="Digital Content & Social Media Specialist.">
        Digital Content & Social Media Specialist.
      </h2>
    </div>

    <!-- ANIMACIÓN DINÁMICA DE SERVICIOS -->
    <div class="dynamic-specialty-container">
      <span class="specialty-label" data-es="Especializada en:" data-en="Specialized in:">Especializada en:</span>
      <div class="dynamic-scroller">
        <span class="dynamic-service-item active">Video Editing.</span>
        <span class="dynamic-service-item">Landing Pages.</span>
        <span class="dynamic-service-item">Community Management.</span>
        <span class="dynamic-service-item">Digital Content Strategy.</span>
        <span class="dynamic-service-item">Creative Solutions.</span>
      </div>
    </div>

    <!-- DESCRIPCIÓN CON VALOR -->
    <p class="hero-pitch"
       data-es="Transformo ideas complejas en narrativas audiovisuales, comunidades comprometidas y experiencias web orientadas a resultados medibles."
       data-en="I transform ideas into audiovisual narratives, engaged communities, and web experiences oriented towards measurable results.">
      Transformo ideas complejas en narrativas audiovisuales, comunidades comprometidas y experiencias web orientadas a resultados medibles.
    </p>

    <!-- INDICADOR DE SCROLL EDITORIAL -->
    <a href="#about" class="hero-scroll-cue" aria-label="Descubrir trayectoria">
      <span class="cue-label" data-es="Explorar trayectoria" data-en="Explore journey">Explorar trayectoria</span>
      <div class="cue-arrow-line"></div>
    </a>

  </div>

</section>

<script is:inline>
  // Rotación continua de servicios dinámicos
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.dynamic-service-item');
    if (!items.length) return;
    let currentIndex = 0;

    setInterval(() => {
      items[currentIndex].classList.remove('active');
      currentIndex = (currentIndex + 1) % items.length;
      items[currentIndex].classList.add('active');
    }, 2400);
  });
</script>

<style>
  .hero-clean-container {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    z-index: 10;
  }

  .video-canvas {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 0;
  }

  .video-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .video-contrast-layer {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(180deg, rgba(10, 15, 29, 0.6) 0%, rgba(10, 15, 29, 0.92) 100%);
  }

  /* BARRA SUPERIOR */
  .top-signature-bar {
    position: relative;
    z-index: 20;
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 34px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-logotype {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brand-badge-dot {
    color: #b91c1c; /* Acento rojo profundo */
    font-size: 12px;
  }

  .brand-creative {
    font-weight: 800;
    color: #fef08a;
    letter-spacing: 0.22em;
  }

  /* SELECTOR DE IDIOMA */
  .lang-switch-editorial {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 6px 14px;
    border-radius: 24px;
  }

  .lang-btn {
    background: none;
    border: none;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    opacity: 0.5;
    padding: 2px 4px;
    transition: all 0.25s ease;
  }

  .lang-btn.active {
    opacity: 1;
    color: #fef08a;
    font-weight: 800;
  }

  .lang-sep {
    color: rgba(255, 255, 255, 0.25);
    font-size: 11px;
  }

  /* ESCENARIO HERO */
  .hero-center-stage {
    position: relative;
    z-index: 10;
    max-width: 1000px;
    margin: auto auto;
    padding: 20px 24px 70px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-titles-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .hero-title-main {
    font-size: clamp(2.8rem, 6.5vw, 5.2rem);
    color: #ffffff;
    line-height: 1.05;
    margin: 0;
    letter-spacing: -0.03em;
  }

  .title-salute {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    opacity: 0.95;
    margin-right: 8px;
  }

  .title-name {
    font-family: 'Montserrat', sans-serif;
    font-weight: 900;
    color: #ffffff;
  }

  /* DETALLE GRÁFICO: ASTERISCO ROJO PROFUNDO */
  .red-asterisk {
    color: #b91c1c; /* Crimson / Rojo profundo */
    font-family: 'Playfair Display', serif;
    font-size: 1.1em;
    vertical-align: super;
    margin-left: 2px;
    display: inline-block;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .hero-title-main:hover .red-asterisk {
    transform: rotate(45deg) scale(1.15);
    color: #ef4444;
  }

  .hero-profession {
    font-size: clamp(1.4rem, 2.8vw, 2.4rem);
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 0;
  }

  /* ANIMACIÓN DINÁMICA DE SERVICIOS */
  .dynamic-specialty-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .specialty-label {
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
  }

  .dynamic-scroller {
    position: relative;
    height: 1.6em;
    display: inline-flex;
    align-items: center;
  }

  .dynamic-service-item {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    color: #fef08a; /* Acento marfil/dorado */
    font-weight: 800;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .dynamic-service-item.active {
    position: relative;
    opacity: 1;
    transform: translateY(0);
  }

  .hero-pitch {
    font-size: 1.12rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
    max-width: 660px;
    margin-top: 18px;
    font-weight: 400;
  }

  /* INDICADOR SCROLL */
  .hero-scroll-cue {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.3s ease;
  }

  .cue-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-weight: 700;
  }

  .cue-arrow-line {
    width: 1px;
    height: 38px;
    background: linear-gradient(180deg, #b91c1c 0%, transparent 100%);
    animation: pulseLine 2s infinite ease-in-out;
  }

  .hero-scroll-cue:hover {
    color: #ffffff;
  }

  @keyframes pulseLine {
    0%, 100% { transform: scaleY(0.6); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  @media (max-width: 768px) {
    .top-signature-bar { padding: 20px; }
    .hero-title-main { font-size: 2.6rem; }
    .hero-profession { font-size: 1.3rem; }
    .dynamic-specialty-container { flex-direction: column; gap: 4px; }
    .hero-pitch { font-size: 0.98rem; }
  }
</style>
