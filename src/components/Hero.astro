---
---
<section class="hero-wrapper fade-in-section delay-1">
  
  <!-- 1. FONDO DEL ÁVILA Y CAPA DE CONTRASTE -->
  <div class="hero-bg-image"></div>
  <div class="bg-overlay"></div>

  <!-- 2. HEADER Y BOTONES DE IDIOMA ESTILO GLASS -->
  <header class="top-header">
    <div class="brand-centered text-white">GREY SERRANO®</div>
    <div class="lang-switch glass-pill">
      <button class="lang-btn active" onclick="setLanguage('es')">ES</button>
      <button class="lang-btn" onclick="setLanguage('en')">EN</button>
    </div>
  </header>

  <!-- CONTENIDO CENTRAL -->
  <main class="hero-container">
    <div class="left-col">
      <div class="glass-profile-card" onclick="this.classList.toggle('active')">
        <div class="card-min-header">
          <img src="/grey.jpeg" alt="Greydemar Serrano" class="profile-thumb shift-right" id="heroProfileImg" onclick="toggleProfileZoom(event)" title="Ver a detalle" />
          <div class="min-meta">
            <div class="status-line"><span class="green-dot"></span><span class="status-text" data-es="En línea" data-en="Online">En línea</span></div>
            <div class="name-group">
              <h2 class="min-name">GREYDEMAR SERRANO</h2>
              <span class="min-title" data-es="Growth Marketer & Front-End Developer" data-en="Growth Marketer & Front-End Developer">Growth Marketer & Front-End Developer</span>
            </div>
          </div>
        </div>
        <div class="card-expand-content">
          <p class="expand-bio" 
             data-es="<strong>Atraigo, retengo y convierto.</strong> Creo comunidades digitales a través de contenido visual magnético y estrategias orgánicas que transforman simples seguidores en oportunidades de venta reales.<br><br>Además, maqueto experiencias web ultrarrápidas utilizando Astro. Mi enfoque es eliminar la fricción técnica para que el código y el diseño multipliquen tus conversiones." 
             data-en="<strong>I attract, retain, and convert.</strong> I build digital communities through magnetic visual content and organic strategies that transform simple followers into real sales opportunities.<br><br>Additionally, I build ultra-fast web experiences using Astro. My focus is to eliminate technical friction so that code and design multiply your conversions.">
             <strong>Atraigo, retengo y convierto.</strong> Creo comunidades digitales a través de contenido visual magnético y estrategias orgánicas que transforman simples seguidores en oportunidades de venta reales.<br><br>
             Además, maqueto experiencias web ultrarrápidas utilizando Astro. Mi enfoque es eliminar la fricción técnica para que el código y el diseño multipliquen tus conversiones.
          </p>
          <p class="skills-title" data-es="Sistemas Centrales:" data-en="Core Systems:">Sistemas Centrales:</p>
          <div class="skills-grid">
            <span class="wide-skill">Content Systems</span>
            <span class="wide-skill">Communities</span>
            <span class="wide-skill">Conversion Websites</span>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-center-text">
      <h1 data-es="CREO CONTENIDO DIGITAL QUE CONECTA,<br>CONVIERTE Y CRECE" data-en="I CREATE DIGITAL CONTENT THAT CONNECTS,<br>CONVERTS AND GROWS">CREO CONTENIDO DIGITAL QUE CONECTA,<br>CONVIERTE Y CRECE</h1>
      <span class="floating-pill pill-pink">Social Media</span>
      <span class="floating-pill pill-green">Content Creator</span>
      <span class="floating-pill pill-yellow" data-es="Front-End Web" data-en="Front-End Web">Front-End Web</span>
    </div>

    <div class="glass-cases-card" onclick="this.classList.toggle('active')">
      <div class="cases-min-header">
        <span class="cases-title-text" data-es="Casos Destacados" data-en="Featured Cases">Casos Destacados</span>
        <span class="search-icon-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></span>
      </div>
      <div class="cases-expand-content">
        <ul class="quick-cases-list">
          <li><a href="#projects" onclick="setTimeout(() => openModal('modal-yprealty'), 400);"><strong>YP Realty</strong><span data-es="Social Media" data-en="Social Media">Social Media</span></a></li>
          <li><a href="#projects" onclick="setTimeout(() => openModal('modal-panhouse'), 400);"><strong>Editorial PanHouse</strong><span data-es="Social Media" data-en="Social Media">Social Media</span></a></li>
          <li><a href="#projects" onclick="setTimeout(() => openModal('modal-freelance'), 400);"><strong>Freelance Web</strong><span data-es="Web" data-en="Web">Web</span></a></li>
          <li><a href="#projects" onclick="setTimeout(() => openModal('modal-impaktemos'), 400);"><strong>Landing Pages</strong><span data-es="Web" data-en="Web">Web</span></a></li>
          <li><a href="#projects" onclick="setTimeout(() => openModal('modal-eurobuilding'), 400);"><strong>Eurobuilding</strong><span data-es="Strategy / Operations" data-en="Strategy / Operations">Strategy / Operations</span></a></li>
          <li><a href="#projects" onclick="setTimeout(() => openModal('modal-dislocal'), 400);"><strong>Dislocal</strong><span data-es="Strategy / Operations" data-en="Strategy / Operations">Strategy / Operations</span></a></li>
        </ul>
      </div>
    </div>
  </main>

  <!-- 3. CINTA MARQUEE HORIZONTAL INFINITA (Base del Hero) -->
  <div class="hero-marquee-strip">
    <div class="hero-marquee-track">
      <span>COMMUNITY MANAGEMENT ✦ VIDEO EDITING ✦ CONTENT CREATION ✦ GROWTH MARKETING ✦ ASTRO DEVELOPMENT ✦ LANDING PAGES ✦ ANALYTICS ✦ </span>
      <span>COMMUNITY MANAGEMENT ✦ VIDEO EDITING ✦ CONTENT CREATION ✦ GROWTH MARKETING ✦ ASTRO DEVELOPMENT ✦ LANDING PAGES ✦ ANALYTICS ✦ </span>
      <span>COMMUNITY MANAGEMENT ✦ VIDEO EDITING ✦ CONTENT CREATION ✦ GROWTH MARKETING ✦ ASTRO DEVELOPMENT ✦ LANDING PAGES ✦ ANALYTICS ✦ </span>
    </div>
  </div>
</section>

<style>
  /* FONDO ÁVILA */
  .hero-bg-image {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: url('/avila.jpg'); /* ASEGÚRATE DE SUBIR ESTA IMAGEN */
    background-size: cover;
    background-position: center center;
    z-index: 0;
  }
  
  /* OVERLAY PARA DAR LECTURABILIDAD A LAS CARTAS Y AL H1 */
  .bg-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to bottom, rgba(15, 23, 42, 0.4) 0%, rgba(15, 23, 42, 0.85) 100%);
    z-index: 1;
  }

  .text-white {
    color: #ffffff !important;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  /* BOTÓN DE IDIOMA TIPO GLASSMORPHISM */
  .glass-pill {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px;
    border-radius: 40px;
    display: flex;
    gap: 4px;
  }

  .glass-pill .lang-btn {
    color: #ffffff;
    opacity: 0.6;
    padding: 6px 14px;
    border-radius: 30px;
  }

  .glass-pill .lang-btn.active {
    background: rgba(255, 255, 255, 0.2);
    opacity: 1;
    font-weight: 900;
  }

  /* NUEVA CINTA MARQUEE HORIZONTAL */
  .hero-marquee-strip {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: #fef08a; /* Color pastel yellow que usas en la web */
    padding: 14px 0;
    z-index: 20;
    overflow: hidden;
    display: flex;
  }

  .hero-marquee-track {
    display: flex;
    white-space: nowrap;
    width: max-content;
    gap: 40px;
    padding-right: 40px;
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: 2px;
    animation: scroll-hero-marquee 30s linear infinite;
  }

  @keyframes scroll-hero-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }

  /* Aseguramos que el H1 sea blanco para contrastar con el Ávila */
  .hero-center-text h1 {
    color: #ffffff !important;
    text-shadow: 0 4px 20px rgba(0,0,0,0.6);
    mix-blend-mode: normal !important; /* Quitamos el difference que se usaba con la mancha negra */
  }
</style>
