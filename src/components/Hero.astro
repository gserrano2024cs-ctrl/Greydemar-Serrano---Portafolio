---
import HeroTitle from "./HeroTitle.tsx";
---

<section class="hero" id="top">

  <nav class="nav">

    <a href="/" class="logo">
      Greydemar®
    </a>


    <div class="nav-links">

      <a href="#projects">
        Work
      </a>

      <a href="#about">
        About
      </a>

      <a href="#contact">
        Contact
      </a>

    </div>


    <div class="nav-actions">

      <a 
        href="https://github.com/gserrano2024cs-ctrl"
        target="_blank">
        GitHub
      </a>


      <a 
        href="https://api.whatsapp.com/send/?phone=584126339776&text&type=phone_number&app_absent=0"
        target="_blank">
        WhatsApp
      </a>

    </div>


  </nav>




  <div class="hero-content">


    <div class="hero-copy">


      <p class="eyebrow">
        FRONTEND DEVELOPER
      </p>


      <HeroTitle client:load />



      <p class="description">

        Construyo experiencias digitales combinando
        desarrollo frontend, storytelling visual
        y estrategia de crecimiento.

      </p>



      <div class="tags">

        <span>
          Astro
        </span>

        <span>
          Next.js
        </span>

        <span>
          Video
        </span>

        <span>
          Growth
        </span>

      </div>



      <div class="buttons">


        <a 
          class="primary"
          href="#projects">

          View projects

        </a>



        <a
          class="secondary"
          href="#contact">

          Open to opportunities

        </a>


      </div>


    </div>






    <figure class="video-card">


      <video
        src="/ph.mp4"
        autoplay
        muted
        loop
        playsinline>
      </video>



      <figcaption>

        <strong>
          PanHouse
        </strong>

        <span>
          Video Storytelling
        </span>

      </figcaption>


    </figure>



  </div>





  <div class="wordmark">

    GREY

  </div>


</section>




<style>

.hero {

min-height:100vh;
background:#fafafa;
border-radius:40px;
overflow:hidden;
position:relative;
padding:32px;

}



.nav {

display:flex;
justify-content:space-between;
align-items:center;

position:relative;
z-index:5;

}



.logo {

font-weight:700;
font-size:1.1rem;
color:#000;
text-decoration:none;

}



.nav-links,
.nav-actions {

display:flex;
gap:20px;

}



.nav a {

text-decoration:none;
color:#111;

}



.nav-actions a {

padding:10px 16px;
border-radius:999px;
background:
rgba(255,255,255,.5);

border:1px solid rgba(0,0,0,.08);

backdrop-filter:blur(20px);

font-size:.85rem;

}




.hero-content {

min-height:80vh;

display:flex;

align-items:center;

justify-content:center;

gap:80px;

position:relative;

z-index:2;

}



.hero-copy {

max-width:700px;

text-align:center;

}



.eyebrow {

font-size:.75rem;
letter-spacing:.15em;
font-weight:600;

}



.description {

font-size:1.15rem;
line-height:1.6;
color:#666;

margin:30px auto;

max-width:550px;

}



.tags {

display:flex;
justify-content:center;
gap:10px;

}



.tags span {

padding:8px 16px;

border-radius:999px;

background:white;

border:1px solid #ddd;

font-size:.85rem;

}




.buttons {

display:flex;
justify-content:center;
gap:14px;

margin-top:30px;

}



.buttons a {

padding:15px 25px;

border-radius:999px;

text-decoration:none;

}



.primary {

background:#000;

color:white;

}



.secondary {

border:1px solid #ddd;

background:white;

color:#000;

}




.video-card {

width:280px;

padding:12px;

border-radius:30px;

background:
rgba(255,255,255,.45);

backdrop-filter:
blur(25px);

border:
1px solid rgba(0,0,0,.1);


animation:
float 6s ease-in-out infinite;

}



.video-card video {

width:100%;

border-radius:22px;

}



.video-card figcaption {

padding:14px;

display:flex;

flex-direction:column;

}



.wordmark {

position:absolute;

bottom:-100px;

left:50%;

transform:translateX(-50%);

font-size:25vw;

font-weight:900;

letter-spacing:-.08em;

color:#000;

opacity:.95;

z-index:1;

}



@keyframes float {

50% {

transform:translateY(-15px);

}

}



@media(max-width:900px){

.hero-content{

flex-direction:column;

gap:40px;

}



.nav-links{

display:none;

}


.wordmark{

font-size:40vw;

}

}


</style>
