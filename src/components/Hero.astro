---
---
<section class="hero-wrapper fade-in-section delay-1">
  
  <!-- 1. FONDO DE VIDEO (EL ÁVILA) Y OVERLAY -->
  <div class="hero-bg-video-container">
    <video autoplay loop muted playsinline class="hero-bg-video">
      <source src="/avila.mp4" type="video/mp4" />
    </video>
    <div class="bg-overlay"></div>
  </div>

  <!-- 2. HEADER Y SELECTOR DE IDIOMA -->
  <header class="top-header">
    <div class="brand-centered text-white">GREYDEMAR SERRANO®</div>
    <div class="lang-switch glass-pill">
      <button class="lang-btn active" onclick="setLanguage('es')">ES</button>
      <button class="lang-btn" onclick="setLanguage('en')">EN</button>
    </div>
  </header>

  <!-- 3. CONTENIDO CENTRAL HERO -->
  <main class="hero-container-editorial">
    <div class="hero-text-content">
      
      <div class="hero-badge" data-es="👋 Hola, soy Greydemar Serrano" data-en="👋 Hi, I'm Greydemar Serrano">
        👋 Hola, soy Greydemar Serrano
      </div>

      <h1 class="hero-title-calibrated">
        <span class="role-line-1">Digital Content &</span>
        <span class="role-line-2">Social Media Specialist</span>
      </h1>
      
      <!-- Subtítulo de especialidades -->
      <div class="hero-specialties-row">
        <span>Social Media</span>
        <span class="dot-separator">·</span>
        <span>Community Management</span>
        <span class="dot-separator">·</span>
        <span>Video Editing</span>
        <span class="dot-separator">·</span>
        <span>Landing Pages UX</span>
      </div>
      
      <!-- Descripción orientada a valor -->
      <p class="hero-description" 
         data-es="Soy comunicadora social con más de 5 años de experiencia creando contenido, coordinando proyectos digitales y desarrollando experiencias web. Combino estrategia, creatividad y análisis para transformar ideas en contenido que atrae, comunica y genera acciones." 
         data-en="I am a communications specialist with 5+ years of experience creating digital content, coordinating projects, and building web experiences. I combine strategy, creativity, and data to turn ideas into engaging content that drives real action.">
        Soy comunicadora social con más de 5 años de experiencia creando contenido, coordinando proyectos digitales y desarrollando experiencias web. Combino estrategia, creatividad y análisis para transformar ideas en contenido que atrae, comunica y genera acciones.
      </p>

      <!-- Botones de Acción -->
      <div class="hero-actions">
        <a href="#projects" class="btn-primary" data-es="Ver proyectos destacados" data-en="View featured projects">Ver proyectos destacados</a>
        <a href="#contact" class="btn-secondary" data-es="Contactarme" data-en="Contact me">Contactarme</a>
      </div>

    </div>
  </main>

  <!-- 4. CINTA HORIZONTAL INFINITA PREDETERMINADA -->
  <div class="hero-marquee-strip">
    <div class="hero-marquee-track">
      <span>SOCIAL MEDIA STRATEGY ✦ COMMUNITY MANAGEMENT ✦ SHORT-FORM VIDEO ✦ LANDING PAGES UX ✦ MARKETING ANALYTICS ✦ PROJECT COORDINATION ✦ </span>
      <span>SOCIAL MEDIA STRATEGY ✦ COMMUNITY MANAGEMENT ✦ SHORT-FORM VIDEO ✦ LANDING PAGES UX ✦ MARKETING ANALYTICS ✦ PROJECT COORDINATION ✦ </span>
      <span>SOCIAL MEDIA STRATEGY ✦ COMMUNITY MANAGEMENT ✦ SHORT-FORM VIDEO ✦ LANDING PAGES UX ✦ MARKETING ANALYTICS ✦ PROJECT COORDINATION ✦ </span>
    </div>
  </div>
</section>

<style>
  .hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-bg-video-container {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 0;
    overflow: hidden;
  }
  
  .hero-bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  
  .bg-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.65) 0%, rgba(15, 23, 42, 0.92) 100%);
    z-index: 1;
  }

  .top-header {
    position: relative;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px 32px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    z-index: 20;
  }
  
  .brand-centered {
    position: absolute;
    top: 26px; left: 50%;
    transform: translateX(-50%);
    font-weight: 900;
    font-size: 16px;
    letter-spacing: 0.15em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .text-white {
    color: #ffffff !important;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  .glass-pill {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 4px;
    border-radius: 40px;
    display: flex;
    gap: 4px;
  }

  .glass-pill .lang-btn {
    color: #ffffff;
    opacity: 0.65;
    padding: 6px 14px;
    border-radius: 30px;
    font-weight: 700;
    font-size: 12px;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .glass-pill .lang-btn.active {
    background: rgba(255, 255, 255, 0.25);
    opacity: 1;
    font-weight: 900;
  }

  .hero-container-editorial {
    position: relative;
    width: 100%;
    max-width: 1100px;
    margin: auto auto;
    padding: 30px 24px 100px;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10;
  }

  .hero-text-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .hero-badge {
    background: rgba(254, 240, 138, 0.15);
    border: 1px solid rgba(254, 240, 138, 0.4);
    color: #fef08a;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 30px;
    letter-spacing: 0.02em;
    backdrop-filter: blur(8px);
  }

  /* TÍTULO HERO CALIBRADO (NO GIGANTE DESMEDIDO) */
  .hero-title-calibrated {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #ffffff;
    line-height: 1.05;
    margin: 4px 0;
    text-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }

  .role-line-1, .role-line-2 {
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .role-line-1 {
    color: #ffffff;
  }
  
  .role-line-2 {
    color: #fef08a; /* Acento suave */
  }

  .hero-specialties-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .dot-separator {
    color: #fef08a;
    opacity: 0.8;
  }

  .hero-description {
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.15rem;
    line-height: 1.65;
    max-width: 780px;
    font-weight: 500;
    margin-top: 4px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    margin-top: 14px;
  }

  .btn-primary, .btn-secondary {
    padding: 14px 30px;
    border-radius: 40px;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-primary {
    background: #ffffff;
    color: #0f172a;
  }
  
  .btn-primary:hover {
    background: #fef08a;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.25);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: #ffffff;
    transform: translateY(-3px);
  }

  /* CINTA INFINITA CON TAMAÑO PREDETERMINADO ELEGANTE */
  .hero-marquee-strip {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: #fef08a;
    padding: 12px 0; /* Altura estilizada estándar */
    z-index: 20;
    overflow: hidden;
    display: flex;
  }

  .hero-marquee-track {
    display: flex;
    white-space: nowrap;
    width: max-content;
    gap: 32px;
    padding-right: 32px;
    font-weight: 800;
    font-size: 0.88rem; /* Tamaño proporcional para cinta */
    letter-spacing: 1.5px;
    animation: scroll-hero-marquee 35s linear infinite;
  }

  @keyframes scroll-hero-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }

  @media (max-width: 768px) {
    .brand-centered { font-size: 13px; top: 22px; }
    .hero-title-calibrated { font-size: 2.2rem; }
    .hero-specialties-row { font-size: 0.82rem; }
    .hero-description { font-size: 1rem; }
    .hero-actions { flex-direction: column; width: 100%; max-width: 280px; }
    .btn-primary, .btn-secondary { width: 100%; }
    .hero-marquee-strip { padding: 10px 0; }
    .hero-marquee-track { font-size: 0.8rem; }
  }
</style>
