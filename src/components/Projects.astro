---
---
<section id="projects" class="studies-section">
  <div class="studies-container">
    
    <div class="section-kicker" data-es="Evidencia Real" data-en="Proven Impact">
      Evidencia Real
    </div>

    <div class="studies-headline">
      <h2 data-es="Proyectos que generan impacto." data-en="Projects that drive impact.">
        Proyectos que generan impacto.
      </h2>
      <p data-es="Estrategia digital, contenido audiovisual y desarrollo web con resultados medibles."
         data-en="Digital strategy, audiovisual content, and web development with measurable results.">
        Estrategia digital, contenido audiovisual y desarrollo web con resultados medibles.
      </p>
    </div>

    <!-- CASOS PRINCIPALES -->
    <div class="studies-grid-main">
      
      <!-- 1. YARILIZ PIZARRO (YP REALTY) -->
      <div class="study-card" onclick="openModal('modal-yprealty')">
        <div class="study-cover-holder">
          <img src="/portada-yprealty.png" alt="Yariliz Pizarro YP Realty" style="object-position: top center;" />
          <span class="study-badge">Social Media & Video</span>
        </div>
        <div class="study-body-content">
          <span class="client-name">Yariliz Pizarro · YP Realty</span>
          <h3>Estrategia Inmobiliaria Puerto Rico</h3>
          
          <div class="case-micro-brief">
            <p><strong>Contexto:</strong> Mercado inmobiliario en Puerto Rico con necesidad de captar compradores orgánicos en redes sociales.</p>
            <p><strong>Qué hice:</strong> Planificación de contenido, redacción de guiones con hooks visuales y edición dinámica de video vertical.</p>
          </div>

          <div class="study-metric-chip">
            <span class="metric-accent">↑ 604.5%</span>
            <span class="metric-caption">Interacciones de contenido (+56.1% alcance)</span>
          </div>

          <button class="study-btn-action" data-es="Ver caso de estudio profundo →" data-en="View deep case study →">Ver caso de estudio profundo →</button>
        </div>
      </div>

      <!-- 2. LANDING PAGES FREELANCE -->
      <div class="study-card" onclick="openModal('modal-freelance')">
        <div class="study-cover-holder">
          <img src="/portada freelance.png" alt="Landing Pages" onerror="this.src='/landingpage plataforma.png'" />
          <span class="study-badge">UX & Web Development</span>
        </div>
        <div class="study-body-content">
          <span class="client-name">Landing Pages Profesionales</span>
          <h3>Laura Navarro, Beatriz Briceño & MBI</h3>
          
          <div class="case-micro-brief">
            <p><strong>Contexto:</strong> Creación de portales de venta y archivo histórico para personalidades internacionales.</p>
            <p><strong>Qué hice:</strong> Arquitectura UX, diseño visual responsive y desarrollo en código limpio con Astro.</p>
          </div>

          <div class="study-metric-chip">
            <span class="metric-accent">3 Portales Web</span>
            <span class="metric-caption">Navegables en vivo con estándares responsive</span>
          </div>

          <button class="study-btn-action" data-es="Ver proyectos web navegables →" data-en="View live web projects →">Ver proyectos web navegables →</button>
        </div>
      </div>

      <!-- 3. IMPACTEMOS -->
      <div class="study-card" onclick="openModal('modal-impaktemos')">
        <div class="study-cover-holder">
          <img src="/portada-impaktemos.png" alt="Impactemos Plataforma" />
          <span class="study-badge">Operations & UX Flow</span>
        </div>
        <div class="study-body-content">
          <span class="client-name">Impactemos · Las Minitas</span>
          <h3>Plataforma de Voluntariado Nacional</h3>
          
          <div class="case-micro-brief">
            <p><strong>Contexto:</strong> Organización sin fines de lucro venezolana para programa de refuerzo escolar.</p>
            <p><strong>Qué hice:</strong> Diseño de landing page y flujo operativo para coordinar voluntarios y tareas comunitarias.</p>
          </div>

          <div class="study-metric-chip">
            <span class="metric-accent">100% Control</span>
            <span class="metric-caption">Gestión de actividades y flujo de voluntarios</span>
          </div>

          <button class="study-btn-action" data-es="Ver caso de impacto social →" data-en="View social impact case →">Ver caso de impacto social →</button>
        </div>
      </div>

    </div>

    <!-- SECCIÓN: MÁS EXPERIENCIAS -->
    <div class="more-experiences-panel">
      <div class="panel-left">
        <h3 data-es="Más experiencias profesionales" data-en="Additional professional experience">Más experiencias profesionales</h3>
        <p data-es="Trayectoria corporativa en coordinación internacional, comunicaciones internas y gestión de proyectos."
           data-en="Corporate background in international coordination, internal comms, and project management.">
          Trayectoria corporativa en coordinación internacional, comunicaciones internas y gestión de proyectos.
        </p>
      </div>

      <div class="experience-pills-cluster">
        <div class="exp-mini-card" onclick="openModal('modal-panhouse')">
          <strong>Editorial PanHouse</strong>
          <span>Marketing & Comunicación editorial (FIL Guadalajara)</span>
        </div>
        <div class="exp-mini-card" onclick="openModal('modal-dislocal')">
          <strong>Dislocal</strong>
          <span>Project Manager & Metodologías Ágiles de terreno</span>
        </div>
        <div class="exp-mini-card" onclick="openModal('modal-eurobuilding')">
          <strong>Eurobuilding</strong>
          <span>Comunicaciones internas & Business Center B2B 5★</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .studies-section {
    position: relative;
    width: 100%;
    padding: 130px 24px;
    background: transparent;
    display: flex;
    justify-content: center;
    z-index: 5;
  }

  .studies-container {
    max-width: 1180px;
    width: 100%;
  }

  .studies-headline {
    margin-bottom: 50px;
  }

  .studies-headline h2 {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .studies-headline p {
    font-size: 1.12rem;
    color: #64748b;
  }

  .studies-grid-main {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 30px;
    margin-bottom: 60px;
  }

  .study-card {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 300ms ease, box-shadow 300ms ease, border-color 300ms ease;
    display: flex;
    flex-direction: column;
  }

  .study-card:hover {
    transform: translateY(-8px) scale(1.01);
    box-shadow: 0 25px 50px rgba(0,0,0,0.08);
    border-color: #0f172a;
  }

  .study-cover-holder {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #0f172a;
  }

  .study-cover-holder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .study-card:hover .study-cover-holder img {
    transform: scale(1.04);
  }

  .study-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
  }

  .study-body-content {
    padding: 28px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .client-name {
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #b91c1c;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .study-body-content h3 {
    font-size: 1.45rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
    margin-bottom: 16px;
  }

  .case-micro-brief {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.92rem;
    line-height: 1.55;
    color: #475569;
    margin-bottom: 20px;
  }

  .case-micro-brief strong {
    color: #0f172a;
  }

  .study-metric-chip {
    background: #f8fafc;
    border-left: 3px solid #b91c1c;
    padding: 12px 14px;
    border-radius: 0 8px 8px 0;
    margin-top: auto;
    margin-bottom: 22px;
  }

  .metric-accent {
    display: block;
    font-size: 1.3rem;
    font-weight: 900;
    color: #0f172a;
  }

  .metric-caption {
    font-size: 0.82rem;
    color: #64748b;
    font-weight: 600;
  }

  .study-btn-action {
    width: 100%;
    padding: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .study-card:hover .study-btn-action {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  /* MÁS EXPERIENCIAS */
  .more-experiences-panel {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 20px;
    padding: 36px;
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 36px;
    align-items: center;
  }

  .panel-left h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 8px;
  }

  .panel-left p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #64748b;
  }

  .experience-pills-cluster {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .exp-mini-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 14px 18px;
    cursor: pointer;
    transition: transform 0.25s ease, border-color 0.25s ease;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .exp-mini-card:hover {
    transform: translateX(6px);
    border-color: #0f172a;
  }

  .exp-mini-card strong {
    font-size: 0.98rem;
    color: #0f172a;
  }

  .exp-mini-card span {
    font-size: 0.85rem;
    color: #64748b;
  }

  @media (max-width: 860px) {
    .more-experiences-panel { grid-template-columns: 1fr; }
  }
</style>
