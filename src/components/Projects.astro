---
---
<section id="projects" class="cases-section">
  <div class="cases-container">
    
    <div class="section-label" data-es="Evidencia" data-en="Evidence">
      Evidencia
    </div>

    <div class="cases-header">
      <h2 data-es="Proyectos que generan impacto." data-en="Projects that drive impact.">
        Proyectos que generan impacto.
      </h2>
      <p data-es="Estrategia digital, contenido audiovisual y desarrollo web con resultados medibles."
         data-en="Digital strategy, audiovisual content, and web development with measurable results.">
        Estrategia digital, contenido audiovisual y desarrollo web con resultados medibles.
      </p>
    </div>

    <div class="cases-featured-grid">
      
      <!-- 1. YP REALTY -->
      <div class="case-card-clean" onclick="openModal('modal-yprealty')">
        <div class="case-cover">
          <img src="/portada-yprealty.png" alt="YP Realty" style="object-position: top center;" />
          <span class="case-badge">Social Media & Video</span>
        </div>
        <div class="case-info">
          <h3>YP Realty</h3>
          <p class="case-role">Social Media Strategy · Video Editing · Content</p>
          <p class="case-snippet">Estrategia, guiones y edición de contenido orgánico para el mercado inmobiliario de Puerto Rico.</p>
          
          <div class="case-metric-box">
            <span class="metric-strong">↑ 604.5%</span>
            <span class="metric-info">en interacciones de contenido (+56.1% alcance)</span>
          </div>

          <button class="case-btn-link" data-es="Ver caso completo →" data-en="View full case →">Ver caso completo →</button>
        </div>
      </div>

      <!-- 2. LANDING PAGES FREELANCE -->
      <div class="case-card-clean" onclick="openModal('modal-freelance')">
        <div class="case-cover">
          <img src="/portada freelance.png" alt="Landing Pages" onerror="this.src='/landingpage plataforma.png'" />
          <span class="case-badge">UX · Web Design</span>
        </div>
        <div class="case-info">
          <h3>Landing Pages Freelance</h3>
          <p class="case-role">UX · Web Design · Responsive Development</p>
          <p class="case-snippet">Diseño y desarrollo de sitios web y landing pages adaptadas a diferentes marcas y perfiles de autoridad.</p>
          
          <div class="case-metric-box">
            <span class="metric-strong">3 Sitios Web</span>
            <span class="metric-info">Publicados y navegables en producción</span>
          </div>

          <button class="case-btn-link" data-es="Ver proyectos web →" data-en="View web projects →">Ver proyectos web →</button>
        </div>
      </div>

      <!-- 3. IMPAKTEMOS -->
      <div class="case-card-clean" onclick="openModal('modal-impaktemos')">
        <div class="case-cover">
          <img src="/portada-impaktemos.png" alt="Impaktemos Plataforma" />
          <span class="case-badge">Operations & UX</span>
        </div>
        <div class="case-info">
          <h3>Impaktemos</h3>
          <p class="case-role">Landing Page · Operations · UX Flow</p>
          <p class="case-snippet">Plataforma digital para organizar voluntarios, distribuir tareas y facilitar el seguimiento de actividades.</p>
          
          <div class="case-metric-box">
            <span class="metric-strong">100%</span>
            <span class="metric-info">Gestión operativa y monitoreo comunitario</span>
          </div>

          <button class="case-btn-link" data-es="Ver plataforma →" data-en="View platform →">Ver plataforma →</button>
        </div>
      </div>

    </div>

    <!-- BOTONES COMPLEMENTARIOS PARA NO SATURAR -->
    <div class="secondary-projects-bar">
      <div>
        <h4 data-es="Experiencia en Coordinación & Eventos" data-en="Coordination & Events Experience">Experiencia en Coordinación & Eventos</h4>
        <p>Casos corporativos con Editorial PanHouse (FIL Guadalajara), Dislocal y Eurobuilding.</p>
      </div>
      <div class="secondary-pills">
        <button onclick="openModal('modal-panhouse')">Editorial PanHouse</button>
        <button onclick="openModal('modal-dislocal')">Dislocal</button>
        <button onclick="openModal('modal-eurobuilding')">Eurobuilding</button>
      </div>
    </div>

  </div>
</section>

<style>
  .cases-section {
    position: relative;
    width: 100%;
    padding: 130px 24px;
    background: transparent;
    display: flex;
    justify-content: center;
    z-index: 5;
  }

  .cases-container {
    max-width: 1160px;
    width: 100%;
  }

  .cases-header {
    margin-bottom: 50px;
  }

  .cases-header h2 {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .cases-header p {
    font-size: 1.12rem;
    color: #64748b;
  }

  .cases-featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 28px;
    margin-bottom: 50px;
  }

  .case-card-clean {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 18px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 300ms ease, box-shadow 300ms ease;
    display: flex;
    flex-direction: column;
  }

  .case-card-clean:hover {
    transform: translateY(-6px) scale(1.01);
    box-shadow: 0 20px 45px rgba(0,0,0,0.07);
    border-color: #0f172a;
  }

  .case-cover {
    position: relative;
    width: 100%;
    height: 210px;
    overflow: hidden;
    background: #0f172a;
  }

  .case-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .case-card-clean:hover .case-cover img {
    transform: scale(1.04);
  }

  .case-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
  }

  .case-info {
    padding: 26px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .case-info h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 4px;
  }

  .case-role {
    font-size: 0.85rem;
    font-weight: 700;
    color: #3b82f6;
    margin-bottom: 12px;
  }

  .case-snippet {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 22px;
  }

  .case-metric-box {
    background: #f8fafc;
    border-left: 3px solid #fef08a;
    padding: 12px 14px;
    border-radius: 0 8px 8px 0;
    margin-top: auto;
    margin-bottom: 20px;
  }

  .metric-strong {
    display: block;
    font-size: 1.25rem;
    font-weight: 900;
    color: #0f172a;
  }

  .metric-info {
    font-size: 0.82rem;
    color: #64748b;
    font-weight: 600;
  }

  .case-btn-link {
    width: 100%;
    padding: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .case-card-clean:hover .case-btn-link {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  /* BARRA SECUNDARIA */
  .secondary-projects-bar {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    padding: 24px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .secondary-projects-bar h4 {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 4px;
  }

  .secondary-projects-bar p {
    font-size: 0.92rem;
    color: #64748b;
    margin: 0;
  }

  .secondary-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .secondary-pills button {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .secondary-pills button:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  @media (max-width: 800px) {
    .cases-section { padding: 80px 20px; }
    .secondary-projects-bar { flex-direction: column; align-items: flex-start; }
  }
</style>
