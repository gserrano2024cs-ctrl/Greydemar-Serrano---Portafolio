---
---
<section id="contact" class="contact-clean-section">
  <div class="contact-clean-container">
    
    <!-- COLUMNA IZQUIERDA: MENSAJE CÁLIDO + MEMOJI -->
    <div class="contact-left-narrative">
      
      <div class="memoji-greeting-box">
        <img src="/memoji.png" alt="Memoji de Grey Serrano" class="memoji-avatar" />
        <div class="status-pill">
          <span class="status-dot"></span>
          <span data-es="Disponible para proyectos & roles" data-en="Available for projects & roles">Disponible para proyectos & roles</span>
        </div>
      </div>

      <h2 class="contact-title" data-es="¿Trabajamos juntos?" data-en="Shall we work together?">
        ¿Trabajamos juntos?
      </h2>

      <p class="contact-body-text"
         data-es="Si buscas una profesional que pueda combinar contenido, social media, edición, UX y ejecución digital, conversemos. Estoy interesada en colaborar con equipos y proyectos donde estrategia y creatividad tengan un impacto medible."
         data-en="If you are looking for a professional who combines content, social media, video editing, UX, and digital execution, let's talk. I'm keen to collaborate with teams where strategy and creativity drive measurable impact.">
        Si buscas una profesional que pueda combinar contenido, social media, edición, UX y ejecución digital, conversemos. Estoy interesada en colaborar con equipos y proyectos donde estrategia y creatividad tengan un impacto medible.
      </p>

      <!-- ACCESOS DIRECTOS SIN DEPENDER EXCLUSIVAMENTE DEL FORMULARIO -->
      <div class="direct-channels">
        <span class="channels-label" data-es="Canales directos a un clic:" data-en="Direct channels in one click:">Canales directos:</span>
        <div class="channels-grid">
          <a href="mailto:greydemar06@gmail.com" class="channel-btn">
            <span>✉️</span> greydemar06@gmail.com
          </a>
          <a href="https://www.linkedin.com/in/greydemarserrano/" target="_blank" class="channel-btn">
            <span>💼</span> LinkedIn Profile
          </a>
          <a href="https://wa.me/584126339776" target="_blank" class="channel-btn">
            <span>💬</span> WhatsApp Directo
          </a>
          <a href="/CV-Greydemar-Serrano.pdf" target="_blank" class="channel-btn cv-highlight" download>
            <span>📄</span> Descargar Curriculum Vitae
          </a>
        </div>
      </div>

    </div>

    <!-- COLUMNA DERECHA: FORMULARIO A WHATSAPP -->
    <div class="contact-right-form">
      <div class="form-wrapper-clean">
        <h3 data-es="Enviar mensaje" data-en="Send message">Enviar mensaje</h3>
        
        <form id="wa-form" onsubmit="sendToWhatsApp(event)">
          <div class="field-group">
            <label for="wa-name" data-es="Nombre / Organización" data-en="Name / Organization">Nombre / Organización</label>
            <input type="text" id="wa-name" required placeholder="Ej. Ana de Agencia Creativa" />
          </div>

          <div class="field-group">
            <label for="wa-email" data-es="Correo de contacto" data-en="Email address">Correo de contacto</label>
            <input type="email" id="wa-email" required placeholder="ana@empresa.com" />
          </div>

          <div class="field-group">
            <label for="wa-message" data-es="Mensaje" data-en="Message">Mensaje</label>
            <textarea id="wa-message" rows="4" required placeholder="Hola Grey, queremos hablar contigo sobre..." data-es-placeholder="Hola Grey, queremos hablar contigo sobre..."></textarea>
          </div>

          <div class="privacy-note">
            <input type="checkbox" id="privacy-accept" required />
            <label for="privacy-accept" data-es="He leído y acepto los <a href='/terminos' target='_blank'>términos y privacidad</a>" data-en="I agree to the <a href='/terminos' target='_blank'>privacy policy</a>">
              Acepto los <a href="/terminos" target="_blank">términos de privacidad</a>
            </label>
          </div>

          <button type="submit" class="submit-action-btn" data-es="Iniciar conversación por WhatsApp" data-en="Start conversation on WhatsApp">
            Iniciar conversación por WhatsApp
          </button>
        </form>
      </div>
    </div>

  </div>
</section>

<style>
  .contact-clean-section {
    position: relative;
    width: 100%;
    padding: 130px 24px 160px;
    background: #0f172a;
    color: #ffffff;
    display: flex;
    justify-content: center;
    z-index: 5;
  }

  .contact-clean-container {
    max-width: 1140px;
    width: 100%;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 60px;
    align-items: center;
  }

  .memoji-greeting-box {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .memoji-avatar {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #fef08a;
    border: 2px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 10px #22c55e;
  }

  .contact-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 18px;
    line-height: 1.15;
  }

  .contact-body-text {
    font-size: 1.08rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 36px;
    max-width: 580px;
  }

  .channels-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.5);
    display: block;
    margin-bottom: 12px;
  }

  .channels-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .channel-btn {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 9px 16px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s ease;
  }

  .channel-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  .cv-highlight {
    background: #fef08a;
    color: #0f172a;
    border-color: #fef08a;
    font-weight: 700;
  }

  .cv-highlight:hover {
    background: #ffffff;
    color: #0f172a;
  }

  /* FORMULARIO */
  .form-wrapper-clean {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    border-radius: 20px;
    padding: 36px;
  }

  .form-wrapper-clean h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 24px;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 18px;
  }

  .field-group label {
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .field-group input, .field-group textarea {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 0.95rem;
    color: #ffffff;
    font-family: inherit;
    outline: none;
    transition: border-color 0.25s;
  }

  .field-group input:focus, .field-group textarea:focus {
    border-color: #fef08a;
  }

  .privacy-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
  }

  .privacy-note input {
    accent-color: #fef08a;
  }

  .privacy-note label {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .privacy-note a {
    color: #fef08a;
    text-decoration: underline;
  }

  .submit-action-btn {
    width: 100%;
    padding: 14px;
    background: #ffffff;
    color: #0f172a;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .submit-action-btn:hover {
    background: #fef08a;
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .contact-clean-section {
      padding: 80px 20px 140px;
    }
    .contact-clean-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .form-wrapper-clean {
      padding: 24px;
    }
  }
</style>
