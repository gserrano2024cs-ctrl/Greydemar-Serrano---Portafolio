<footer id="contact" class="closing-cinematic-section">
  <div class="closing-wrapper">
    
    <!-- TITULAR DE CIERRE REQUERIDO -->
    <div class="closing-statement-box">
      <span class="closing-tag" data-es="Próximo Paso" data-en="Next Step">Próximo Paso</span>
      
      <h2 class="closing-big-title" data-es="Transformemos ideas en experiencias digitales." data-en="Let's transform ideas into digital experiences.">
        Transformemos ideas en experiencias digitales.
      </h2>
      
      <p class="closing-subtext"
         data-es="Estrategia, contenido, video y experiencias web diseñadas para conectar marcas con audiencias reales."
         data-en="Strategy, content, video, and web experiences designed to connect brands with real audiences.">
        Estrategia, contenido, video y experiencias web diseñadas para conectar marcas con audiencias reales.
      </p>

      <!-- BOTÓN PRINCIPAL REQUERIDO -->
      <a href="https://wa.me/584126339776?text=%C2%A1Hola%20Grey!%20Me%20gustar%C3%ADa%20que%20trabajemos%20juntos%20en..." target="_blank" class="btn-work-together" data-es="Trabajemos juntos." data-en="Work together.">
        Trabajemos juntos.
      </a>
    </div>

    <!-- ISLA SECUNDARIA DE REDES SOCIALES Y CANALES -->
    <div class="secondary-social-strip">
      <div class="author-credits">
        <strong>GREYDEMAR SERRANO</strong>
        <span>Digital Content & Social Media Specialist</span>
      </div>

      <div class="direct-networks-hub">
        <a href="mailto:greydemar06@gmail.com" class="network-link">Email</a>
        <a href="https://www.linkedin.com/in/greydemarserrano/" target="_blank" class="network-link">LinkedIn</a>
        <a href="https://instagram.com" target="_blank" class="network-link">Instagram</a>
        <a href="https://wa.me/584126339776" target="_blank" class="network-link">WhatsApp</a>
      </div>
    </div>

    <!-- EASTER EGG SECRETO (LUCAS 30:24 / PARPADEO SUAVE Y PESTAÑAS VISIBLES AL 15%) -->
    <div class="secret-easter-egg-layer" title="Lucas 30:24">
      <div class="blinking-eyes-box">
        <svg width="44" height="20" viewBox="0 0 100 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g class="subtle-secret-eyes">
            <!-- Pestañas visibles ojo izquierdo -->
            <path d="M15,10 L10,0 M25,8 L25,-2 M35,10 L40,0" stroke="#ffffff" stroke-width="1.8"/>
            <!-- Ojo izquierdo -->
            <path d="M10,20 Q25,5 40,20 Q25,35 10,20 Z" stroke="#ffffff" stroke-width="2.5" fill="none"/>
            <circle cx="25" cy="20" r="4.5" fill="#ffffff"/>
            <!-- Pestañas visibles ojo derecho -->
            <path d="M65,10 L60,0 M75,8 L75,-2 M85,10 L90,0" stroke="#ffffff" stroke-width="1.8"/>
            <!-- Ojo derecho -->
            <path d="M60,20 Q75,5 90,20 Q75,35 60,20 Z" stroke="#ffffff" stroke-width="2.5" fill="none"/>
            <circle cx="75" cy="20" r="4.5" fill="#ffffff"/>
          </g>
        </svg>
        <span class="easter-egg-reference">LUCAS 30:24</span>
      </div>
    </div>

    <!-- FOOTER COPYRIGHT MINIMALISTA -->
    <div class="bottom-copyright-line">
      <p>© 2026 Greydemar Serrano (Grey). Todos los derechos reservados.</p>
    </div>

  </div>
</footer>

<style>
  .closing-cinematic-section {
    position: relative;
    width: 100%;
    background: #090d16;
    color: #ffffff;
    padding: 140px 24px 70px;
    display: flex;
    justify-content: center;
    overflow: hidden;
    z-index: 10;
  }

  .closing-wrapper {
    max-width: 1000px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .closing-tag {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #b91c1c;
    margin-bottom: 20px;
    display: inline-block;
  }

  .closing-big-title {
    font-size: clamp(2.4rem, 5.2vw, 4.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 24px;
    max-width: 860px;
  }

  .closing-subtext {
    font-size: 1.15rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    max-width: 620px;
    margin-bottom: 44px;
  }

  /* BOTÓN "TRABAJEMOS JUNTOS" */
  .btn-work-together {
    background: #ffffff;
    color: #0f172a;
    padding: 18px 42px;
    border-radius: 40px;
    font-size: 1.05rem;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: transform 300ms ease, background 300ms ease, box-shadow 300ms ease;
    display: inline-block;
  }

  .btn-work-together:hover {
    transform: scale(1.03);
    background: #fef08a;
    box-shadow: 0 10px 30px rgba(254, 240, 138, 0.3);
  }

  /* ISLA SECUNDARIA DE REDES */
  .secondary-social-strip {
    margin-top: 100px;
    width: 100%;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .author-credits {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .author-credits strong {
    font-size: 13px;
    letter-spacing: 0.18em;
    color: #ffffff;
  }

  .author-credits span {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
  }

  .direct-networks-hub {
    display: flex;
    gap: 20px;
  }

  .network-link {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .network-link:hover {
    color: #fef08a;
    transform: translateY(-2px);
  }

  /* EASTER EGG OCULTO: OJOS CON PARPADEO (15% OPACIDAD) */
  .secret-easter-egg-layer {
    margin-top: 60px;
    opacity: 0.15; /* Opacidad sutil 15% requerida */
    transition: opacity 0.5s ease;
    user-select: none;
  }

  .secret-easter-egg-layer:hover {
    opacity: 0.5; /* Se devela al pasar el cursor */
  }

  .blinking-eyes-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .subtle-secret-eyes {
    transform-origin: center;
    animation: gentleBlinkCycle 6s infinite ease-in-out;
  }

  @keyframes gentleBlinkCycle {
    0%, 90%, 100% { transform: scaleY(1); }
    94%, 98% { transform: scaleY(0.08); }
  }

  .easter-egg-reference {
    font-size: 8px;
    letter-spacing: 2px;
    color: #ffffff;
    font-weight: 700;
  }

  .bottom-copyright-line {
    margin-top: 30px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 768px) {
    .secondary-social-strip {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }
    .author-credits { text-align: center; }
  }
</style>
