---
---
<section id="contact" class="contact-section fade-in-section delay-6">
  <div class="contact-container mac-window">
    <div class="contact-left light-gray-bg">
      <h2 class="coffee-title">
        <span data-es="Hagamos crecer tu proyecto." data-en="Let's grow your project.">Hagamos crecer tu proyecto.</span>
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="coffee-cup-svg">
          <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
          <path class="steam steam-1" d="M6 2c0 2-2 2-2 4s2 2 2 4" />
          <path class="steam steam-2" d="M10 2c0 2-2 2-2 4s2 2 2 4" />
          <path class="steam steam-3" d="M14 2c0 2-2 2-2 4s2 2 2 4" />
        </svg>
      </h2>
      <p data-es="Si buscas un perfil que entienda tanto de retención de audiencia en redes sociales como de código y maquetación Front-End, escríbeme y hablemos de soluciones." data-en="If you are looking for a profile that understands both audience retention on social media and coding/layout for Front-End, write me and let's talk solutions.">Si buscas un perfil que entienda tanto de retención de audiencia en redes sociales como de código y maquetación Front-End, escríbeme y hablemos de soluciones.</p>
      
      <div class="contact-socials-row">
        <a href="https://wa.me/584126339776" target="_blank" class="social-icon-btn" title="WhatsApp"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg></a>
        <a href="mailto:greydemar06@gmail.com" class="social-icon-btn" title="Correo"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg></a>
        <a href="https://www.linkedin.com/in/greydemarserrano/" target="_blank" class="social-icon-btn" title="LinkedIn"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg></a>
      </div>
    </div>

    <div class="contact-right glass-panel">
      <h3 style="margin-bottom: 24px; font-size: 1.8rem; font-weight: 800;" data-es="Déjame un mensaje." data-en="Leave me a message.">Déjame un mensaje.</h3>
      <form class="contact-form" id="wa-form" onsubmit="sendToWhatsApp(event)">
        <div class="input-group"><label data-es="Tu Nombre" data-en="Your Name">Tu Nombre</label><input type="text" id="wa-name" required placeholder="Ej. Ana Pérez" /></div>
        <div class="input-group"><label data-es="Tu Correo" data-en="Your Email">Tu Correo</label><input type="email" id="wa-email" required placeholder="ana@empresa.com" /></div>
        <div class="input-group"><label data-es="Mensaje" data-en="Message">Mensaje</label><textarea id="wa-message" rows="4" required placeholder="Hola Grey, me gustaría que trabajáramos en..." data-es-placeholder="Hola Grey, me gustaría que trabajáramos en..."></textarea></div>
        
        <div class="privacy-disclaimer">
          <p data-es="Tus datos serán tratados por Greydemar Serrano con la finalidad de responder tu consulta. No se almacenan en bases de datos. <a href='/terminos' target='_blank' class='privacy-link'>Más información</a>" data-en="Your data will be processed by Greydemar Serrano to answer your query. Data is not stored in databases. <a href='/terminos' target='_blank' class='privacy-link'>More info</a>">
            Tus datos serán tratados por Greydemar Serrano con la finalidad de responder tu consulta. Puedes ejercer tus derechos de acceso, rectificación, cancelación y oposición en greydemar06@gmail.com. <a href="/terminos" target="_blank" class="privacy-link">Más información</a>
          </p>
        </div>
        
        <div class="privacy-checkbox-group">
          <input type="checkbox" id="privacy-accept" required />
          <label for="privacy-accept" data-es="He leído y acepto la <a href='/terminos' target='_blank' class='privacy-link'>política de privacidad</a>" data-en="I have read and accept the <a href='/terminos' target='_blank' class='privacy-link'>privacy policy</a>">He leído y acepto la <a href="/terminos" target="_blank" class="privacy-link">política de privacidad</a></label>
        </div>

        <button type="submit" class="submit-btn" data-es="Enviar mensaje" data-en="Send message">Enviar mensaje</button>
      </form>
    </div>
  </div>
</section>
