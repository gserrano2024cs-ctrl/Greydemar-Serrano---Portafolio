---
---
<section id="about" class="about-section">
  <div class="about-container">
    
    <div class="section-label" data-es="Sobre mí" data-en="About me">
      Sobre mí
    </div>

    <div class="about-editorial-grid">
      
      <!-- COLUMNA TEXTO -->
      <div class="narrative-col">
        <h2 class="narrative-title" data-es="Comunicación estratégica, contenido de impacto y experiencias digitales." data-en="Strategic communication, impactful content, and digital experiences.">
          Comunicación estratégica, contenido de impacto y experiencias digitales.
        </h2>

        <div class="narrative-paragraphs">
          <p data-es="Soy <strong>Grey Serrano</strong>, comunicadora social especializada en contenido digital, social media y experiencias web." data-en="I am <strong>Grey Serrano</strong>, a communications specialist focused on digital content, social media, and web experiences.">
            Soy <strong>Grey Serrano</strong>, comunicadora social especializada en contenido digital, social media y experiencias web.
          </p>
          <p data-es="Mi formación en comunicación me permitió desarrollar una visión estratégica para <strong>comprender audiencias, crear mensajes efectivos y transformar ideas en soluciones digitales</strong>." data-en="My communications background enabled me to develop a strategic vision to <strong>understand audiences, craft effective messages, and turn ideas into digital solutions</strong>.">
            Mi formación en comunicación me permitió desarrollar una visión estratégica para <strong>comprender audiencias, crear mensajes efectivos y transformar ideas en soluciones digitales</strong>.
          </p>
          <p data-es="Durante mi trayectoria he trabajado en proyectos de contenido, comunidades digitales, desarrollo web y estrategias de comunicación para marcas y organizaciones." data-en="Throughout my career I have worked on content projects, digital communities, web development, and communication strategies for brands and organizations.">
            Durante mi trayectoria he trabajado en proyectos de contenido, comunidades digitales, desarrollo web y estrategias de comunicación para marcas y organizaciones.
          </p>
        </div>

        <!-- ACCIONES REUBICADAS CON CONTEXTO -->
        <div class="cta-row">
          <a href="#projects" class="btn-editorial-primary" data-es="Ver casos destacados" data-en="View featured cases">Ver casos destacados</a>
          <a href="#contact" class="btn-editorial-secondary" data-es="Contactarme" data-en="Get in touch">Contactarme</a>
        </div>
      </div>

      <!-- COLUMNA VISUAL (FOTO + CONTADORES) -->
      <div class="visual-col">
        <div class="photo-frame-premium">
          <img 
            src="/grey profile (2).jpeg" 
            alt="Grey Serrano - Profile" 
            class="photo-element"
            onerror="this.src='/perfil.jpg';"
          />
        </div>

        <div class="counters-grid">
          <div class="counter-item">
            <span class="counter-num" data-target="5">+0</span>
            <span class="counter-label" data-es="años de experiencia" data-en="years experience">años experiencia</span>
          </div>

          <div class="counter-item">
            <span class="counter-num" data-target="13">+0</span>
            <span class="counter-label" data-es="marcas y organizaciones" data-en="brands & organizations">marcas y organizaciones</span>
          </div>

          <div class="counter-item counter-wide">
            <span class="counter-num" data-target="8">+0</span>
            <span class="counter-label" data-es="proyectos digitales desarrollados" data-en="digital projects developed">proyectos digitales</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  // Animación contadores numéricos
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const counters = entry.target.querySelectorAll('.counter-num');
          counters.forEach(counter => {
            const target = +counter.getAttribute('data-target');
            let count = 0;
            const step = Math.ceil(target / 25);
            const timer = setInterval(() => {
              count += step;
              if (count >= target) {
                counter.innerText = `+${target}`;
                clearInterval(timer);
              } else {
                counter.innerText = `+${count}`;
              }
            }, 40);
          });
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    const grid = document.querySelector('.counters-grid');
    if (grid) observer.observe(grid);
  });
</script>

<style>
  .about-section {
    position: relative;
    width: 100%;
    padding: 140px 24px;
    display: flex;
    justify-content: center;
    background: transparent;
    z-index: 5;
  }

  .about-container {
    max-width: 1160px;
    width: 100%;
  }

  .section-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #64748b;
    margin-bottom: 24px;
    padding: 4px 12px;
    background: rgba(15, 23, 42, 0.05);
    display: inline-block;
    border-radius: 4px;
  }

  .about-editorial-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 60px;
    align-items: center;
  }

  .narrative-title {
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 28px;
  }

  .narrative-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .narrative-paragraphs p {
    font-size: 1.08rem;
    line-height: 1.75;
    color: #475569;
    margin: 0;
  }

  .narrative-paragraphs strong {
    color: #0f172a;
    font-weight: 700;
  }

  .cta-row {
    display: flex;
    gap: 16px;
    margin-top: 38px;
  }

  .btn-editorial-primary, .btn-editorial-secondary {
    padding: 13px 26px;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 300ms ease, box-shadow 300ms ease, background 300ms ease;
    cursor: pointer;
  }

  .btn-editorial-primary {
    background: #0f172a;
    color: #ffffff;
  }

  .btn-editorial-primary:hover {
    transform: scale(1.03);
    background: #1e293b;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
  }

  .btn-editorial-secondary {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }

  .btn-editorial-secondary:hover {
    transform: scale(1.03);
    border-color: #0f172a;
  }

  .btn-editorial-primary:active, .btn-editorial-secondary:active {
    transform: scale(0.98);
  }

  /* FOTO Y CONTADORES */
  .visual-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
  }

  .photo-frame-premium {
    width: 100%;
    max-width: 380px;
    height: 380px;
    border-radius: 20px;
    overflow: hidden;
    background: #f1f5f9;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.07);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .photo-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .counters-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    width: 100%;
    max-width: 380px;
  }

  .counter-item {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid #e2e8f0;
    padding: 16px;
    border-radius: 12px;
    text-align: center;
  }

  .counter-wide {
    grid-column: span 2;
  }

  .counter-num {
    display: block;
    font-size: 2rem;
    font-weight: 900;
    color: #0f172a;
    line-height: 1;
    margin-bottom: 4px;
  }

  .counter-label {
    font-size: 0.82rem;
    color: #64748b;
    font-weight: 600;
    text-transform: capitalize;
  }

  @media (max-width: 860px) {
    .about-section { padding: 90px 20px; }
    .about-editorial-grid { grid-template-columns: 1fr; gap: 40px; }
    .visual-col { order: -1; }
  }
</style>
