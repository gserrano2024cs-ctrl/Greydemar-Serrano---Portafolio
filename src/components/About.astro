---
---
<section id="about" class="about-narrative-section">
  <div class="about-narrative-wrapper">
    
    <div class="section-kicker" data-es="Identidad & Visión" data-en="Identity & Vision">
      Identidad & Visión
    </div>

    <!-- GANCHO PROFESIONAL EXACTO -->
    <div class="lead-statement-wrap">
      <h2 class="lead-statement" data-es="Transformar ideas en contenido, experiencias digitales y estrategias que conectan marcas con personas." data-en="Transforming ideas into content, digital experiences, and strategies that connect brands with people.">
        Transformar ideas en contenido, experiencias digitales y estrategias que conectan marcas con personas.
      </h2>
      <p class="lead-bio" data-es="Soy <strong>Greydemar Serrano</strong>, comunicador social y la mente creativa detrás de <strong>Grey</strong>. Mi enfoque une la investigación de audiencias con la ejecución audiovisual de alta retención y el diseño web estratégico."
         data-en="I am <strong>Greydemar Serrano</strong>, a communications specialist and the creative mind behind <strong>Grey</strong>. My approach bridges audience research with high-retention video execution and strategic web design.">
        Soy <strong>Greydemar Serrano</strong>, comunicador social y la mente creativa detrás de <strong>Grey</strong>. Mi enfoque une la investigación de audiencias con la ejecución audiovisual de alta retención y el diseño web estratégico.
      </p>
    </div>

    <!-- COLLAGE DINÁMICO DE 3 IMÁGENES (FORMACIÓN, RUNNING, EQUIPO) -->
    <div class="visual-collage-triptych">
      
      <!-- FOTO 1: GRADUACIÓN (Comunicación profesional y formación) -->
      <div class="collage-item collage-academic" data-caption="Formación en Comunicación Social">
        <div class="image-inner-holder">
          <img 
            src="/graduacion.jpg" 
            alt="Greydemar Serrano - Graduación Comunicación Social" 
            class="collage-img" 
            onerror="this.src='/grey profile (2).jpeg';" 
          />
        </div>
        <div class="card-glass-footnote">
          <span class="footnote-pillar">Fundamento</span>
          <span class="footnote-text" data-es="Comunicación Social & Estrategia" data-en="Social Communications & Strategy">Comunicación Social & Estrategia</span>
        </div>
      </div>

      <!-- FOTO 2: RUNNING (Disciplina, constancia y mentalidad) -->
      <div class="collage-item collage-athletic" data-caption="Disciplina y constancia de alto rendimiento">
        <div class="image-inner-holder">
          <img 
            src="/running.jpg" 
            alt="Greydemar Serrano - Running y Disciplina" 
            class="collage-img" 
            onerror="this.src='/perfil.jpg';" 
          />
        </div>
        <div class="card-glass-footnote">
          <span class="footnote-pillar">Mentalidad</span>
          <span class="footnote-text" data-es="Disciplina & Constancia" data-en="Discipline & High Performance">Disciplina & Constancia</span>
        </div>
      </div>

      <!-- FOTO 3: TRABAJO EN EQUIPO (Colaboración y liderazgo) -->
      <div class="collage-item collage-collaborative" data-caption="Liderazgo y coordinación multidisciplinaria">
        <div class="image-inner-holder">
          <img 
            src="/equipo euro.png" 
            alt="Greydemar Serrano - Trabajo en equipo" 
            class="collage-img" 
            onerror="this.src='/dislocal 1.png';" 
          />
        </div>
        <div class="card-glass-footnote">
          <span class="footnote-pillar">Cultura</span>
          <span class="footnote-text" data-es="Colaboración & Liderazgo" data-en="Collaboration & Leadership">Colaboración & Liderazgo</span>
        </div>
      </div>

    </div>

    <!-- EXPERIENCIA / INDICADORES MINIMALISTAS ANIMADOS -->
    <div class="experience-strip-minimal">
      
      <div class="indicator-unit">
        <span class="metric-figure" data-target="5">+0</span>
        <span class="metric-title" data-es="Años creando contenido digital" data-en="Years creating digital content">Años creando contenido digital</span>
      </div>

      <div class="indicator-divider"></div>

      <div class="indicator-unit">
        <span class="metric-figure" data-target="13">+0</span>
        <span class="metric-title" data-es="Años de trayectoria profesional" data-en="Years of career journey">Años de trayectoria profesional</span>
      </div>

      <div class="indicator-divider"></div>

      <div class="indicator-unit">
        <span class="metric-figure" data-target="8">+0</span>
        <span class="metric-title" data-es="Participación en proyectos creativos" data-en="Creative project participations">Participación en proyectos creativos</span>
      </div>

    </div>

    <!-- LLAMADOS DE ACCIÓN CONTEXTUALES -->
    <div class="about-action-anchor">
      <a href="#projects" class="btn-primary-dark" data-es="Explorar proyectos" data-en="Explore projects">Explorar proyectos</a>
      <a href="#contact" class="btn-outline-minimal" data-es="Trabajemos juntos" data-en="Work together">Trabajemos juntos</a>
    </div>

  </div>
</section>

<script is:inline>
  // Animación de contadores de experiencia al entrar en pantalla
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const numbers = entry.target.querySelectorAll('.metric-figure');
          numbers.forEach(num => {
            const target = +num.getAttribute('data-target');
            let count = 0;
            const step = Math.ceil(target / 20);
            const timer = setInterval(() => {
              count += step;
              if (count >= target) {
                num.innerText = `+${target}`;
                clearInterval(timer);
              } else {
                num.innerText = `+${count}`;
              }
            }, 45);
          });
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.25 });

    const strip = document.querySelector('.experience-strip-minimal');
    if (strip) observer.observe(strip);
  });
</script>

<style>
  .about-narrative-section {
    position: relative;
    width: 100%;
    padding: 140px 24px;
    display: flex;
    justify-content: center;
    background: transparent;
    z-index: 5;
  }

  .about-narrative-wrapper {
    max-width: 1180px;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .section-kicker {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #b91c1c; /* Acento rojo profundo */
    margin-bottom: 22px;
  }

  .lead-statement-wrap {
    max-width: 900px;
    margin-bottom: 60px;
  }

  .lead-statement {
    font-size: clamp(2.1rem, 3.8vw, 3.4rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }

  .lead-bio {
    font-size: 1.15rem;
    line-height: 1.75;
    color: #475569;
  }

  .lead-bio strong {
    color: #0f172a;
    font-weight: 700;
  }

  /* COLLAGE DE 3 IMÁGENES */
  .visual-collage-triptych {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
    margin-bottom: 70px;
  }

  .collage-item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #e2e8f0;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collage-item:hover {
    transform: translateY(-8px);
  }

  .image-inner-holder {
    width: 100%;
    height: 380px;
    overflow: hidden;
  }

  .collage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .collage-item:hover .collage-img {
    transform: scale(1.04);
  }

  .card-glass-footnote {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(10px);
    padding: 10px 14px;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footnote-pillar {
    font-size: 10px;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #fef08a;
  }

  .footnote-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ffffff;
  }

  /* INDICADORES MINIMALISTAS */
  .experience-strip-minimal {
    display: flex;
    justify-content: space-around;
    align-items: center;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 18px;
    padding: 34px 28px;
    margin-bottom: 50px;
  }

  .indicator-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
  }

  .metric-figure {
    font-size: 3.2rem;
    font-weight: 900;
    color: #0f172a;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 6px;
  }

  .metric-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: #64748b;
    max-width: 220px;
    line-height: 1.4;
  }

  .indicator-divider {
    width: 1px;
    height: 50px;
    background: rgba(0, 0, 0, 0.08);
  }

  /* BOTONES */
  .about-action-anchor {
    display: flex;
    gap: 16px;
  }

  .btn-primary-dark {
    background: #0f172a;
    color: #ffffff;
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 300ms ease, background 300ms ease;
  }

  .btn-primary-dark:hover {
    transform: scale(1.03);
    background: #1e293b;
  }

  .btn-outline-minimal {
    background: transparent;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 300ms ease, border-color 300ms ease;
  }

  .btn-outline-minimal:hover {
    transform: scale(1.03);
    border-color: #0f172a;
  }

  @media (max-width: 900px) {
    .visual-collage-triptych {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .image-inner-holder { height: 280px; }
    .experience-strip-minimal {
      flex-direction: column;
      gap: 24px;
    }
    .indicator-divider {
      width: 60px;
      height: 1px;
    }
  }
</style>
