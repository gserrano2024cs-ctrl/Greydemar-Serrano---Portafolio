---
---
<section id="about" class="about-section">
  <div class="about-container">
    
    <div class="section-tag" data-es="Sobre Grey" data-en="About Grey">
      Sobre Grey
    </div>

    <!-- NARRATIVA DE COMUNICADORA SOCIAL -->
    <div class="about-grid">
      
      <div class="about-text-column">
        <h2 class="about-lead-title" data-es="Estrategia, comunicación y ejecución digital con propósito." data-en="Strategy, communication, and digital execution with purpose.">
          Estrategia, comunicación y ejecución digital con propósito.
        </h2>

        <div class="narrative-body">
          <p data-es="Soy <strong>Grey Serrano</strong>, comunicadora social especializada en creación de contenido digital, social media y experiencias web." data-en="I am <strong>Grey Serrano</strong>, a communications specialist focused on digital content creation, social media, and web experiences.">
            Soy <strong>Grey Serrano</strong>, comunicadora social especializada en creación de contenido digital, social media y experiencias web.
          </p>
          <p data-es="Mi formación en comunicación me permitió desarrollar una visión estratégica para <strong>entender audiencias, crear mensajes efectivos y transformar ideas en contenido con propósito</strong>." data-en="My background in communications enabled me to develop a strategic vision to <strong>understand audiences, craft effective messages, and transform ideas into purposeful content</strong>.">
            Mi formación en comunicación me permitió desarrollar una visión estratégica para <strong>entender audiencias, crear mensajes efectivos y transformar ideas en contenido con propósito</strong>.
          </p>
          <p data-es="A lo largo de mi trayectoria he trabajado con marcas y organizaciones desarrollando estrategias digitales, contenido audiovisual, gestión de comunidades y soluciones web enfocadas en mejorar la experiencia del usuario." data-en="Throughout my journey, I have partnered with brands and organizations developing digital strategies, audiovisual content, community management, and web solutions focused on enhancing user experience.">
            A lo largo de mi trayectoria he trabajado con marcas y organizaciones desarrollando estrategias digitales, contenido audiovisual, gestión de comunidades y soluciones web enfocadas en mejorar la experiencia del usuario.
          </p>
        </div>

        <!-- BLOQUE FORMACIÓN -->
        <div class="sub-block">
          <span class="sub-block-title" data-es="Formación & Especialidad:" data-en="Education & Background:">Formación & Especialidad:</span>
          <div class="pills-cloud">
            <span class="pill">Comunicación Social</span>
            <span class="pill">Marketing Digital</span>
            <span class="pill">UX/UI & Landing Pages</span>
            <span class="pill">Content Creation</span>
          </div>
        </div>

        <!-- CTAs SECUNDARIOS REUBICADOS CON CONTEXTO -->
        <div class="about-actions-row">
          <a href="#projects" class="btn-clean-primary" data-es="Ver casos destacados" data-en="View featured cases">Ver casos destacados</a>
          <a href="#contact" class="btn-clean-secondary" data-es="Contactarme" data-en="Get in touch">Contactarme</a>
        </div>
      </div>

      <!-- FOTO PROFESIONAL + MÉTRICAS -->
      <div class="about-visual-column">
        <div class="profile-card-minimal">
          <div class="photo-container">
            <img 
              src="/perfil.jpg" 
              alt="Grey Serrano - Comunicadora Social y Digital Content Specialist" 
              class="profile-img"
              onerror="this.src='/portada freelance.png'; this.style.filter='grayscale(20%)';"
            />
          </div>
          
          <div class="experience-stats-grid">
            <div class="stat-box">
              <span class="stat-number">+5 años</span>
              <span class="stat-label" data-es="Experiencia digital" data-en="Digital experience">Experiencia digital</span>
            </div>
            <div class="stat-box">
              <span class="stat-number">+13</span>
              <span class="stat-label" data-es="Marcas y organizaciones" data-en="Brands & organizations">Marcas y organizaciones</span>
            </div>
            <div class="stat-box stat-full">
              <span class="stat-number">+8</span>
              <span class="stat-label" data-es="Proyectos desarrollados y coordinados" data-en="Projects developed & coordinated">Proyectos coordinados</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .about-section {
    position: relative;
    width: 100%;
    padding: 130px 24px;
    display: flex;
    justify-content: center;
    background: #ffffff;
    z-index: 5;
  }

  .about-container {
    max-width: 1140px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .section-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #64748b;
    margin-bottom: 24px;
    display: inline-block;
    padding: 4px 10px;
    background: #f1f5f9;
    border-radius: 6px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: center;
    width: 100%;
  }

  .about-lead-title {
    font-size: clamp(1.9rem, 3.2vw, 2.7rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }

  .narrative-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .narrative-body p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #475569;
    margin: 0;
  }

  .narrative-body strong {
    color: #0f172a;
    font-weight: 700;
  }

  .sub-block {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid #f1f5f9;
  }

  .sub-block-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    display: block;
    margin-bottom: 12px;
  }

  .pills-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #0f172a;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 20px;
  }

  .about-actions-row {
    display: flex;
    gap: 14px;
    margin-top: 36px;
  }

  .btn-clean-primary, .btn-clean-secondary {
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-clean-primary {
    background: #0f172a;
    color: #ffffff;
  }

  .btn-clean-primary:hover {
    background: #1e293b;
    transform: translateY(-2px);
  }

  .btn-clean-secondary {
    background: #f8fafc;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }

  .btn-clean-secondary:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
    transform: translateY(-2px);
  }

  /* TARJETA VISUAL DERECHA */
  .about-visual-column {
    display: flex;
    justify-content: center;
  }

  .profile-card-minimal {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.04);
    width: 100%;
    max-width: 380px;
  }

  .photo-container {
    width: 100%;
    height: 320px;
    border-radius: 14px;
    overflow: hidden;
    background: #f1f5f9;
    margin-bottom: 20px;
  }

  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .experience-stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .stat-box {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    padding: 14px;
    border-radius: 10px;
    text-align: center;
  }

  .stat-full {
    grid-column: span 2;
  }

  .stat-number {
    display: block;
    font-size: 1.6rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 500;
    margin-top: 4px;
    display: block;
  }

  @media (max-width: 900px) {
    .about-section {
      padding: 80px 20px;
    }
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .about-visual-column {
      order: -1;
    }
    .profile-card-minimal {
      max-width: 320px;
    }
    .photo-container {
      height: 260px;
    }
  }
</style>
