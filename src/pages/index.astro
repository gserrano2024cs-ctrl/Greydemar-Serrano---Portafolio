        <div class="modal-title-row">
          <div class="title-text-group">
            <span class="project-counter" data-es="Proyecto 03 / 06" data-en="Project 03 / 06">Proyecto 03 / 06</span>
            <h2 data-es="Freelance Web" data-en="Freelance Web">Freelance Web</h2>
