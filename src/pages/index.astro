  /* =========================================================
     HERO EDITORIAL — estudio digital + iOS/macOS restraint
     ========================================================= */
  .hero-editorial {
    position: relative;
    z-index: 10;
    padding: 22px;
    min-height: 100svh;
    background: #ececec;
    overflow: hidden;
  }

  .hero-editorial-shell {
    --hero-pad: clamp(24px, 4vw, 64px);
    position: relative;
    min-height: calc(100svh - 44px);
    max-width: 1600px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: clamp(30px, 4vw, 64px);
    background: #fbfbfa;
    border: 1px solid rgba(15, 23, 42, .08);
    box-shadow:
      0 34px 80px rgba(15, 23, 42, .10),
      inset 0 1px 0 rgba(255, 255, 255, .96);
    isolation: isolate;
