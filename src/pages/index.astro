  <script is:inline>
    // Cambio de Idioma
    function setLanguage(lang) {
      document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');

      document.querySelectorAll('[data-es]').forEach(el => {
        el.innerHTML = el.getAttribute(`data-${lang}`);
      });

      document.querySelectorAll('[data-tooltip-es]').forEach(el => {
        el.setAttribute('data-tooltip', el.getAttribute(`data-tooltip-${lang}`));
      });
    }

    // Funciones de las Ventanas Modales (Proyectos)
    function openModal(modalId) {
      document.getElementById(modalId).classList.add('active');
      document.body.style.overflow = 'hidden'; // Evita que se pueda hacer scroll atrás
    }

    function closeModal(modalId) {
      document.getElementById(modalId).classList.remove('active');
      document.body.style.overflow = 'auto'; // Restaura el scroll
    }

    function closeModalOutside(event, modalId) {
      if (event.target.id === modalId) {
        closeModal(modalId);
      }
    }
  </script>

