  .orbit-one { left: 9%; top: 24%; animation: orbitFloatA 8s ease-in-out infinite; }
  .orbit-two { left: 20%; bottom: 28%; width: clamp(88px, 9vw, 132px); animation: orbitFloatB 10s ease-in-out infinite; }

  .hero-wordmark {
    position: absolute;
    z-index: 2;
    left: 2.5%;
    right: 2.5%;
