---
import Hero from "../components/Hero.astro";
import DisciplineMarquee from "../components/DisciplineMarquee.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import Projects from "../components/Projects.astro";
import ClientMarquee from "../components/ClientMarquee.astro";
import Contact from "../components/Contact.astro";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- SEO OFICIAL SOLICITADO -->
  <title>Grey Serrano | Digital Content & Social Media Specialist</title>
  <meta name="title" content="Grey Serrano | Digital Content & Social Media Specialist">
  <meta name="description" content="Portfolio of Grey Serrano, Digital Content Specialist focused on Social Media, Community Management, Video Editing and UX Landing Pages.">
  <meta name="keywords" content="Social Media, Community Management, Video Editing, UX Landing Pages, Digital Content Specialist, Grey Serrano, Astro">

  <!-- Open Graph -->
  <meta property="og:title" content="Grey Serrano | Digital Content & Social Media Specialist">
  <meta property="og:description" content="Estrategias y contenidos digitales que ayudan a las marcas a conectar, crear comunidad y transformar ideas en experiencias digitales.">
  <meta property="og:type" content="website">

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%230f172a%22 rx=%2212%22/><g transform=%22skewX(-15)%22><text x=%2260%22 y=%2272%22 font-size=%2265%22 font-weight=%22900%22 font-family=%22sans-serif%22 fill=%22%23ffffff%22 text-anchor=%22middle%22>G</text></g></svg>">

  <!-- TIPOGRAFÍAS: MONTSERRAT (Funcional) + PLAYFAIR DISPLAY (Editorial) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
</head>
<body>

  <!-- ZOOM OVERLAY GLOBAL -->
  <div id="zoom-overlay" class="zoom-overlay" onclick="closeZoom(event)">
    <button class="zoom-close" onclick="closeZoom(event)">✕</button>
    <div class="zoom-content-wrapper">
      <div id="zoom-media-container"></div>
      <p id="zoom-caption"></p>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- SECUENCIA DEFINITIVA DE SECCIONES          -->
  <!-- ========================================== -->
  <Hero />
  <DisciplineMarquee />
  <About />
  <Services />
  <Projects />
  <ClientMarquee />
  <Contact />

  <!-- FOOTER MINIMALISTA -->
  <footer class="site-footer">
    <p data-es="© 2026 Grey Serrano. Todos los derechos reservados." data-en="© 2026 Grey Serrano. All rights reserved.">
      © 2026 Grey Serrano. Todos los derechos reservados.
    </p>
  </footer>

  <!-- DOCK FLOTANTE CON ACCESOS DIRECTOS -->
  <nav class="floating-dock">
    <ul class="dock-list">
      <li class="dock-item" data-tooltip="Sobre mí"><a href="#about" class="dock-link"><img src="/notas.webp" class="mac-icon" alt="Sobre mí"></a></li>
      <li class="dock-item" data-tooltip="Servicios"><a href="#services" class="dock-link"><img src="/finder icon.png" class="mac-icon" alt="Servicios"></a></li>
      <li class="dock-item" data-tooltip="Proyectos"><a href="#projects" class="dock-link"><img src="/foto.png" class="mac-icon" alt="Proyectos"></a></li>
      <li class="dock-item" data-tooltip="Contacto"><a href="#contact" class="dock-link"><img src="/ICON MAIL.webp" class="mac-icon" alt="Contacto"></a></li>
    </ul>
  </nav>

  <!-- ========================================== -->
  <!-- MODALES DE PROYECTOS CON FORMATO ESTÁNDAR  -->
  <!-- ========================================== -->

  <!-- MODAL 1: YP REALTY -->
  <div id="modal-yprealty" class="modal-overlay" onclick="closeModalOutside(event, 'modal-yprealty')">
    <div class="modal-window">
      <div class="modal-mac-bar">
        <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
        <div class="modal-search-bar">yprealty.com · Caso Social Media & Video</div>
        <button class="close-btn-text" onclick="closeModal('modal-yprealty')">Cerrar</button>
      </div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada-yprealty.png" alt="YP Realty Banner" style="object-position: top center;" /></div>
        <div class="modal-title-row">
          <div class="title-text-group">
            <span class="project-counter">Caso 01 / 06</span>
            <h2>YP Realty</h2>
          </div>
        </div>

        <div class="structured-brief">
          <div class="brief-item"><strong>Empresa / Contexto:</strong> Agencia inmobiliaria en Puerto Rico que buscaba captar compradores orgánicos en redes sociales.</div>
          <div class="brief-item"><strong>Objetivo:</strong> Aumentar interacción de valor y autoridad de marca a través de formatos de video corto.</div>
          <div class="brief-item"><strong>Qué hice:</strong> Planificación estratégica, redacción de guiones con hooks visuales, edición dinámica de Reels/TikToks y analítica.</div>
          <div class="brief-item result-item">
            <strong>Resultados obtenidos:</strong>
            <span class="highlight-metric">↑ 604.5% en interacciones de contenido</span> y <span class="highlight-metric">↑ 56.1% en alcance orgánico</span>.
          </div>
        </div>

        <div class="metadata-grid">
          <div><span class="meta-label">Rol</span><span class="meta-val">Social Media Manager & Video Editor</span></div>
          <div><span class="meta-label">Herramientas</span><span class="meta-val">Meta Business Suite, CapCut, Premiere, Canva Pro</span></div>
          <div><span class="meta-label">Métricas / KPIs</span><span class="meta-val">Reach, Content Interactions, Engagement Rate</span></div>
        </div>

        <div class="modal-gallery-container">
          <h3>Galería del Proyecto</h3>
          <div class="bento-collage">
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Cisterna de agua en PR." onclick="openGalleryZoom(this)" style="background:#000;"><source src="/VIDEO PARA PORTAFOLIO.webm" type="video/webm" /></video><div class="media-caption">Cisterna de agua en PR.</div></div>
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Cierre de venta en Arecibo, Puerto Rico." onclick="openGalleryZoom(this)" style="background:#000;"><source src="/PARA-PORTAFOLIO.webm" type="video/webm" /></video><div class="media-caption">Cierre de venta en Arecibo</div></div>
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Interacción trend: ¿Quién paga qué?" onclick="openGalleryZoom(this)" style="background:#000;"><source src="/VIDEO PARA PORTAFOLIO 2.webm" type="video/webm" /></video><div class="media-caption">Trend de interacción</div></div>
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Isla del encanto." onclick="openGalleryZoom(this)" style="background:#000;"><source src="/ISLA-DEL-ENCATO-PORTAFOLIO-.webm" type="video/webm" /></video><div class="media-caption">Isla del encanto</div></div>
            <div class="media-card bento-horizontal"><img src="/metricas.png" alt="Métricas YP Realty" class="horizontal-img w-full-img" data-caption="Análisis de Métricas Reales" onclick="openGalleryZoom(this)" onerror="this.style.display='none'"><div class="media-caption">Métricas oficiales de interacción (+604.5%)</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 2: LANDING PAGES FREELANCE -->
  <div id="modal-freelance" class="modal-overlay" onclick="closeModalOutside(event, 'modal-freelance')">
    <div class="modal-window">
      <div class="modal-mac-bar">
        <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
        <div class="modal-search-bar">freelance.landingpages.dev</div>
        <button class="close-btn-text" onclick="closeModal('modal-freelance')">Cerrar</button>
      </div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada freelance.png" alt="Freelance Banner" onerror="this.src='/landingpage plataforma.png'" /></div>
        <div class="modal-title-row">
          <div class="title-text-group">
            <span class="project-counter">Caso 02 / 06</span>
            <h2>Landing Pages — Proyectos Freelance</h2>
          </div>
        </div>

        <div class="structured-brief">
          <div class="brief-item"><strong>Contexto:</strong> Clientes y profesionales independientes que requerían presencia digital de alto impacto y conversión.</div>
          <div class="brief-item"><strong>Objetivo:</strong> Diseñar y maquetar sitios web responsive optimizados para comunicar autoridad profesional.</div>
