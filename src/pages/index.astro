  /* ==========================================================
     LIQUID GLASS — Apple-inspired, sin perder la identidad
  ========================================================== */
  :root {
    --liquid-surface: rgba(255,255,255,.22);
    --liquid-surface-strong: rgba(255,255,255,.34);
    --liquid-border: rgba(255,255,255,.62);
    --liquid-highlight: rgba(255,255,255,.92);
    --liquid-shadow: 0 18px 48px rgba(15,23,42,.14), 0 3px 12px rgba(15,23,42,.07);
  }

  .glass-profile-card,
  .glass-cases-card,
  .floating-dock,
  .lang-switch.dark-mode,
  .social-icon-btn,
  .simple-modal-link,
  .freelance-link,
  .submit-btn,
  .search-icon-wrapper {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    -webkit-backdrop-filter: blur(24px) saturate(185%);
    backdrop-filter: blur(24px) saturate(185%);
  }

  .glass-profile-card,
  .glass-cases-card,
  .floating-dock,
  .social-icon-btn,
  .simple-modal-link,
  .freelance-link,
  .search-icon-wrapper {
    background:
      radial-gradient(120% 100% at 8% 0%, rgba(255,255,255,.62) 0%, rgba(255,255,255,.18) 38%, transparent 70%),
      linear-gradient(145deg, rgba(255,255,255,.30), rgba(255,255,255,.12));
    border: 1px solid var(--liquid-border);
    box-shadow:
      inset 0 1px 0 var(--liquid-highlight),
      inset 0 -1px 0 rgba(255,255,255,.14),
      var(--liquid-shadow);
  }

  .glass-profile-card::before,
  .glass-cases-card::before,
  .floating-dock::before,
  .lang-switch.dark-mode::before,
  .social-icon-btn::before,
  .simple-modal-link::before,
  .freelance-link::before,
  .submit-btn::before,
  .search-icon-wrapper::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -45% -25%;
    pointer-events: none;
    background:
      radial-gradient(circle at 22% 25%, rgba(255,255,255,.58), transparent 28%),
      radial-gradient(circle at 78% 70%, rgba(186,230,253,.24), transparent 30%),
      radial-gradient(circle at 60% 20%, rgba(244,114,182,.10), transparent 24%);
    transform: translate3d(-10%, -4%, 0) rotate(-8deg);
    transition: transform .55s cubic-bezier(.16,1,.3,1), opacity .35s ease;
    opacity: .78;
  }

  .glass-profile-card::after,
  .glass-cases-card::after,
  .floating-dock::after,
  .social-icon-btn::after,
  .simple-modal-link::after,
  .freelance-link::after,
  .submit-btn::after {
    content: "";
    position: absolute;
    z-index: 2;
    pointer-events: none;
    inset: 1px;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.15);
    mask-image: linear-gradient(to bottom, #000 0 34%, transparent 72%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0 34%, transparent 72%);
  }

  .glass-profile-card:hover::before,
  .glass-cases-card:hover::before,
  .floating-dock:hover::before,
  .social-icon-btn:hover::before,
  .simple-modal-link:hover::before,
  .freelance-link:hover::before,
  .submit-btn:hover::before {
    transform: translate3d(8%, 4%, 0) rotate(7deg);
    opacity: 1;
  }

