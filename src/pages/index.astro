---
// Greydemar Serrano - Hero Replicado & Optimizado
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>Greydemar Serrano | Marketing & Project Manager</title>
  <meta name="title" content="Greydemar Serrano | Marketing & Project Manager">
  <meta name="description" content="Especialista en Growth Marketing, Creación de Contenido y Project Management.">

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='50' fill='%23FEF08A'/><text x='50%' y='62%' font-size='42' font-weight='900' font-family='sans-serif' fill='%230F172A' text-anchor='middle'>GS</text></svg>" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>

  <div class="hero-bg-wrapper">
    <div class="avila-overlay"></div>
  </div>

  <nav class="top-nav">
    <div class="nav-container">
      <div class="logo"><span class="logo-badge">GS</span> GREYDEMAR®</div>
      
      <div class="lang-switch">
        <button class="lang-btn active" onclick="setLanguage('es')">ES</button>
        <span class="lang-divider">|</span>
        <button class="lang-btn" onclick="setLanguage('en')">EN</button>
      </div>
    </div>
  </nav>

  <header class="hero-container">
    
    <div class="glass-profile-card" tabindex="0">
      <div class="card-min-header">
        <img src="/foto.png" alt="Greydemar Serrano" class="profile-thumb" />
        <div class="min-meta">
          <div class="status-line">
            <span class="green-dot"></span>
            <span class="status-text" data-es="En línea" data-en="Online">En línea</span>
          </div>
          <h2 class="min-name">GREYDEMAR SERRANO - MARKETING SPECIALIST</h2>
        </div>
      </div>
      
      <div class="card-expand-content">
        <p class="expand-bio" data-es="Estrategias de crecimiento orgánico, creación de contenido con conversión y liderazgo de proyectos de marketing digital." data-en="Organic growth strategies, conversion-focused content creation, and digital marketing project leadership.">
          Estrategias de crecimiento orgánico, creación de contenido con conversión y liderazgo de proyectos de marketing digital.
        </p>

        <p class="expand-skills">
          Ventas & CRM &bull; Growth Marketing &bull; Web Front-End
        </p>
      </div>
    </div>

    <div class="hero-center-text">
      <h1 data-es="ESTRATEGIA QUE HACE QUE LA GENTE REGRESE" data-en="STRATEGY THAT MAKES PEOPLE LOOK TWICE">
        ESTRATEGIA QUE HACE QUE LA GENTE REGRESE
      </h1>

      <span class="floating-pill pill-pink">Growth Marketing</span>
      <span class="floating-pill pill-green">Project Manager</span>
      <span class="floating-pill pill-yellow">Visual Content</span>
    </div>

    <div class="glass-cases-card" tabindex="0">
      <div class="cases-min-header">
        <span class="icon">📂</span>
        <span data-es="Casos Destacados" data-en="Featured Cases">Casos Destacados</span>
      </div>

      <div class="cases-expand-content">
        <ul class="quick-cases-list">
          <li>
            <a href="#projects">
              <strong>YP Realty</strong>
              <span>Growth +604%</span>
            </a>
          </li>
          <li>
            <a href="#projects">
              <strong>Editorial PanHouse</strong>
              <span>Comunicaciones & VIP</span>
            </a>
          </li>
          <li>
            <a href="#projects">
              <strong>Dislocal</strong>
              <span>Project Coordinator</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

  </header>

  <nav class="floating-dock">
    <ul class="dock-list">
      <li class="dock-item" data-tooltip="Sobre mí">
        <a href="#about" class="dock-link"><img src="/notas.webp" class="mac-icon" alt="Notas"></a>
      </li>
      <li class="dock-item" data-tooltip="Casos">
        <a href="#projects" class="dock-link"><img src="/foto.png" class="mac-icon" alt="Fotos"></a>
      </li>
      <li class="dock-item" data-tooltip="Servicios">
        <a href="#services" class="dock-link"><img src="/finder icon.png" class="mac-icon" alt="Finder"></a>
      </li>
      <li class="dock-item" data-tooltip="Contacto">
        <a href="mailto:greydemar@email.com" class="dock-link"><img src="/ICON MAIL.webp" class="mac-icon" alt="Mail"></a>
      </li>
    </ul>
  </nav>

  <script is:inline>
    function setLanguage(lang) {
      document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');

      document.querySelectorAll('[data-es]').forEach(el => {
        el.textContent = el.getAttribute(`data-${lang}`);
      });
    }
  </script>

</body>
</html>

<style is:global>
  :root {
    --navy-dark: #0f172a;
    --pastel-yellow: #fef08a;
    --pastel-pink: #fbcfe8;
    --pastel-green: #bbf7d0;
    --glass-bg: rgba(255, 255, 255, 0.45);
    --glass-border: rgba(255, 255, 255, 0.6);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    color: var(--navy-dark);
    overflow-x: hidden;
    position: relative;
    min-height: 100vh;
    padding-bottom: 120px;
    background-color: #f1f5f9;
  }

  /* FONDO DEL ÁVILA CLARO Y VISIBLE */
  .hero-bg-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: url('/image_bf09ce.jpg') no-repeat center center / cover;
    z-index: -2;
  }

  .avila-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.1);
  }

  /* NAVBAR SUPERIOR */
  .top-nav {
    padding: 24px 32px;
    position: relative;
    z-index: 100;
  }

  .nav-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo { font-weight: 900; font-size: 18px; letter-spacing: -0.02em; display: flex; align-items: center; gap: 8px; }
  .logo-badge { background: var(--pastel-yellow); padding: 4px 8px; border-radius: 50%; font-size: 12px; }

  /* SWITCH IDIOMA */
  .lang-switch {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 6px 16px;
    border-radius: 30px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--glass-border);
  }

  .lang-btn {
    background: none;
    border: none;
    font-weight: 700;
    font-size: 12px;
    color: #64748b;
    cursor: pointer;
  }

  .lang-btn.active { color: var(--navy-dark); font-weight: 900; }
  .lang-divider { color: #cbd5e1; font-size: 12px; }

  /* HERO CONTAINER */
  .hero-container {
    max-width: 1280px;
    margin: 40px auto 0;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 320px 1fr 240px;
    gap: 24px;
    align-items: center;
  }

  /* TARJETA GLASSMORPHISM IZQUIERDA */
  .glass-profile-card {
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--glass-border);
    border-radius: 28px;
    padding: 18px 20px;
    cursor: pointer;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .card-min-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .profile-thumb {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid white;
  }

  .status-line {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 2px;
  }

  .green-dot {
    width: 7px;
    height: 7px;
    background: #22c55e;
    border-radius: 50%;
  }

  .status-text {
    font-size: 11px;
    font-weight: 700;
    color: #1e293b;
  }

  .min-name {
    font-size: 12px;
    font-weight: 900;
    letter-spacing: -0.01em;
    color: var(--navy-dark);
  }

  /* EXPANDIBLE */
  .card-expand-content {
    max-height: 0;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .glass-profile-card:hover .card-expand-content,
  .glass-profile-card:focus .card-expand-content {
    max-height: 180px;
    opacity: 1;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .expand-bio {
    font-size: 12px;
    line-height: 1.5;
    color: #334155;
    margin-bottom: 10px;
  }

  .expand-skills {
    font-size: 11px;
    font-weight: 800;
    color: #0f172a;
  }

  /* TARJETA CASOS DERECHA */
  .glass-cases-card {
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 18px 20px;
    cursor: pointer;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .cases-min-header {
    font-size: 13px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cases-expand-content {
    max-height: 0;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .glass-cases-card:hover .cases-expand-content,
  .glass-cases-card:focus .cases-expand-content {
    max-height: 200px;
    opacity: 1;
    margin-top: 14px;
  }

  .quick-cases-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .quick-cases-list a { text-decoration: none; color: var(--navy-dark); display: flex; flex-direction: column; font-size: 12px; }
  .quick-cases-list strong { font-weight: 800; }
  .quick-cases-list span { font-size: 10px; color: #64748b; }

  /* TÍTULO CENTRAL AGRANDADO Y CENTRADO */
  .hero-center-text { 
    text-align: center; 
    position: relative; 
    padding: 10px 0; 
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-center-text h1 {
    font-size: 5.2rem;
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    text-align: center;
    margin: 0 auto;
    max-width: 850px;
    color: var(--navy-dark);
    text-shadow: 0 2px 10px rgba(255, 255, 255, 0.5);
  }

  .floating-pill {
    position: absolute;
    padding: 8px 18px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 800;
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    pointer-events: none;
  }

  .pill-pink { background: var(--pastel-pink); top: -10%; right: 0%; transform: rotate(4deg); }
  .pill-green { background: var(--pastel-green); top: 40%; left: -6%; transform: rotate(-6deg); }
  .pill-yellow { background: var(--pastel-yellow); bottom: -10%; right: 10%; transform: rotate(3deg); }

  /* DOCK FLOTANTE MACOS */
  .floating-dock {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    border: 1.5px solid rgba(226, 232, 240, 0.9);
    border-radius: 22px;
    padding: 5px 10px;
    z-index: 9999;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
  }

  .dock-list { display: flex; gap: 10px; list-style: none; margin: 0; padding: 0; align-items: center; }
  .dock-item { position: relative; display: flex; justify-content: center; }
  .dock-link { display: flex; align-items: center; }
  .mac-icon {
    width: 50px;
    height: 50px;
    object-fit: contain;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .dock-link:hover .mac-icon { transform: scale(1.2) translateY(-4px); }

  /* MÓVIL ADAPTATIVO */
  @media (max-width: 900px) {
    .hero-container { grid-template-columns: 1fr; gap: 20px; }
    .hero-center-text h1 { font-size: 2.8rem; }
    .floating-pill { display: none; }
    .mac-icon { width: 42px; height: 42px; }
  }
</style>
