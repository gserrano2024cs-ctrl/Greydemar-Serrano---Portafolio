---
// Greydemar Serrano - Hero Replicado
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>Greydemar Serrano | Marketing & Project Manager</title>
  <meta name="title" content="Greydemar Serrano | Marketing & Project Manager">
  <meta name="description" content="Especialista en Growth Marketing, Creación de Contenido y Project Management.">

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='50' fill='%23FEF08A'/><text x='50%' y='62%' font-size='42' font-weight='900' font-family='sans-serif' fill='%230F172A' text-anchor='middle'>GS</text></svg>" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>

  <div class="eyes-follower" id="eyes">👀</div>

  <div class="hero-bg-wrapper">
    <div class="avila-overlay"></div>
  </div>

  <nav class="top-nav">
    <div class="nav-container">
      <div class="logo"><span class="logo-badge">GS</span> GREYDEMAR®</div>
      
      <div class="lang-switch">
        <button class="lang-btn active" onclick="setLanguage('es')">ES</button>
        <span class="lang-divider">|</span>
        <button class="lang-btn" onclick="setLanguage('en')">EN</button>
      </div>
    </div>
  </nav>

  <header class="hero-container">
    
    <div class="interactive-card profile-card" tabindex="0">
      <div class="card-top-row">
        <span class="status-badge">
          <span class="status-dot"></span>
          <span data-es="Online" data-en="Online">Online</span>
        </span>
      </div>
      
      <div class="card-content-expand">
        <img src="/foto.png" alt="Greydemar Serrano" class="hero-avatar" />
        <h2 class="profile-name">Greydemar Serrano</h2>
        <p class="profile-role" data-es="Marketing Digital Specialist" data-en="Digital Marketing Specialist">
          Marketing Digital Specialist
        </p>

        <p class="profile-bio" data-es="Especializada en conectar estrategias de contenido, crecimiento orgánico y liderazgo de proyectos digitales." data-en="Specialized in connecting content strategies, organic growth, and digital project leadership.">
          Especializada en conectar estrategias de contenido, crecimiento orgánico y liderazgo de proyectos digitales.
        </p>

        <div class="profile-tags">
          <span class="tag-pill tag-pink">Ventas & CRM</span>
          <span class="tag-pill tag-green">Social Media Marketing</span>
          <span class="tag-pill tag-yellow">Web Front-End</span>
        </div>
      </div>
    </div>

    <div class="hero-center-text">
      <h1 data-es="ESTRATEGIA QUE HACE QUE LA GENTE REGRESE" data-en="STRATEGY THAT MAKES PEOPLE LOOK TWICE">
        ESTRATEGIA QUE HACE QUE LA GENTE REGRESE
      </h1>

      <span class="floating-pill pill-pink">Growth Marketing</span>
      <span class="floating-pill pill-green">Project Manager</span>
      <span class="floating-pill pill-yellow">Visual Content</span>
    </div>

    <div class="interactive-card cases-card" tabindex="0">
      <div class="card-top-row">
        <span class="cases-title-badge">
          <span class="icon">📂</span>
          <span data-es="Casos Destacados" data-en="Featured Cases">Casos Destacados</span>
        </span>
      </div>

      <div class="card-content-expand">
        <ul class="quick-cases-list">
          <li>
            <a href="#projects">
              <strong>YP Realty</strong>
              <span>Growth +604%</span>
            </a>
          </li>
          <li>
            <a href="#projects">
              <strong>Editorial PanHouse</strong>
              <span>Comunicaciones & VIP</span>
            </a>
          </li>
          <li>
            <a href="#projects">
              <strong>Dislocal</strong>
              <span>Project Coordinator</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

  </header>

  <nav class="floating-dock">
    <ul class="dock-list">
      <li class="dock-item" data-tooltip="Sobre mí">
        <a href="#about" class="dock-link"><img src="/notas.webp" class="mac-icon" alt="Notas"></a>
      </li>
      <li class="dock-item" data-tooltip="Casos">
        <a href="#projects" class="dock-link"><img src="/foto.png" class="mac-icon" alt="Fotos"></a>
      </li>
      <li class="dock-item" data-tooltip="Servicios">
        <a href="#services" class="dock-link"><img src="/finder icon.png" class="mac-icon" alt="Finder"></a>
      </li>
      <li class="dock-item" data-tooltip="Contacto">
        <a href="mailto:greydemar@email.com" class="dock-link"><img src="/ICON MAIL.webp" class="mac-icon" alt="Mail"></a>
      </li>
    </ul>
  </nav>

  <script is:inline>
    // OJITOS SEGIMIENTO DE MOUSE
    const eyes = document.getElementById('eyes');
    document.addEventListener('mousemove', (e) => {
      const x = e.clientX;
      const y = e.clientY;
      eyes.style.transform = `translate3d(${x - 15}px, ${y - 15}px, 0)`;
    });

    // CAMBIO DE IDIOMA EN / ES
    function setLanguage(lang) {
      document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');

      document.querySelectorAll('[data-es]').forEach(el => {
        el.textContent = el.getAttribute(`data-${lang}`);
      });
    }
  </script>

</body>
</html>

<style is:global>
  :root {
    --navy-dark: #0f172a;
    --pastel-yellow: #fef08a;
    --pastel-pink: #fbcfe8;
    --pastel-green: #bbf7d0;
    --border-glass: rgba(255, 255, 255, 0.4);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    color: var(--navy-dark);
    overflow-x: hidden;
    position: relative;
    min-height: 100vh;
    padding-bottom: 120px;
  }

  /* OJITOS QUE SIGUEN EL CURSOR */
  .eyes-follower {
    position: fixed;
    top: 0;
    left: 0;
    font-size: 26px;
    pointer-events: none;
    z-index: 9999;
    transition: transform 0.08s ease-out;
  }

  /* FONDO DEL ÁVILA CON ACABADO GLASS */
  .hero-bg-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: url('/image_bf09ce.jpg') no-repeat center center/cover;
    z-index: -2;
  }
  .avila-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(6px);
  }

  /* NAVBAR SUPERIOR */
  .top-nav {
    padding: 24px 32px;
    position: relative;
    z-index: 100;
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo { font-weight: 900; font-size: 18px; letter-spacing: -0.02em; display: flex; align-items: center; gap: 8px; }
  .logo-badge { background: var(--pastel-yellow); padding: 4px 8px; border-radius: 50%; font-size: 12px; }

  /* SWITCH DE IDIOMA MINIMALISTA */
  .lang-switch {
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(12px);
    padding: 6px 16px;
    border-radius: 30px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border-glass);
  }
  .lang-btn {
    background: none;
    border: none;
    font-weight: 700;
    font-size: 12px;
    color: #64748b;
    cursor: pointer;
    transition: color 0.2s;
  }
  .lang-btn.active { color: var(--navy-dark); font-weight: 900; }
  .lang-divider { color: #cbd5e1; font-size: 12px; }

  /* HERO LAYOUT DE 3 COLUMNAS */
  .hero-container {
    max-width: 1200px;
    margin: 30px auto 0;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 300px 1fr 240px;
    gap: 20px;
    align-items: start;
  }

  /* TARJETAS INTERACTIVAS DESPLEGABLES */
  .interactive-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-glass);
    border-radius: 24px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 15px 35px rgba(0,0,0,0.06);
    overflow: hidden;
  }

  .card-top-row { display: flex; align-items: center; justify-content: space-between; }
  .status-badge { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 800; background: rgba(34,197,94,0.15); color: #15803d; padding: 4px 12px; border-radius: 20px; }
  .status-dot { width: 8px; height: 8px; background: #22c55e; border-radius: 50%; }

  .cases-title-badge { font-size: 13px; font-weight: 800; display: flex; align-items: center; gap: 6px; }

  /* CONTENIDO DESPLEGABLE CON HOVER O CLICK */
  .card-content-expand {
    max-height: 0;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 0;
  }

  .interactive-card:hover .card-content-expand,
  .interactive-card:focus .card-content-expand {
    max-height: 380px;
    opacity: 1;
    margin-top: 16px;
  }

  .hero-avatar { width: 70px; height: 70px; border-radius: 50%; object-fit: cover; margin-bottom: 12px; border: 2px solid white; }
  .profile-name { font-size: 16px; font-weight: 900; }
  .profile-role { font-size: 12px; font-weight: 700; color: #64748b; margin-bottom: 8px; }
  .profile-bio { font-size: 12px; color: #334155; line-height: 1.5; margin-bottom: 14px; }
  
  /* ETIQUETAS PASTEL */
  .profile-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .tag-pill { font-size: 11px; font-weight: 800; padding: 6px 12px; border-radius: 20px; }
  .tag-pink { background: var(--pastel-pink); color: #831843; }
  .tag-green { background: var(--pastel-green); color: #14532d; }
  .tag-yellow { background: var(--pastel-yellow); color: #713f
