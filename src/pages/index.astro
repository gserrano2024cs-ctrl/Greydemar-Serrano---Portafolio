    <div class="hidden-eyes-container" title="Lucas 24:31">
      <div style="display: flex; flex-direction: column; align-items: center;">
        <svg width="60" height="25" viewBox="0 0 100 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g class="blinking-eyes">
            <path d="M15,10 L10,0 M25,8 L25,-2 M35,10 L40,0" stroke="#ffffff" stroke-width="1.5"/>
            <path d="M10,20 Q25,5 40,20 Q25,35 10,20 Z" stroke="#ffffff" stroke-width="2.5" fill="none"/>
            <circle cx="25" cy="20" r="4.5" fill="#ffffff"/>
            <path d="M65,10 L60,0 M75,8 L75,-2 M85,10 L90,0" stroke="#ffffff" stroke-width="1.5"/>
            <path d="M60,20 Q75,5 90,20 Q75,35 60,20 Z" stroke="#ffffff" stroke-width="2.5" fill="none"/>
            <circle cx="75" cy="20" r="4.5" fill="#ffffff"/>
          </g>
        </svg>
        <span style="font-size: 9px; letter-spacing: 2px; color: #ffffff; margin-top: 6px; font-weight: 700;">LUCAS 24, 25-33</span>
      </div>
    </div>
    <p data-es="© 2026 Greydemar Serrano. Todos los derechos reservados." data-en="© 2026 Greydemar Serrano. All rights reserved.">© 2026 Greydemar Serrano. Todos los derechos reservados.</p>
  </footer>

  <!-- DOCK FLOTANTE -->
  <nav class="floating-dock">
    <ul class="dock-list">
      <li class="dock-item" data-tooltip="Servicios" data-tooltip-es="Servicios" data-tooltip-en="Services"><a href="#services" class="dock-link"><img src="/finder icon.png" class="mac-icon" alt="Finder"></a></li>
      <li class="dock-item" data-tooltip="Casos" data-tooltip-es="Casos" data-tooltip-en="Cases"><a href="#projects" class="dock-link"><img src="/foto.png" class="mac-icon" alt="Fotos"></a></li>
      <li class="dock-item" data-tooltip="Sobre mí" data-tooltip-es="Sobre mí" data-tooltip-en="About Me"><a href="#about" class="dock-link"><img src="/notas.webp" class="mac-icon" alt="Notas"></a></li>
      <li class="dock-item" data-tooltip="Contacto" data-tooltip-es="Contacto" data-tooltip-en="Contact"><a href="#contact" class="dock-link"><img src="/ICON MAIL.webp" class="mac-icon" alt="Mail"></a></li>
    </ul>
  </nav>

  <!-- ========================================== -->
  <!-- MODALES DE PROYECTOS                       -->
  <!-- ========================================== -->
  
  <div id="modal-yprealty" class="modal-overlay" onclick="closeModalOutside(event, 'modal-yprealty')">
    <div class="modal-window">
      <div class="modal-mac-bar">
        <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
        <div class="modal-search-bar">yprealty.com</div>
        <button class="close-btn-text" onclick="closeModal('modal-yprealty')" data-es="Cerrar" data-en="Close">Cerrar</button>
      </div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada-yprealty.png" alt="YP Realty Banner" style="object-position: top center;" /></div>
        <div class="modal-title-row">
          <div class="title-text-group">
            <span class="project-counter" data-es="Proyecto 01 / 06" data-en="Project 01 / 06">Proyecto 01 / 06</span>
            <h2>YP Realty</h2>
          </div>
        </div>
        <p class="modal-description" data-es="Lidero la estrategia de contenido y edición de video orgánico para el sector inmobiliario en Puerto Rico. Produzco formatos de alto impacto, redacto guiones persuasivos y aplico SEO para maximizar la conversión." data-en="I lead the content strategy and organic video editing for the real estate sector in Puerto Rico. I produce high-impact formats, write persuasive scripts, and apply SEO to maximize conversion.">Lidero la estrategia de contenido y edición de video orgánico para el sector inmobiliario en Puerto Rico. Produzco formatos de alto impacto, redacto guiones persuasivos y aplico SEO para maximizar la conversión.</p>
        <div class="metadata-grid">
          <div><span class="meta-label" data-es="Rol" data-en="Role">Rol</span><span class="meta-val">Social Media Mgr. & Video Editor</span></div>
          <div><span class="meta-label" data-es="Herramientas" data-en="Tools">Herramientas</span><span class="meta-val">GA4, TikTok Analytics, YouTube Analytics, ROAS, CPA, CPM, CTR, CPC</span></div>
          <div><span class="meta-label" data-es="Inicio" data-en="Start">Inicio</span><span class="meta-val">2026</span></div>
        </div>
        <div class="modal-gallery-container">
          <h3 data-es="Galería del Proyecto" data-en="Project Gallery">Galería del Proyecto</h3>
          <div class="bento-collage">
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Cisterna de agua en PR." onclick="openGalleryZoom(this)" style="background:#000;"><source src="/VIDEO PARA PORTAFOLIO.webm" type="video/webm" /></video><div class="media-caption">Cisterna de agua en PR.</div></div>
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Cierre de venta en Arecibo, Puerto Rico." onclick="openGalleryZoom(this)" style="background:#000;"><source src="/PARA-PORTAFOLIO.webm" type="video/webm" /></video><div class="media-caption">Cierre de venta en Arecibo, Puerto Rico.</div></div>
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Interacción con el público trend, quién paga qué en temas de arrendamientos." onclick="openGalleryZoom(this)" style="background:#000;"><source src="/VIDEO PARA PORTAFOLIO 2.webm" type="video/webm" /></video><div class="media-caption">Interacción trend: ¿Quién paga qué?</div></div>
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Isla del encanto." onclick="openGalleryZoom(this)" style="background:#000;"><source src="/ISLA-DEL-ENCATO-PORTAFOLIO-.webm" type="video/webm" /></video><div class="media-caption">Isla del encanto.</div></div>
            <div class="media-card bento-horizontal"><img src="/metricas.png" alt="Métricas YP Realty" class="horizontal-img w-full-img" data-caption="Análisis de Métricas" onclick="openGalleryZoom(this)" onerror="this.style.display='none'"><div class="media-caption">Análisis de Métricas</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="modal-panhouse" class="modal-overlay" onclick="closeModalOutside(event, 'modal-panhouse')">
