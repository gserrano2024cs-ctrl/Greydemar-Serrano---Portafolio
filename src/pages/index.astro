  <script is:inline>
    // Idioma con Traducción Total
    function setLanguage(lang) {
      document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');
      
      document.querySelectorAll('[data-es]').forEach(el => { 
        el.innerHTML = el.getAttribute(`data-${lang}`); 
      });
      
      document.querySelectorAll('[data-tooltip-es]').forEach(el => { 
        el.setAttribute('data-tooltip', el.getAttribute(`data-tooltip-${lang}`)); 
      });
      
      const msgArea = document.getElementById('wa-message');
      if(msgArea) { 
        msgArea.placeholder = lang === 'es' ? msgArea.getAttribute('data-es-placeholder') : "Hi Grey, I'd like to work on..."; 
      }
    }

    // Funciones Modales
    function openModal(modalId) { 
      const modal = document.getElementById(modalId);
      modal.classList.add('active'); 
      document.body.style.overflow = 'hidden'; 
    }
    function closeModal(modalId) { 
      const modal = document.getElementById(modalId);
      modal.classList.remove('active'); 
      document.body.style.overflow = 'auto'; 
    }
    function closeModalOutside(event, modalId) { if (event.target.id === modalId) { closeModal(modalId); } }

    // Click en la foto de perfil para ampliar
    function toggleProfileZoom(event) {
        event.stopPropagation();
        event.target.classList.toggle('zoomed');
    }
    
    // Cerrar imagen ampliada al hacer clic afuera
    document.addEventListener('click', function(event) {
        const profileImg = document.getElementById('heroProfileImg');
        if (profileImg && profileImg.classList.contains('zoomed') && event.target !== profileImg) {
            profileImg.classList.remove('zoomed');
        }
    });

    // Enviar WhatsApp
    function sendToWhatsApp(event) {
      event.preventDefault();
      const acceptCheckbox = document.getElementById('privacy-accept');
      if(!acceptCheckbox.checked) {
          alert("Debes aceptar la política de privacidad para enviar el mensaje.");
          return;
      }
      const name = document.getElementById('wa-name').value;
      const email = document.getElementById('wa-email').value;
      const message = document.getElementById('wa-message').value;
      const phone = "584126339776";
      const text = `¡Hola Grey! Soy ${name} (${email}).%0A%0A${message}`;
      window.open(`https://wa.me/${phone}?text=${text}`, '_blank');
    }

    // Animaciones de Scroll al Cargar
    document.addEventListener("DOMContentLoaded", () => {
      document.body.classList.add('loaded');
    });
  </script>

</body>
