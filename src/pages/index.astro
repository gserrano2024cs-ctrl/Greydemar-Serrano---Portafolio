    background: linear-gradient(135deg, var(--lg-tint-top), var(--lg-tint-bottom));
    -webkit-backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate)) brightness(var(--lg-brightness));
    backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate)) brightness(var(--lg-brightness));
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow:
      var(--lg-shadow),
      inset 0 1px 0 rgba(255, 255, 255, 0.65),    /* luz superior */
      inset 0 -1px 0 rgba(255, 255, 255, 0.14),   /* rebote inferior */
      inset 1px 0 0 rgba(255, 255, 255, 0.28),
      inset 0 0 24px rgba(255, 255, 255, 0.10);   /* volumen interno */
