<style is:global>
  :root {
    --navy-dark: #0f172a; --pastel-yellow: #fef08a; --pastel-pink: #fbcfe8; --pastel-green: #bbf7d0;
    --glass-bg: rgba(255, 255, 255, 0.4); --glass-border: rgba(255, 255, 255, 0.6); --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.08);
    --text-muted: #475569; --bg-soft: rgba(255, 255, 255, 0.7); --border-color: rgba(0, 0, 0, 0.1);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-ios: cubic-bezier(0.32, 0.72, 0, 1);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  /* SMOOTH SCROLL GLOBAL (debe ir en html, no en body) */
  html { scroll-behavior: smooth; scroll-padding-top: 24px; }
  body { font-family: 'Plus Jakarta Sans', sans-serif; color: var(--navy-dark); overflow-x: hidden; position: relative; }

  a:focus-visible, button:focus-visible, [role="button"]:focus-visible { outline: 2px solid #3b82f6; outline-offset: 3px; }

  /* ---------- CARGA DEL HERO ---------- */
  .js .fade-in-section { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease, transform 0.8s var(--ease-out); }
  .js body.loaded .fade-in-section { opacity: 1; transform: translateY(0); }

  /* ---------- ENTRADA AL HACER SCROLL ---------- */
  .js .reveal { opacity: 0; }
  .js .reveal.in-view { opacity: 1; animation: reveal-up 0.85s var(--ease-out) backwards; animation-delay: calc(var(--d, 0) * 90ms); }
  @keyframes reveal-up { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .js .reveal { opacity: 1; }
    .js .reveal.in-view { animation: none; }
    .js .fade-in-section { transition: none; }
    .marquee-track, .steam, .blinking-eyes, .iridescent-text, .green-dot { animation: none; }
  }

  .global-fixed-bg { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: #f8fafc; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E"); z-index: -999; }
  .sticker { position: absolute; opacity: 0.7; }
  .sticker-star { top: 12%; right: 15%; transform: rotate(15deg); }
  .sticker-plant { bottom: 20%; left: 8%; transform: rotate(-10deg); opacity: 0.6; }
  .sticker-sparkle { top: 40%; right: 5%; transform: rotate(5deg); }

  /* ---------- ZOOM ---------- */
  .zoom-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.92); z-index: 999999; display: flex; flex-direction: column; justify-content: center; align-items: center; opacity: 0; visibility: hidden; transition: all 0.3s ease; padding: 20px; backdrop-filter: blur(5px); }
  .zoom-overlay.active { opacity: 1; visibility: visible; }
  .zoom-content-wrapper { position: relative; display: flex; flex-direction: column; align-items: center; max-width: 90vw; }
  .zoom-media { max-width: 100%; max-height: 75vh; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); object-fit: contain; }
  .zoom-caption { color: #ffffff; margin-top: 16px; font-size: 1.15rem; font-weight: 600; text-align: center; max-width: 600px; text-shadow: 0 2px 4px rgba(0,0,0,0.8); }
  .zoom-close { position: absolute; top: 25px; right: 35px; background: rgba(255,255,255,0.15); border: none; color: white; width: 44px; height: 44px; border-radius: 50%; font-size: 22px; cursor: pointer; transition: background 0.3s; z-index: 9999999; display: flex; align-items: center; justify-content: center; }
  .zoom-close:hover { background: rgba(255,255,255,0.35); }

  /* ---------- HERO ---------- */
  .hero-wrapper { position: relative; width: 100%; min-height: 100vh; overflow: hidden; z-index: 10; background: #000; }
  .hero-video-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; }
  .video-bg { width: 100%; height: 100%; object-fit: cover; opacity: 0.8; }
  .avila-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.35); }
  .top-header { position: relative; width: 100%; max-width: 1300px; margin: 0 auto; padding: 24px 32px; display: flex; justify-content: flex-end; align-items: center; z-index: 10; }
  .brand-centered { position: absolute; top: 38px; left: 50%; transform: translateX(-50%); font-weight: 900; font-size: 20px; letter-spacing: -0.02em; color: #ffffff; text-shadow: 0 2px 10px rgba(0,0,0,0.4); white-space: nowrap; }

  .lang-switch.dark-mode { background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); padding: 4px; border-radius: 30px; display: flex; align-items: center; gap: 4px; border: 1px solid rgba(255,255,255,0.1); }
  .lang-btn { background: transparent; border: none; font-weight: 700; font-size: 12px; color: rgba(255,255,255,0.6); cursor: pointer; padding: 6px 12px; border-radius: 20px; transition: all 0.3s ease; }
  .lang-btn.active { background: rgba(255,255,255,0.15); color: #ffffff; font-weight: 900; }

  /* Grid: la columna izquierda se estira para que la frase quede abajo sin superponerse al card */
  .hero-container { max-width: 1300px; width: 100%; margin: 0 auto; padding: 20px 32px 110px; display: grid; grid-template-columns: 320px 1fr 260px; gap: 24px; align-items: stretch; min-height: calc(100vh - 100px); position: relative; z-index: 10; }
  .left-col { display: flex; flex-direction: column; justify-content: space-between; gap: 32px; }

  /* ---------- LIQUID GLASS (estilo iOS "Clear") ---------- */
  .liquid-glass {
    position: relative; isolation: isolate;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.20) 0%, rgba(255,255,255,0.05) 42%, rgba(255,255,255,0.12) 100%),
      rgba(10, 16, 30, 0.40);
    -webkit-backdrop-filter: blur(16px) saturate(180%) brightness(1.08);
    backdrop-filter: blur(16px) saturate(180%) brightness(1.08);
    border: 1px solid rgba(255,255,255,0.22);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.55),
      inset 0 -1px 0 rgba(255,255,255,0.10),
      inset 1px 0 0 rgba(255,255,255,0.14),
      inset 0 0 26px rgba(255,255,255,0.08),
      0 12px 32px rgba(0,0,0,0.30),
      0 2px 6px rgba(0,0,0,0.18);
    color: #ffffff;
    transition: transform 0.5s var(--ease-ios), box-shadow 0.5s var(--ease-ios), background 0.5s ease;
  }
  /* Reflejo especular en el borde */
  .liquid-glass::before { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1px; z-index: -1; pointer-events: none;
    background: linear-gradient(145deg, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0) 28%, rgba(255,255,255,0) 68%, rgba(255,255,255,0.45) 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude; }
  /* Brillo superior curvo */
  .liquid-glass::after { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 55%; border-radius: inherit; z-index: -1; pointer-events: none;
    background: radial-gradient(120% 100% at 15% 0%, rgba(255,255,255,0.22), rgba(255,255,255,0) 65%); }
  .liquid-glass:hover { transform: translateY(-2px); box-shadow: inset 0 1px 0 rgba(255,255,255,0.65), inset 0 -1px 0 rgba(255,255,255,0.14), inset 1px 0 0 rgba(255,255,255,0.18), inset 0 0 30px rgba(255,255,255,0.10), 0 18px 40px rgba(0,0,0,0.34), 0 2px 8px rgba(0,0,0,0.2); }

  /* Card perfil */
  .glass-profile-card { border-radius: 26px; padding: 16px 20px; cursor: pointer; overflow: hidden; }
  .card-min-header { display: flex; align-items: center; gap: 14px; flex-direction: row; }
  .shift-right { margin-left: 6px; }
  .profile-thumb { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255, 255, 255, 0.9); transition: width 0.5s var(--ease-ios), height 0.5s var(--ease-ios), margin 0.5s var(--ease-ios), box-shadow 0.4s ease; flex-shrink: 0; cursor: zoom-in; }
  .glass-profile-card.active .profile-thumb { width: 72px; height: 72px; border-width: 3px; box-shadow: 0 4px 14px rgba(0,0,0,0.3); margin-left: 0; }

  .min-meta { display: flex; flex-direction: column; justify-content: center; min-width: 0; }
  .status-line { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
  @keyframes blink-green { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }
  .green-dot { width: 8px; height: 8px; background: #22c55e; border-radius: 50%; animation: blink-green 2.5s infinite; box-shadow: 0 0 8px rgba(34,197,94,0.8); }
  .status-text { font-size: 11px; font-weight: 700; color: #ffffff; text-shadow: 0 1px 2px rgba(0,0,0,0.35); }
  .name-group { display: flex; flex-direction: column; gap: 2px; }
  .min-name { font-size: 15px; font-weight: 900; letter-spacing: -0.01em; line-height: 1.1; color: #ffffff; text-shadow: 0 1px 3px rgba(0,0,0,0.4); }
  .min-title { font-size: 11.5px; font-weight: 700; color: rgba(255,255,255,0.88); text-shadow: 0 1px 2px rgba(0,0,0,0.35); }

  .card-chevron { margin-left: auto; flex-shrink: 0; color: rgba(255,255,255,0.85); transition: transform 0.5s var(--ease-ios); }
  .glass-profile-card.active .card-chevron { transform: rotate(180deg); }

  /* Despliegue: anima la altura real (0fr → 1fr), sin saltos ni max-height arbitrarios */
  .card-expand { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 0.6s var(--ease-ios), opacity 0.4s ease; }
  .card-expand-inner { overflow: hidden; min-height: 0; }
  .card-expand-body { margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255, 255, 255, 0.25); }
  .active > .card-expand { grid-template-rows: 1fr; opacity: 1; transition-delay: 0s, 0.1s; }

  .expand-bio { font-size: 14.5px; font-weight: 500; line-height: 1.55; margin-bottom: 16px; color: rgba(255,255,255,0.95); text-shadow: 0 1px 2px rgba(0,0,0,0.3); }
  .expand-bio strong { font-weight: 900; color: #ffffff; }

  .skills-title { font-size: 11px; font-weight: 800; color: #ffffff; text-transform: uppercase; margin-bottom: 8px; opacity: 0.9; }
  .skills-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .skills-grid span { font-size: 10.5px; font-weight: 800; color: #ffffff; background: rgba(255, 255, 255, 0.16); border: 1px solid rgba(255,255,255,0.22); padding: 8px 10px; border-radius: 8px; text-align: center; white-space: nowrap; }
  .skills-grid .wide-skill { grid-column: span 2; }

  /* Frase del fondo del hero */
  .hero-quote-corner { max-width: 320px; }
  .hero-quote-corner span { font-size: 17px; font-weight: 800; letter-spacing: -0.02em; color: #ffffff; text-shadow: 0 2px 14px rgba(0,0,0,0.8); line-height: 1.4; display: block; }

  .hero-center-text { text-align: center; position: relative; display: flex; justify-content: center; align-items: center; align-self: center; }
  .hero-center-text h1 { font-size: 5.5rem; font-weight: 900; line-height: 0.98; letter-spacing: -0.04em; text-transform: uppercase; margin: 0 auto; max-width: 900px; color: #ffffff; text-shadow: 0 8px 30px rgba(0,0,0,0.3); }
  .floating-pill { position: absolute; padding: 6px 14px; border-radius: 30px; font-size: 12px; font-weight: 800; white-space: nowrap; color: var(--navy-dark); pointer-events: none; }
  .pill-pink { background: var(--pastel-pink); top: -25px; right: 15px; transform: rotate(3deg); }
  .pill-green { background: var(--pastel-green); bottom: -30px; left: 10%; transform: rotate(-6deg); }
  .pill-yellow { background: var(--pastel-yellow); bottom: -25px; right: 40px; transform: rotate(2deg); }

  /* Card áreas */
  .glass-cases-card { align-self: start; border-radius: 22px; padding: 14px 18px; cursor: pointer; overflow: hidden; }
  .cases-min-header { display: flex; align-items: center; justify-content: space-between; }
  .cases-title-text { font-size: 14px; font-weight: 800; color: #ffffff; text-shadow: 0 1px 2px rgba(0,0,0,0.35); }
  .search-icon-wrapper { background: rgba(255, 255, 255, 0.18); border-radius: 50%; padding: 6px; display: flex; color: #ffffff; }
  .glass-cases-card .card-expand-body { margin-top: 14px; padding-top: 0; border-top: none; }
  .quick-cases-list { list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .quick-cases-list a { text-decoration: none; display: flex; flex-direction: column; font-size: 13.5px; transition: transform 0.3s var(--ease-ios); }
  .quick-cases-list a:hover { transform: translateX(4px); }
  .quick-cases-list strong { font-weight: 800; color: #ffffff; text-shadow: 0 1px 2px rgba(0,0,0,0.35); }
  .quick-cases-list span { font-size: 11.5px; color: rgba(255,255,255,0.82); margin-top: 2px; }

  /* ---------- MARQUEE ---------- */
  .marquee-section { width: 100%; background: #ffffff; padding: 15px 0; border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); z-index: 5; position: relative; overflow: hidden; }
  .marquee-container { width: 100vw; max-width: 100%; overflow: hidden; display: flex; align-items: center; }
  .marquee-track { display: flex; gap: 60px; padding-right: 60px; width: max-content; animation: scroll-marquee 30s linear infinite; }
  .marquee-track img { height: 60px; width: auto; opacity: 0.4; filter: grayscale(100%); transition: all 0.3s ease; }
  .marquee-track img:hover { opacity: 1; filter: grayscale(0%); cursor: pointer; }
  @keyframes scroll-marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  /* ---------- SECCIONES ---------- */
  .about-section, .projects-section, .services-section, .contact-section { position: relative; width: 100%; padding: 80px 32px; z-index: 5; display: flex; justify-content: center; }
  .contact-section { padding-bottom: 160px; background-color: #ffffff; }
  .about-container, .projects-container, .services-container, .contact-container { max-width: 900px; width: 100%; display: flex; flex-direction: column; align-items: center; }
  .projects-container { max-width: 1200px; }

  .sticky-note { position: relative; background-color: var(--pastel-yellow); padding: 10px 18px 6px; border-radius: 6px; box-shadow: 2px 4px 10px rgba(0,0,0,0.05); transform: rotate(-3deg); margin-bottom: 24px; display: flex; align-items: center; justify-content: center; }
  .real-pin { position: absolute; top: -12px; width: 24px; height: 24px; filter: drop-shadow(0px 2px 2px rgba(0,0,0,0.2)); }
  .note-text { font-weight: 800; font-size: 13px; color: var(--navy-dark); text-transform: uppercase; letter-spacing: 0.05em; }
  .about-header, .section-header { text-align: center; margin-bottom: 40px; }
  .about-header h2, .section-header h2 { font-size: 3.5rem; font-weight: 900; line-height: 1.1; letter-spacing: -0.03em; color: var(--navy-dark); margin-bottom: 16px; }
  .about-subtitle, .section-header p { font-size: 1.4rem; line-height: 1.6; color: var(--text-muted); max-width: 800px; margin: 0 auto; font-weight: 500; }

  .mac-window { width: 100%; background: var(--bg-soft); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid var(--border-color); border-radius: 16px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06); overflow: hidden; }
  .mac-titlebar { background: rgba(241, 245, 249, 0.8); padding: 14px 20px; display: flex; align-items: center; border-bottom: 1px solid var(--border-color); }
  .mac-buttons { display: flex; gap: 8px; }
  .mac-dot { width: 12px; height: 12px; border-radius: 50%; }
  .mac-dot.red { background-color: #ff5f56; border: 1px solid #e0443e; }
  .mac-dot.yellow { background-color: #ffbd2e; border: 1px solid #dea123; }
  .mac-dot.green { background-color: #27c93f; border: 1px solid #1aab29; }

  .mac-content { display: grid; grid-template-columns: 280px 1fr; gap: 40px; padding: 40px; align-items: center; }
  .bio-image-col { display: flex; justify-content: center; }

  .animated-memoji { animation: slideUpFade 1.2s var(--ease-out) 0.5s forwards; opacity: 0; transform: translateY(40px); }
  @keyframes slideUpFade { to { opacity: 1; transform: translateY(0); } }

  .memoji-circle { width: 240px; height: 240px; border-radius: 50%; object-fit: cover; background-color: #fef08a; box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
  .bio-info-col { display: flex; flex-direction: column; gap: 30px; }
  .bio-intro { font-size: 1.2rem; line-height: 1.6; color: var(--navy-dark); }
  .bio-intro strong { font-weight: 800; }

  .stats-grid-about { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .iridescent-text { font-size: 2.5rem; font-weight: 900; margin-bottom: 4px; background: linear-gradient(90deg, #9b51e0, #ff7e5f, #00c6ff, #9b51e0); background-size: 300% 100%; animation: iridescence 5s ease infinite; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  @keyframes iridescence { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
  .stat-item p { font-size: 15px; font-weight: 600; color: var(--text-muted); line-height: 1.3; }

  /* ---------- PORTAFOLIO POR ÁREAS ---------- */
  .area-nav { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-bottom: 40px; }
  .area-nav a { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 30px; background: var(--bg-soft); border: 1px solid var(--border-color); text-decoration: none; color: var(--navy-dark); font-weight: 800; font-size: 14px; transition: background 0.3s ease, color 0.3s ease, transform 0.3s var(--ease-ios); }
  .area-nav a .num { font-family: monospace; font-size: 12px; opacity: 0.5; }
  .area-nav a:hover { background: var(--navy-dark); color: #ffffff; transform: translateY(-2px); }

  .area-window { max-width: 1200px; margin-bottom: 48px; backdrop-filter: none; -webkit-backdrop-filter: none; background: rgba(255,255,255,0.85); scroll-margin-top: 24px; }
  .area-window .mac-titlebar { justify-content: space-between; gap: 16px; }
  .window-label { background: white; padding: 6px 16px; border-radius: 20px; font-size: 12px; color: var(--text-muted); font-weight: 500; border: 1px solid var(--border-color); flex-grow: 1; max-width: 420px; text-align: center; }
  .area-index { font-family: monospace; font-size: 13px; font-weight: 800; color: var(--text-muted); opacity: 0.5; }
  .area-body { padding: 36px; }

  .area-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 22px; }
  .area-title { font-size: 2.2rem; font-weight: 900; letter-spacing: -0.03em; line-height: 1.1; color: var(--navy-dark); }
  .area-desc { font-size: 1.05rem; line-height: 1.6; color: var(--text-muted); font-weight: 500; max-width: 720px; margin-top: 10px; }
  .area-badge { padding: 8px 16px; border-radius: 30px; font-size: 12.5px; font-weight: 800; color: var(--navy-dark); white-space: nowrap; transform: rotate(2deg); }
  .badge-yellow { background: var(--pastel-yellow); }
  .badge-pink { background: var(--pastel-pink); }
  .badge-green { background: var(--pastel-green); }

  .area-tools { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .area-tools span { font-size: 12px; font-weight: 700; padding: 6px 12px; border-radius: 20px; background: rgba(241,245,249,0.9); border: 1px solid var(--border-color); color: var(--navy-dark); }

  .area-notes { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-bottom: 32px; }
  .area-notes li { padding: 16px 18px; border-radius: 14px; background: rgba(241, 245, 249, 0.6); border: 1px solid var(--border-color); }
  .note-company { display: block; font-size: 13px; font-weight: 900; color: var(--navy-dark); margin-bottom: 6px; }
  .area-notes p { font-size: 13.5px; line-height: 1.55; color: var(--text-muted); font-weight: 500; }

  /* Stack tecnológico */
  .stack-block { margin: 6px 0 28px; }
  .stack-title { font-size: 13px; font-weight: 800; color: var(--text-muted); margin-bottom: 12px; }
  .stack-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 12px; }
  .stack-item { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 18px 10px 14px; border-radius: 16px; background: rgba(255,255,255,0.8); border: 1px solid var(--border-color); font-size: 13px; font-weight: 700; text-align: center; color: var(--navy-dark); transition: transform 0.3s var(--ease-ios), box-shadow 0.3s ease; }
  .stack-item:hover { transform: translateY(-4px); box-shadow: 0 14px 26px rgba(15,23,42,0.08); }
  .stack-item svg { width: 38px; height: 38px; }

  /* Collage de media (masonry con columnas CSS) */
  .media-grid { column-count: 3; column-gap: 20px; }
  .media-card { break-inside: avoid; -webkit-column-break-inside: avoid; page-break-inside: avoid; margin: 0 0 20px; background: #f8fafc; border: 1px solid var(--border-color); border-radius: 16px; padding: 12px; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
  .media-card video, .media-card img { width: 100%; border-radius: 10px; object-fit: cover; cursor: zoom-in; transition: transform 0.3s ease; display: block; }
  .media-card video:hover, .media-card img:hover { transform: translateY(-2px); }

  .vertical-vid { aspect-ratio: 9/16; background: #000; }
  .horizontal-vid { aspect-ratio: 16/9; background: #000; }
  .horizontal-img.w-full-img { aspect-ratio: auto; height: auto; max-height: 500px; object-fit: contain; background: transparent; }

  .media-caption { font-size: 13.5px; line-height: 1.4; text-align: center; padding: 0 4px 4px; }
  .cap-title { font-weight: 800; color: var(--navy-dark); }
  .cap-sep { margin: 0 4px; opacity: 0.35; }
  .cap-company { font-weight: 600; color: var(--text-muted); white-space: nowrap; }

