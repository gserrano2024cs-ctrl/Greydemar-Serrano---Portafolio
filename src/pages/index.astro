          <div><span class="meta-label" data-es="Rol" data-en="Role">Rol</span><span class="meta-val" data-es="Coord. Comunicaciones Internas" data-en="Internal Comms Coordinator">Coord. Comunicaciones Internas</span></div>
          <div><span class="meta-label" data-es="Herramientas" data-en="Tools">Herramientas</span><span class="meta-val">Meta Business Suite, CRM, Email Marketing</span></div>
          <div><span class="meta-label" data-es="Inicio" data-en="Start">Inicio</span><span class="meta-val">2024</span></div>
        </div>
        <div class="modal-gallery-container">
          <h3 data-es="Galería del Proyecto" data-en="Project Gallery">Galería del Proyecto</h3>
          <div class="bento-collage">
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Cobertura de comunicación en PanHouse" onclick="openGalleryZoom(this)" style="background:#000;"><source src="/video panhouse.mp4" type="video/mp4" /></video><div class="media-caption">Cobertura de comunicaciones PanHouse</div></div>
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Feria Internacional del Libro en Guadalajara" onclick="openGalleryZoom(this)" style="background:#000;"><source src="/ph.mp4" type="video/mp4" /></video><div class="media-caption">Feria Internacional del Libro en Guadalajara</div></div>
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Despliegue logístico en Cerro Verde" onclick="openGalleryZoom(this)" style="background:#000;"><source src="/cerro verde ph.mp4" type="video/mp4" /></video><div class="media-caption">Despliegue logístico en Cerro Verde</div></div>
            <div class="media-card bento-horizontal"><img src="/evento ph.png" alt="Evento VIP Editorial PanHouse" class="horizontal-img w-full-img" data-caption="Ejecución de Evento VIP" onclick="openGalleryZoom(this)" onerror="this.style.display='none'" /><div class="media-caption">Ejecución de Evento VIP</div></div>
            <div class="media-card bento-horizontal"><img src="/manychat.png" alt="Automatización ManyChat" class="horizontal-img w-full-img" data-caption="Flujos de automatización de atención con IA (ManyChat)" onclick="openGalleryZoom(this)" onerror="this.style.display='none'" /><div class="media-caption">Automatización de atención con IA</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>

