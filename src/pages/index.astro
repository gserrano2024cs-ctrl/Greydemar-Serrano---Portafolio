          <div><span class="meta-label" data-es="Inicio" data-en="Start">Inicio</span><span class="meta-val">2026</span></div>
        </div>
        <div class="modal-gallery-container">
          <h3 data-es="Casos de Diseño Web" data-en="Web Design Cases">Casos de Diseño Web</h3>
          <div class="bento-collage">
            <div class="media-card bento-horizontal"><video playsinline loop muted autoplay class="horizontal-vid" data-caption="Diseño Web - Laura Navarro" onclick="openGalleryZoom(this)"><source src="/laura navarro.mp4" type="video/mp4" /></video><div class="media-caption">Diseño Web - Laura Navarro</div><a href="https://gserrano2024cs-ctrl.github.io/Dra.LauraNavarroActiveLearningEducationLeadership/" target="_blank" class="freelance-link" data-es="🌐 Ver sitio: Laura Navarro" data-en="🌐 View site: Laura Navarro">🌐 Ver sitio web</a></div>
