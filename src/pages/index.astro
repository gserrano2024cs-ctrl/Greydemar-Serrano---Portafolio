---
// Greydemar Serrano - Hero Interactivo 2026
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>Greydemar Serrano | Marketing & Project Manager</title>
  <meta name="title" content="Greydemar Serrano | Marketing & Project Manager">
  <meta name="description" content="Especialista en Growth Marketing, Creación de Contenido y Project Management.">

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='50' fill='%23FEF08A'/><text x='50%' y='62%' font-size='42' font-weight='900' font-family='sans-serif' fill='%230F172A' text-anchor='middle'>GS</text></svg>" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>

  <div class="eyes-follower" id="eyes">👀</div>

  <div class="hero-bg-wrapper">
    <div class="avila-overlay"></div>
  </div>

  <nav class="top-nav">
    <div class="nav-container">
      <div class="logo"><span class="logo-badge">GS</span> GREYDEMAR®</div>
      
      <div class="lang-switch">
        <button class="lang-btn active" onclick="setLanguage('es')">ES</button>
        <span class="lang-divider">|</span>
        <button class="lang-btn" onclick="setLanguage('en')">EN</button>
      </div>
    </div>
  </nav>

  <header class="hero-container">
    
    <div class="interactive-card profile-card" tabindex="0">
      <div class="card-min-header">
        <span class="status-dot"></span>
        <span class="status-text" data-es="Online" data-en="Online">Online</span>
      </div>
      
      <div class="card-content-expand">
        <img src="/foto.png" alt="Greydemar Serrano" class="hero-avatar" />
        <h2 class="profile-name">GREYDEMAR SERRANO</h2>
        <p class="profile-role" data-es="Marketing Digital Specialist & Project Manager" data-en="Digital Marketing Specialist & Project Manager">
          Marketing Digital Specialist & Project Manager
        </p>

        <p class="profile-bio" data-es="Conecto estrategia, creatividad y sistemas comerciales para escalar marcas con impacto." data-en="Connecting strategy, creativity, and sales systems to scale impactful brands.">
          Conecto estrategia, creatividad y sistemas comerciales para escalar marcas con impacto.
        </p>

        <div class="profile-tags">
          <span class="mini-tag">Growth</span>
          <span class="mini-tag">Social Media</span>
          <span class="mini-tag">Sales CRM</span>
        </div>
      </div>
    </div>

    <div class="hero-center-text">
      <h1 data-es="ESTRATEGIA QUE HACE QUE LA GENTE REGRESE" data-en="STRATEGY THAT MAKES PEOPLE LOOK TWICE">
        ESTRATEGIA QUE HACE QUE LA GENTE REGRESE
      </h1>

      <span class="pill-badge pill-pink">Ventas & CRM</span>
      <span class="pill-badge pill-green">Social Media Marketing</span>
      <span class="pill-badge pill-yellow">Web Front-End</span>
    </div>

    <div class="interactive-card cases-card" tabindex="0">
      <div class="card-min-header">
        <span class="cases-icon">📂</span>
        <span data-es="Casos Destacados" data-en="Featured Cases">Casos Destacados</span>
      </div>

      <div class="card-content-expand">
        <ul class="quick-cases-list">
          <li>
            <a href="#projects">
              <strong>YP Realty</strong>
              <span>Growth +604%</span>
            </a>
          </li>
          <li>
            <a href="#projects">
              <strong>PanHouse</strong>
              <span>Comunicaciones & VIP</span>
            </a>
          </li>
          <li>
            <a href="#projects">
              <strong>Dislocal</strong>
              <span>Project Coordinator</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

  </header>

  <script is:inline>
    // OJITOS QUE SIGUEN AL MOUSE
    const eyes = document.getElementById('eyes');
    document.addEventListener('mousemove', (e) => {
      const x = e.clientX;
      const y = e.clientY;
      eyes.style.transform = `translate3d(${x - 15}px, ${y - 15}px, 0)`;
    });

    // CAMBIO DE IDIOMA (ESPAÑOL / INGLÉS)
    function setLanguage(lang) {
      document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');

      document.querySelectorAll('[data-es]').forEach(el => {
        el.textContent = el.getAttribute(`data-${lang}`);
      });
    }
  </script>

</body>
</html>

<style is:global>
  :root {
    --bg-dark: #0f172a;
    --navy-text: #0f172a;
    --pastel-yellow: #fef08a;
    --pastel-pink: #fbcfe8;
    --pastel-green: #bbf7d0;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    background-color: #e2e8f0;
    color: var(--navy-text);
    overflow-x: hidden;
    position: relative;
    min-height: 100vh;
  }

  /* OJITOS QUE SIGUEN AL MOUSE */
  .eyes-follower {
    position: fixed;
    top: 0;
    left: 0;
    font-size: 26px;
    pointer-events: none;
    z-index: 9999;
    transition: transform 0.08s ease-out;
  }

  /* FONDO CON ÁVILA */
  .hero-bg-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: url('/avila.jpg') no-repeat center center/cover;
    z-index: -2;
  }
  .avila-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(8px);
  }

  /* NAVBAR */
  .top-nav {
    padding: 20px 32px;
    position: relative;
    z-index: 100;
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo { font-weight: 900; font-size: 18px; letter-spacing: -0.02em; display: flex; align-items: center; gap: 8px; }
  .logo-badge { background: var(--pastel-yellow); padding: 4px 8px; border-radius: 50%; font-size: 12px; }

  /* SWITCH IDIOMA */
  .lang-switch {
    background: rgba(255,255,255,0.8);
    backdrop-filter: blur(10px);
    padding: 6px 14px;
    border-radius: 30px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(0,0,0,0.08);
  }
  .lang-btn {
    background: none;
    border: none;
    font-weight: 700;
    font-size: 12px;
    color: #64748b;
    cursor: pointer;
    transition: color 0.2s;
  }
  .lang-btn.active { color: var(--navy-text); font-weight: 900; }
  .lang-divider { color: #cbd5e1; font-size: 12px; }

  /* HERO CONTAINER */
  .hero-container {
    max-width: 1200px;
    margin: 40px auto 0;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 280px 1fr 240px;
    gap: 20px;
    align-items: start;
    position: relative;
  }

  /* TARJETAS INTERACTIVAS DESPLEGABLES */
  .interactive-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    padding: 16px;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    overflow: hidden;
  }

  .card-min-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 800;
  }
  .status-dot { width: 8px; height: 8px; background: #22c55e; border-radius: 50%; display: inline-block; }

  /* CONTENIDO QUE SE DESPLIEGA AL HOVER O CLICK */
  .card-content-expand {
    max-height: 0;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 0;
  }

  .interactive-card:hover .card-content-expand,
  .interactive-card:focus .card-content-expand {
    max-height: 320px;
    opacity: 1;
    margin-top: 16px;
  }

  .hero-avatar { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; margin-bottom: 12px; }
  .profile-name { font-size: 14px; font-weight: 900; }
  .profile-role { font-size: 11px; font-weight: 700; color: #64748b; margin-bottom: 8px; }
  .profile-bio { font-size: 12px; color: #334155; line-height: 1.4; margin-bottom: 12px; }
  .profile-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .mini-tag { background: #f1f5f9; font-size: 10px; font-weight: 700; padding: 4px 8px; border-radius: 12px; }

  /* LISTA CASOS RÁPIDOS */
  .quick-cases-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .quick-cases-list a { text-decoration: none; color: var(--navy-text); display: flex; flex-direction: column; font-size: 12px; }
  .quick-cases-list strong { font-weight: 800; }
  .quick-cases-list span { font-size: 10px; color: #64748b; }

  /* TÍTULO CENTRAL IMPACTANTE TIPO CREATIE */
  .hero-center-text {
    text-align: center;
    position: relative;
    padding: 20px 0;
  }
  .hero-center-text h1 {
    font-size: 3.8rem;
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  /* PÍLDORAS FLOTANTES SOBRE TÍTULO */
  .pill-badge {
    position: absolute;
    padding: 6px 14px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 800;
    box-shadow: 0 10px 20px rgba(0,0,0,0.06);
    pointer-events: none;
  }
  .pill-pink { background: var(--pastel-pink); top: 10%; right: 10%; transform: rotate(4deg); }
  .pill-green { background: var(--pastel-green); top: 50%; left: -5%; transform: rotate(-6deg); }
  .pill-yellow { background: var(--pastel-yellow); bottom: 0; right: 20%; transform: rotate(2deg); }

  /* ADAPTACIÓN CELULAR */
  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .hero-center-text h1 { font-size: 2.4rem; }
    .pill-badge { display: none; }
  }
</style>
