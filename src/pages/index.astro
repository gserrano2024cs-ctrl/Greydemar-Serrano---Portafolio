---
// Configuración Astro
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>Greydemar Serrano | Ventas, Marketing & Web</title>
  <meta name="title" content="Greydemar Serrano | Ventas, Marketing & Web">
  <meta name="description" content="Convierto estrategia en ingresos medibles. Diseño landing pages que capturan leads, gestiono comunidades y automatizo procesos con IA.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

  <nav class="top-nav">
    <div class="nav-container">
      <div class="logo">
        <span class="logo-badge">G</span> Greydemar Serrano
      </div>
      <ul class="nav-links">
        <li><a href="#home" class="active">Inicio</a></li>
        <li><a href="#about">Sobre mí</a></li>
        <li><a href="#projects">Proyectos</a></li>
        <li><a href="#services">Servicios</a></li>
      </ul>
      <a href="#contact" class="btn-nav-contact">Contrátame</a>
    </div>
  </nav>

  <main class="main-layout" id="home">
    
    <section class="hero-grid">
      <div class="hero-content">
        <div class="greeting-badge">
          <span>👋 ¡Hola! Bienvenid@ a mi portafolio</span>
        </div>
        <h1 class="hero-heading">
          Transformo estrategias de <span class="highlight-text">Ventas & Marketing</span> con tecnología e <span class="highlight-text">IA</span>.
        </h1>
        <p class="hero-description">
          Ayudo a marcas y empresas a escalar sus ingresos mediante embudos de conversión, estrategias de adquisición digital, diseño web enfocado en UX y optimización de procesos comerciales.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn-navy">Explorar Casos ↗</a>
          <a href="#contact" class="btn-outline">Contacto Directo</a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="circle-bg"></div>
        <img src="/foto.png" alt="Greydemar Serrano" class="profile-photo" />
        
        <span class="floating-pill pill-1">Especialista en Ventas</span>
        <span class="floating-pill pill-2">Marketing & IA</span>
        <span class="floating-pill pill-3">Desarrollo Web</span>
      </div>
    </section>

  </main>

  <div class="marquee-section">
    <div class="marquee-track">
      <span>🚀 Estrategia de Marketing Digital ✦</span>
      <span>⚡ Ventas & Cierre B2B / B2C ✦</span>
      <span>🤖 Automatización con IA & Workflows ✦</span>
      <span>💻 Desarrollo Web & Landing Pages ✦</span>
      <span>📊 Growth Marketing & Analítica ✦</span>
      <span>✉️ Email Marketing & Nutrición ✦</span>
      <span>🚀 Estrategia de Marketing Digital ✦</span>
      <span>⚡ Ventas & Cierre B2B / B2C ✦</span>
      <span>🤖 Automatización con IA & Workflows ✦</span>
      <span>💻 Desarrollo Web & Landing Pages ✦</span>
      <span>📊 Growth Marketing & Analítica ✦</span>
      <span>✉️ Email Marketing & Nutrición ✦</span>
    </div>
  </div>

  <section class="projects-section" id="projects">
    <div class="section-header">
      <span class="sub-title">— PORTAFOLIO DE TRABAJO</span>
      <h2>Proyectos & <span class="highlight-text">Casos de Éxito</span></h2>
      <p>Haz clic en cualquier tarjeta para desplegar el caso completo con métricas y entregables.</p>
    </div>

    <div class="projects-grid">
      
      <article class="project-card" onclick="openModal('modal-1')">
        <div class="card-mac-header">
          <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
          <span class="card-tag">Growth & Web</span>
        </div>
        <div class="card-body">
          <img src="/foto.png" alt="Caso E-Commerce" class="card-img" />
          <h3>Especialista en Adquisición & Web</h3>
          <p class="card-company">Cliente: Agencia Digital | 2023 - 2024</p>
        </div>
      </article>

      <article class="project-card" onclick="openModal('modal-2')">
        <div class="card-mac-header">
          <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
          <span class="card-tag">Ventas & IA</span>
        </div>
        <div class="card-body">
          <img src="/foto.png" alt="Caso CRM" class="card-img" />
          <h3>Líder de Estrategia Comercial & CRM</h3>
          <p class="card-company">Cliente: Empresa B2B | 2023</p>
        </div>
      </article>

    </div>
  </section>

  <div id="modal-1" class="modal-overlay" onclick="closeModalOnOuter(event, 'modal-1')">
    <div class="modal-window">
      <div class="modal-mac-bar">
        <div class="mac-dots">
          <span class="dot red" onclick="closeModal('modal-1')"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="modal-search-bar">🔍 Portfolio / Case Study: Growth & Web</div>
        <button class="close-btn-text" onclick="closeModal('modal-1')">✕ Cerrar</button>
      </div>

      <div class="modal-content-scroll">
        <div class="modal-hero-banner">
          <img src="/foto.png" alt="Banner Caso" />
        </div>

        <div class="modal-header-info">
          <div class="modal-title-row">
            <h2>Especialista en Marketing Digital & Desarrollo Web</h2>
            <a href="https://linkedin.com" target="_blank" class="preview-link">Preview Link ↗</a>
          </div>

          <p class="modal-description">
            Diseño e implementación de sistema de adquisición digital automatizado. Optimización de la tasa de conversión (CRO) mediante landing pages de alta velocidad y secuencias de email marketing potenciadas con Inteligencia Artificial.
          </p>

          <div class="metadata-grid">
            <div class="meta-item">
              <span class="meta-label">Empresa / Cliente</span>
              <span class="meta-val">Agencia Growth Media</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Años / Período</span>
              <span class="meta-val">2023 - 2024 (1 Año, 6 Meses)</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Herramientas Utilizadas</span>
              <span class="meta-val">Astro, Meta Ads, HubSpot CRM, ChatGPT IA</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Impacto / Logro Clave</span>
              <span class="meta-val">+140% Conversión & +604% Alcance</span>
            </div>
          </div>
        </div>

        <div class="modal-gallery">
          <h3>Entregables & Muestras de Trabajo</h3>
          <div class="gallery-stack">
            <img src="/foto.png" alt="Muestra 1" />
            <img src="/foto.png" alt="Muestra 2" />
            <img src="/foto.png" alt="Muestra 3" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <nav class="floating-dock">
    <ul class="dock-list">
      <li class="dock-item" data-tooltip="Sobre mí">
        <a href="#about" class="dock-link">
          <img src="/notas.webp" class="mac-icon" alt="Notas">
        </a>
      </li>
      <li class="dock-item" data-tooltip="Proyectos">
        <a href="#projects" class="dock-link">
          <img src="/foto.png" class="mac-icon" alt="Fotos">
        </a>
      </li>
      <li class="dock-item" data-tooltip="Servicios">
        <a href="#services" class="dock-link">
          <img src="/finder icon.png" class="mac-icon" alt="Finder">
        </a>
      </li>
      <li class="dock-item" data-tooltip="Contacto">
        <a href="#contact" class="dock-link">
          <img src="/ICON MAIL.webp" class="mac-icon" alt="Mail">
        </a>
      </li>
    </ul>
  </nav>

  <script is:inline>
    function openModal(id) {
      const modal = document.getElementById(id);
      if(modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if(modal) {
        modal.classList.remove('active');
        document.body.style.overflow = 'auto';
      }
    }

    function closeModalOnOuter(event, id) {
      if (event.target.classList.contains('modal-overlay')) {
        closeModal(id);
      }
    }
  </script>

</body>
</html>

<style is:global>
  :root {
    --bg-white: #ffffff;
    --bg-soft: #f8fafc;
    --navy-dark: #0f172a;
    --navy-light: #1e293b;
    --text-muted: #64748b;
    --pastel-yellow: #fef08a;
    --yellow-accent: #fde047;
    --border-color: #e2e8f0;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    background-color: var(--bg-white);
    color: var(--navy-dark);
    padding-bottom: 110px;
    scroll-behavior: smooth;
  }

  /* NAVBAR SUPERIOR */
  .top-nav {
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    z-index: 100;
    padding: 16px 0;
    border-bottom: 1px solid var(--border-color);
  }
  .nav-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo { font-size: 18px; font-weight: 800; display: flex; align-items: center; gap: 8px; color: var(--navy-dark); }
  .logo-badge { background: var(--pastel-yellow); color: var(--navy-dark); width: 30px; height: 30px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; }
  .nav-links { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  .nav-links a { text-decoration: none; color: var(--text-muted); font-weight: 500; font-size: 14px; transition: color 0.2s; }
  .nav-links a:hover, .nav-links a.active { color: var(--navy-dark); font-weight: 700; }
  .btn-nav-contact { background: var(--navy-dark); color: white; padding: 10px 20px; border-radius: 50px; text-decoration: none; font-size: 13px; font-weight: 600; }

  /* HERO LAYOUT */
  .main-layout { max-width: 1140px; margin: 0 auto; padding: 50px 24px 60px; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: center; }
  .greeting-badge { display: inline-block; background: var(--pastel-yellow); padding: 6px 16px; border-radius: 30px; font-size: 13px; font-weight: 700; color: var(--navy-dark); margin-bottom: 18px; }
  .hero-heading { font-size: 3.4rem; line-height: 1.15; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 20px; }
  .highlight-text { background: linear-gradient(120deg, var(--pastel-yellow) 0%, var(--yellow-accent) 100%); padding: 0 6px; border-radius: 6px; }
  .hero-description { font-size: 1.1rem; line-height: 1.6; color: var(--text-muted); max-width: 520px; margin-bottom: 30px; }
  .hero-actions { display: flex; gap: 16px; }

  .btn-navy { background: var(--navy-dark); color: white; padding: 14px 28px; border-radius: 50px; text-decoration: none; font-weight: 700; font-size: 14px; transition: transform 0.2s; }
  .btn-navy:hover { transform: translateY(-2px); }
  .btn-outline { border: 1px solid var(--border-color); color: var(--navy-dark); padding: 14px 28px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 14px; }

  /* VISUAL HERO */
  .hero-visual { position: relative; display: flex; justify-content: center; align-items: center; height: 420px; }
  .circle-bg { position: absolute; width: 340px; height: 340px; background: var(--pastel-yellow); border-radius: 50%; z-index: 1; }
  .profile-photo { position: relative; z-index: 2; max-height: 400px; object-fit: contain; }
  
  .floating-pill { position: absolute; z-index: 3; background: white; padding: 8px 16px; border-radius: 30px; font-size: 12px; font-weight: 700; box-shadow: 0 10px 20px rgba(0,0,0,0.06); border: 1px solid var(--border-color); }
  .pill-1 { top: 20%; left: -10px; }
  .pill-2 { bottom: 15%; left: 10px; background: var(--navy-dark); color: white; }
  .pill-3 { bottom: 25%; right: -10px; background: var(--pastel-yellow); }

  /* BANDA CINTA EN MOVIMIENTO (MARQUEE) */
  .marquee-section { background: var(--navy-dark); color: white; padding: 16px 0; overflow: hidden; white-space: nowrap; }
  .marquee-track { display: inline-block; animation: marquee 25s linear infinite; font-size: 15px; font-weight: 700; letter-spacing: 0.03em; }
  .marquee-track span { margin-right: 36px; }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* PROYECTOS SECTION */
  .projects-section { max-width: 1140px; margin: 80px auto; padding: 0 24px; }
  .section-header { text-align: center; margin-bottom: 50px; }
  .sub-title { color: var(--text-muted); font-size: 12px; font-weight: 800; letter-spacing: 0.1em; }
  .section-header h2 { font-size: 2.5rem; font-weight: 800; margin: 8px 0; }
  .section-header p { color: var(--text-muted); font-size: 15px; }

  .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; }
  .project-card { background: var(--bg-soft); border: 1px solid var(--border-color); border-radius: 16px; overflow: hidden; cursor: pointer; transition: transform 0.3s, box-shadow 0.3s; }
  .project-card:hover { transform: translateY(-6px); box-shadow: 0 20px 30px rgba(0,0,0,0.08); }
  
  .card-mac-header { background: #e2e8f0; padding: 10px 16px; display: flex; justify-content: space-between; align-items: center; }
  .mac-dots { display: flex; gap: 6px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .dot.red { background: #ff5f56; } .dot.yellow { background: #ffbd2e; } .dot.green { background: #27c93f; }
  .card-tag { font-size: 11px; font-weight: 700; color: var(--navy-dark); text-transform: uppercase; }

  .card-body { padding: 20px; text-align: center; }
  .card-img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; margin-bottom: 16px; }
  .card-body h3 { font-size: 18px; margin: 0 0 6px; font-weight: 700; }
  .card-company { font-size: 13px; color: var(--text-muted); margin: 0; }

  /* MODAL ESTILO VENTANA DE NAVEGADOR */
  .modal-overlay { position: fixed; top:0; left:0; width:100%; height:100%; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(8px); display: none; justify-content: center; align-items: center; z-index: 10000; padding: 20px; }
  .modal-overlay.active { display: flex; }

  .modal-window { background: white; width: 100%; max-width: 820px; max-height: 85vh; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 25px 50px rgba(0,0,0,0.25); border: 1px solid var(--border-color); }
  .modal-mac-bar { background: #f1f5f9; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-color); }
  .modal-search-bar { background: white; padding: 6px 16px; border-radius: 20px; font-size: 12px; color: var(--text-muted); border: 1px solid var(--border-color); flex-grow: 1; margin: 0 20px; text-align: center; }
  .close-btn-text { background: none; border: none; font-size: 13px; font-weight: 700; color: var(--navy-dark); cursor: pointer; }

  .modal-content-scroll { overflow-y: auto; padding: 30px; }
  .modal-hero-banner img { width: 100%; max-height: 320px; object-fit: cover; border-radius: 12px; margin-bottom: 24px; }
  .modal-title-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .modal-title-row h2 { font-size: 22px; margin: 0; font-weight: 800; }
  .preview-link { background: var(--pastel-yellow); color: var(--navy-dark); padding: 8px 16px; border-radius: 30px; text-decoration: none; font-size: 12px; font-weight: 700; }

  .modal-description { font-size: 15px; line-height: 1.6; color: var(--text-muted); margin-bottom: 28px; }

  .metadata-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; background: var(--bg-soft); padding: 20px; border-radius: 12px; border: 1px solid var(--border-color); margin-bottom: 30px; }
  .meta-label { font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 4px; }
  .meta-val { font-size: 14px; font-weight: 700; color: var(--navy-dark); }

  .modal-gallery h3 { font-size: 16px; font-weight: 800; margin-bottom: 16px; }
  .gallery-stack { display: flex; flex-direction: column; gap: 20px; }
  .gallery-stack img { width: 100%; border-radius: 12px; border: 1px solid var(--border-color); }

  /* BARRA FLOTANTE DOCK MACOS (PROPORCIÓN CORREGIDA) */
  .floating-dock {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 24px;
    padding: 6px 14px;
    z-index: 9999;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
  }
  .dock-list { display: flex; gap: 14px; list-style: none; margin: 0; padding: 0; align-items: center; }
  .dock-item { position: relative; display: flex; justify-content: center; }
  .dock-link { display: flex; align-items: center; padding: 2px; }
  .mac-icon {
    width: 44px;
    height: 44px;
    object-fit: contain;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.08));
  }
  .dock-link:hover .mac-icon {
    transform: scale(1.25) translateY(-6px);
  }
  .dock-item::before {
    content: attr(data-tooltip);
    position: absolute;
    top: -40px;
    background: var(--navy-dark);
    color: white;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s;
    white-space: nowrap;
    pointer-events: none;
  }
  .dock-item:hover::before { opacity: 1; visibility: visible; top: -44px; }

  /* RESPONSIVE */
  @media (max-width: 800px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero-heading { font-size: 2.4rem; }
    .hero-actions { justify-content: center; }
    .nav-links { display: none; }
    .metadata-grid { grid-template-columns: 1fr; }
  }
</style>
