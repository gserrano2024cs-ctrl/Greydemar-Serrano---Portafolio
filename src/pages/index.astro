      <li class="dock-item" data-tooltip="Servicios" data-tooltip-es="Servicios" data-tooltip-en="Services"><a href="#services" class="dock-link"><img src="/finder icon.png" class="mac-icon" alt="Finder"></a></li>
      <li class="dock-item" data-tooltip="Contacto" data-tooltip-es="Contacto" data-tooltip-en="Contact"><a href="#contact" class="dock-link"><img src="/ICON MAIL.webp" class="mac-icon" alt="Mail"></a></li>
    </ul>
