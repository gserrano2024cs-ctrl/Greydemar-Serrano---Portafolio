---
import Hero from "../components/Hero.astro";
import InfiniteMarquee from "../components/InfiniteMarquee.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import HowIWork from "../components/HowIWork.astro";
import FAQ from "../components/FAQ.astro";
import Projects from "../components/Projects.astro";
import ClientMarquee from "../components/ClientMarquee.astro";
import Footer from "../components/Footer.astro";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>Grey Serrano | Digital Content & Social Media Specialist</title>
  <meta name="title" content="Grey Serrano | Digital Content & Social Media Specialist">
  <meta name="description" content="Portfolio of Grey Serrano, Digital Content Specialist focused on Social Media, Community Management, Video Editing and UX Landing Pages.">
  <meta name="keywords" content="Social Media, Community Management, Video Editing, UX Landing Pages, Digital Growth, Grey Serrano">

  <!-- Open Graph -->
  <meta property="og:title" content="Grey Serrano | Digital Content & Social Media Specialist">
  <meta property="og:description" content="Estrategias y contenidos digitales que ayudan a las marcas a conectar, crear comunidad y transformar ideas en experiencias digitales.">
  <meta property="og:type" content="website">

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%230f172a%22 rx=%2212%22/><text x=%2250%22 y=%2268%22 font-size=%2260%22 font-weight=%22900%22 font-family=%22sans-serif%22 fill=%22%23ffffff%22 text-anchor=%22middle%22>G</text></svg>">

  <!-- FUENTES: MONTSERRAT (Funcional) + PLAYFAIR DISPLAY (Editorial) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
</head>
<body>

  <!-- 1. LOADING SCREEN CINEMATOGRÁFICA -->
  <div id="loading-screen" class="loading-screen">
    <div class="loading-content">
      <span class="loading-title">GREY</span>
      <span class="loading-sub">DIGITAL CONTENT</span>
      <div class="loading-line"></div>
    </div>
  </div>

  <!-- 2. TEXTURA EDITORIAL / GRAIN BACKGROUND GLOBAL FIJO -->
  <div class="global-grain-overlay"></div>

  <!-- 3. ZOOM OVERLAY GLOBAL -->
  <div id="zoom-overlay" class="zoom-overlay" onclick="closeZoom(event)">
    <button class="zoom-close" onclick="closeZoom(event)">✕</button>
    <div class="zoom-content-wrapper">
      <div id="zoom-media-container"></div>
      <p id="zoom-caption"></p>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- SECUENCIA ESTRATÉGICA DE SECCIONES         -->
  <!-- ========================================== -->
  <Hero />
  <InfiniteMarquee />
  <About />
  <Services />
  <HowIWork />
  <FAQ />
  <Projects />
  <ClientMarquee />
  <Footer />

  <!-- ========================================== -->
  <!-- MODALES DE PROYECTOS (SCROLL BLOQUEADO)    -->
  <!-- ========================================== -->

  <!-- MODAL 1: YP REALTY -->
  <div id="modal-yprealty" class="modal-overlay" onclick="closeModalOutside(event, 'modal-yprealty')">
    <div class="modal-window">
      <div class="modal-mac-bar">
        <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
        <div class="modal-search-bar">yprealty.com · Social Media Case</div>
        <button class="close-btn-text" onclick="closeModal('modal-yprealty')">Cerrar</button>
      </div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada-yprealty.png" alt="YP Realty Banner" style="object-position: top center;" /></div>
        <div class="modal-title-row">
          <div class="title-text-group">
            <span class="project-counter">Caso 01 / 06</span>
            <h2>YP Realty</h2>
          </div>
        </div>

        <div class="brief-box">
          <div><strong>Contexto:</strong> Mercado inmobiliario en Puerto Rico con necesidad de captar compradores e inquilinos orgánicos.</div>
          <div><strong>Qué hice:</strong> Planificación estratégica de contenido, redacción de guiones con hooks visuales y edición dinámica de Reels/TikToks.</div>
          <div class="brief-result"><strong>Resultado destacado:</strong> <span class="badge-result">↑ 604.5% en interacciones de contenido</span> y ↑ 56.1% en alcance.</div>
        </div>

        <div class="modal-gallery-container">
          <h3>Piezas y Analítica</h3>
          <div class="bento-collage">
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Cisterna de agua en PR." onclick="openGalleryZoom(this)" style="background:#000;"><source src="/VIDEO PARA PORTAFOLIO.webm" type="video/webm" /></video><div class="media-caption">Cisterna en PR</div></div>
            <div class="media-card bento-vertical"><video playsinline loop muted autoplay class="vertical-vid" data-caption="Cierre de venta en Arecibo." onclick="openGalleryZoom(this)" style="background:#000;"><source src="/PARA-PORTAFOLIO.webm" type="video/webm" /></video><div class="media-caption">Cierre de venta</div></div>
            <div class="media-card bento-horizontal"><img src="/metricas.png" alt="Métricas Reales" class="horizontal-img w-full-img" data-caption="Analítica oficial de interacción (+604.5%)" onclick="openGalleryZoom(this)" /><div class="media-caption">Reporte oficial de analítica (+604.5% interacciones)</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 2: FREELANCE -->
  <div id="modal-freelance" class="modal-overlay" onclick="closeModalOutside(event, 'modal-freelance')">
    <div class="modal-window">
      <div class="modal-mac-bar">
        <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
        <div class="modal-search-bar">freelance.projects</div>
        <button class="close-btn-text" onclick="closeModal('modal-freelance')">Cerrar</button>
      </div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada freelance.png" alt="Freelance Banner" onerror="this.src='/landingpage plataforma.png'" /></div>
        <div class="modal-title-row">
          <div class="title-text-group">
            <span class="project-counter">Caso 02 / 06</span>
            <h2>Landing Pages Freelance</h2>
          </div>
        </div>
        <div class="brief-box">
          <div><strong>Contexto:</strong> Profesionales independientes y marcas que necesitaban presencia web responsive, clara y optimizada.</div>
          <div><strong>Sitios navegables:</strong>
            <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 4px;">
              <a href="https://gserrano2024cs-ctrl.github.io/Dra.LauraNavarroActiveLearningEducationLeadership/" target="_blank" style="color: #2563eb; font-weight: 700;">🌐 Dra. Laura Navarro</a>
              <a href="https://beatriz-brice-o-pic-n.vercel.app/" target="_blank" style="color: #2563eb; font-weight: 700;">🌐 Beatriz Briceño-Picón</a>
              <a href="https://mbihoy.vercel.app/?v=1" target="_blank" style="color: #2563eb; font-weight: 700;">🌐 Mario Briceño Iragorry</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 3: IMPAKTEMOS -->
  <div id="modal-impaktemos" class="modal-overlay" onclick="closeModalOutside(event, 'modal-impaktemos')">
    <div class="modal-window">
      <div class="modal-mac-bar">
        <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
        <div class="modal-search-bar">impaktemos.org</div>
        <button class="close-btn-text" onclick="closeModal('modal-impaktemos')">Cerrar</button>
      </div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada-impaktemos.png" alt="Impaktemos Banner" /></div>
        <div class="modal-title-row">
          <div class="title-text-group">
            <span class="project-counter">Caso 03 / 06</span>
            <h2>Impaktemos — Plataforma Las Minitas</h2>
          </div>
          <a href="https://minitas-mission-guide.lovable.app/" target="_blank" style="color: #2563eb; font-weight: 700; text-decoration: none;">🌐 Ver plataforma →</a>
        </div>
        <div class="brief-box">
          <div><strong>Objetivo:</strong> Diseñar y maquetar una landing page operativa para coordinar voluntarios y tareas comunitarias.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 4: PANHOUSE -->
  <div id="modal-panhouse" class="modal-overlay" onclick="closeModalOutside(event, 'modal-panhouse')">
    <div class="modal-window">
      <div class="modal-mac-bar">
        <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
        <div class="modal-search-bar">editorialpanhouse.com</div>
        <button class="close-btn-text" onclick="closeModal('modal-panhouse')">Cerrar</button>
      </div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada-panhouse.png" alt="PanHouse" /></div>
        <div class="modal-title-row"><h2>Editorial PanHouse</h2></div>
        <div class="brief-box">
          <p>Coordinación entre Marketing, Ventas y RRPP, eventos internacionales (FIL Guadalajara) y automatización con ManyChat.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 5: EUROBUILDING -->
  <div id="modal-eurobuilding" class="modal-overlay" onclick="closeModalOutside(event, 'modal-eurobuilding')">
    <div class="modal-window">
      <div class="modal-mac-bar"><button class="close-btn-text" onclick="closeModal('modal-eurobuilding')">Cerrar</button></div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada-eurobuilding.png" alt="Eurobuilding" /></div>
        <h2>Eurobuilding — B2B & Business Center</h2>
        <div class="brief-box"><p>Gestión corporativa hotelera 5 estrellas y coordinación operativa de 7 departamentos.</p></div>
      </div>
    </div>
  </div>

  <!-- MODAL 6: DISLOCAL -->
  <div id="modal-dislocal" class="modal-overlay" onclick="closeModalOutside(event, 'modal-dislocal')">
    <div class="modal-window">
      <div class="modal-mac-bar"><button class="close-btn-text" onclick="closeModal('modal-dislocal')">Cerrar</button></div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada-dislocal.png" alt="Dislocal" /></div>
        <h2>Dislocal — Producción & Agile</h2>
        <div class="brief-box"><p>Planificación logística ágil para proyectos de impacto social comunitario.</p></div>
      </div>
    </div>
  </div>

  <!-- SCRIPTS GLOBALES -->
  <script is:inline>
    // 1. Loading Screen
    window.addEventListener('load', () => {
      const loader = document.getElementById('loading-screen');
      setTimeout(() => {
        if (loader) {
          loader.classList.add('hide');
          setTimeout(() => loader.remove(), 700);
        }
      }, 900);
    });

    // 2. Idioma
    function setLanguage(lang) {
      document.querySelectorAll('.lang-opt').forEach(btn => btn.classList.remove('active'));
      if (event && event.target) event.target.classList.add('active');
      
      document.querySelectorAll('[data-es]').forEach(el => { 
        el.innerHTML = el.getAttribute(`data-${lang}`); 
      });

      const msg = document.getElementById('wa-message');
      if (msg) {
        msg.placeholder = lang === 'es' ? "Hola Grey, queremos hablar contigo sobre..." : "Hi Grey, we'd like to talk with you about...";
      }
    }

    // 3. Modales con bloqueo de scroll
    function openModal(id) {
      const m = document.getElementById(id);
      if (m) {
        m.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal(id) {
      const m = document.getElementById(id);
      if (m) {
        m.classList.remove('active');
        document.body.style.overflow = 'auto';
      }
    }

    function closeModalOutside(e, id) {
      if (e.target.id === id) closeModal(id);
    }

    // 4. Zoom
    function openGalleryZoom(el) {
      const overlay = document.getElementById('zoom-overlay');
      const container = document.getElementById('zoom-media-container');
      const caption = document.getElementById('zoom-caption');
      container.innerHTML = '';
      if (el.tagName === 'VIDEO') {
        const vid = document.createElement('video');
        vid.src = el.querySelector('source').src;
        vid.controls = true;
        vid.autoplay = true;
        vid.className = 'zoom-media';
        container.appendChild(vid);
      } else {
        const img = document.createElement('img');
        img.src = el.src;
        img.className = 'zoom-media';
        container.appendChild(img);
      }
      caption.innerText = el.getAttribute('data-caption') || '';
      overlay.classList.add('active');
    }

    function closeZoom(e) {
      if (e.target.id === 'zoom-overlay' || e.target.classList.contains('zoom-close')) {
        document.getElementById('zoom-overlay').classList.remove('active');
      }
    }

    // 5. WhatsApp
    function sendToWhatsApp(e) {
      e.preventDefault();
      const accept = document.getElementById('privacy-accept');
      if (!accept.checked) {
        alert("Debes aceptar la política de privacidad.");
        return;
      }
      const name = document.getElementById('wa-name').value;
      const email = document.getElementById('wa-email').value;
      const message = document.getElementById('wa-message').value;
      const phone = "584126339776";
      const text = `¡Hola Grey! Soy ${name} (${email}).%0A%0A${message}`;
      window.open(`https://wa.me/${phone}?text=${text}`, '_blank');
    }
  </script>

</body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Montserrat', sans-serif;
    color: #0f172a;
    background-color: #fcfcfc;
    overflow-x: hidden;
    position: relative;
    -webkit-font-smoothing: antialiased;
  }

  /* LOADING SCREEN CINEMÁTICA */
  .loading-screen {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background: #0f172a;
    z-index: 999999;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: opacity 0.7s ease, visibility 0.7s ease;
  }

  .loading-screen.hide {
    opacity: 0;
    visibility: hidden;
  }

  .loading-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .loading-title {
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: 0.25em;
    color: #ffffff;
    animation: fadeDown 0.8s ease forwards;
  }

  .loading-sub {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    color: #fef08a;
    animation: fadeUp 0.8s ease forwards 0.2s;
    opacity: 0;
  }

  .loading-line {
    width: 40px;
    height: 2px;
    background: #fef08a;
    margin-top: 12px;
    animation: expandLine 0.9s ease forwards 0.4s;
    transform: scaleX(0);
  }

  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes expandLine {
    to { transform: scaleX(1); }
  }

  /* TEXTURA GRAIN EDITORIAL */
  .global-grain-overlay {
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.038'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 2;
  }

  /* MODALES */
  .modal-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(15, 23, 42, 0.78);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10000;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-window {
    background: #ffffff;
    width: 100%;
    max-width: 840px;
    max-height: 88vh;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 60px rgba(0,0,0,0.3);
    transform: translateY(20px) scale(0.98);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-overlay.active .modal-window {
    transform: translateY(0) scale(1);
  }

  .modal-mac-bar {
    background: #f8fafc;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e2e8f0;
  }

  .mac-dots { display: flex; gap: 6px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }

  .modal-search-bar {
    font-size: 12px;
    color: #64748b;
    font-weight: 500;
  }

  .close-btn-text {
    background: none;
    border: none;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
  }

  .modal-content-scroll {
    overflow-y: auto;
    padding: 28px;
  }

  .modal-hero-banner img {
    width: 100%;
    max-height: 280px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 20px;
  }

  .brief-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 18px;
    border-radius: 12px;
    margin-bottom: 24px;
    font-size: 0.95rem;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .badge-result {
    background: #fef08a;
    color: #0f172a;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .bento-collage {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .bento-vertical { grid-column: span 1; }
  .bento-horizontal { grid-column: 1 / -1; }

  .media-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .media-card video, .media-card img {
    width: 100%;
    border-radius: 8px;
    object-fit: cover;
    cursor: zoom-in;
  }

  .vertical-vid { aspect-ratio: 9/16; }
  .w-full-img { height: auto; max-height: 400px; object-fit: contain; }

  .media-caption {
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    text-align: center;
  }

  /* ZOOM OVERLAY */
  .zoom-overlay {
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.92);
    z-index: 99999;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    padding: 20px;
  }

  .zoom-overlay.active { opacity: 1; visibility: visible; }
  .zoom-content-wrapper { position: relative; max-width: 90vw; }
  .zoom-media { max-width: 100%; max-height: 75vh; border-radius: 8px; object-fit: contain; }
  .zoom-caption { color: #ffffff; margin-top: 14px; font-size: 1rem; text-align: center; }
  .zoom-close { position: absolute; top: 25px; right: 35px; background: rgba(255,255,255,0.2); border: none; color: white; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; }
</style>
