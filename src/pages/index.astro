  .zoom-close { position: absolute; top: 25px; right: 35px; background: rgba(255,255,255,0.15); border: none; color: white; width: 44px; height: 44px; border-radius: 50%; font-size: 22px; cursor: pointer; transition: background 0.3s; z-index: 9999999; }

  /* ---------- 2 · LIQUID GLASS ---------- */
  .glass-profile-card,
  .glass-cases-card,
