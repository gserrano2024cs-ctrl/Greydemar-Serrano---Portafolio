  <script is:inline>
    /* ---------- IDIOMA ---------- */
    function setLanguage(lang) {
      document.documentElement.lang = lang;

      document.querySelectorAll('.lang-btn').forEach(function (btn) {
        btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
      });

      document.querySelectorAll('[data-es]').forEach(function (el) {
        var value = el.getAttribute('data-' + lang);
        if (value !== null) { el.innerHTML = value; }
      });

      document.querySelectorAll('[data-tooltip-es]').forEach(function (el) {
        el.setAttribute('data-tooltip', el.getAttribute('data-tooltip-' + lang));
      });

      var msgArea = document.getElementById('wa-message');
      if (msgArea) {
        msgArea.placeholder = lang === 'es' ? msgArea.getAttribute('data-es-placeholder') : "Hi Grey, I'd like to work on...";
      }
    }

    /* ---------- ZOOM DE MEDIA ---------- */
    function openGalleryZoom(element) {
      var overlay = document.getElementById('zoom-overlay');
      var container = document.getElementById('zoom-media-container');
      var caption = document.getElementById('zoom-caption');

      container.innerHTML = '';

      if (element.tagName === 'VIDEO') {
        var video = document.createElement('video');
        video.src = element.currentSrc || element.querySelector('source').src;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.className = 'zoom-media';
        container.appendChild(video);
      } else {
        var img = document.createElement('img');
        img.src = element.currentSrc || element.src;
        img.alt = element.alt || '';
        img.className = 'zoom-media';
        container.appendChild(img);
      }

      /* El pie del zoom se toma del caption visible (siempre en el idioma activo) */
      var card = element.closest('.media-card');
      var cap = card ? card.querySelector('.media-caption') : null;
      var text = cap ? cap.textContent.replace(/\s+/g, ' ').trim() : (element.getAttribute('data-caption') || '');
      caption.textContent = text;

      overlay.classList.add('active');
    }

    function openProfileZoom(event) {
      event.stopPropagation();
      openGalleryZoom(event.currentTarget);
    }

    function closeZoomNow() {
      document.getElementById('zoom-overlay').classList.remove('active');
      document.getElementById('zoom-media-container').innerHTML = '';
    }

    function closeZoom(e) {
      if (e.target.id === 'zoom-overlay' || e.target.classList.contains('zoom-close')) { closeZoomNow(); }
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { closeZoomNow(); }
    });

    /* ---------- FORMULARIO → WHATSAPP ---------- */
    function sendToWhatsApp(event) {
      event.preventDefault();
      var acceptCheckbox = document.getElementById('privacy-accept');
      if (!acceptCheckbox.checked) {
        alert("Debes aceptar la política de privacidad para enviar el mensaje.");
        return;
      }
      var name = document.getElementById('wa-name').value;
      var email = document.getElementById('wa-email').value;
      var message = document.getElementById('wa-message').value;
      var phone = "584126339776";
      var text = "¡Hola Grey! Soy " + name + " (" + email + ").\n\n" + message;
      window.open("https://wa.me/" + phone + "?text=" + encodeURIComponent(text), '_blank');
    }

    /* ---------- TARJETAS DESPLEGABLES (hero + servicios) ---------- */
    document.querySelectorAll('[data-toggle]').forEach(function (el) {
      var cls = el.getAttribute('data-toggle');
      el.setAttribute('role', 'button');
      el.setAttribute('tabindex', '0');
      el.setAttribute('aria-expanded', String(el.classList.contains(cls)));

      function toggle() {
        var open = el.classList.toggle(cls);
        el.setAttribute('aria-expanded', String(open));
      }
      el.addEventListener('click', toggle);
      el.addEventListener('keydown', function (e) {
        if ((e.key === 'Enter' || e.key === ' ') && e.target === el) {
          e.preventDefault();
          toggle();
        }
      });
    });

    /* ---------- ANIMACIONES DE ENTRADA AL HACER SCROLL ---------- */
    (function () {
      var items = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        items.forEach(function (el) { el.classList.add('in-view'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        var visible = entries.filter(function (e) { return e.isIntersecting; });
        visible.forEach(function (entry, i) {
          /* Escalonado suave entre los elementos que entran a la vez */
          entry.target.style.setProperty('--d', Math.min(i, 5));
          entry.target.classList.add('in-view');
          io.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      items.forEach(function (el) { io.observe(el); });
    })();

    /* ---------- VIDEOS: reproducir solo lo visible (rendimiento) ---------- */
    (function () {
      var videos = document.querySelectorAll('video.lazy-video');
      if (!('IntersectionObserver' in window)) {
        videos.forEach(function (v) { v.setAttribute('autoplay', ''); });
        return;
      }
      var vio = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var v = entry.target;
          if (entry.isIntersecting) {
            var p = v.play();
            if (p && p.catch) { p.catch(function () {}); }
          } else {
            v.pause();
          }
        });
      }, { threshold: 0.25 });
      videos.forEach(function (v) { vio.observe(v); });
    })();

    /* ---------- DOCK: sección activa ---------- */
    (function () {
      if (!('IntersectionObserver' in window)) { return; }
      var dockItems = document.querySelectorAll('.dock-item');
      var spy = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            dockItems.forEach(function (item) {
              item.classList.toggle('active', item.getAttribute('data-target') === entry.target.id);
            });
          }
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      ['about', 'projects', 'services', 'contact'].forEach(function (id) {
        var section = document.getElementById(id);
        if (section) { spy.observe(section); }
      });
    })();

    document.addEventListener('DOMContentLoaded', function () {
      document.body.classList.add('loaded');
    });
  </script>

