  <!-- MODAL 4: PANHOUSE -->
  <div id="modal-panhouse" class="modal-overlay" onclick="closeModalOutside(event, 'modal-panhouse')">
    <div class="modal-window">
      <div class="modal-mac-bar">
        <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
        <div class="modal-search-bar">editorialpanhouse.com</div>
        <button class="close-btn-text" onclick="closeModal('modal-panhouse')">Cerrar</button>
      </div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada-panhouse.png" alt="PanHouse Banner" /></div>
        <div class="modal-title-row">
          <div class="title-text-group">
            <span class="project-counter">Experiencia Adicional</span>
            <h2>Editorial PanHouse</h2>
          </div>
        </div>
        <div class="structured-brief">
          <div class="brief-item"><strong>Contexto:</strong> Editorial con despliegue de eventos corporativos internacionales y flujos de ventas de libros.</div>
          <div class="brief-item"><strong>Qué hice:</strong> Sincronización entre departamentos de Marketing, Ventas y RRPP, coordinación logística (FIL Guadalajara) y automatización con ManyChat.</div>
        </div>
        <div class="modal-gallery-container">
          <h3>Galería</h3>
          <div class="bento-collage">
            <div class="media-card bento-horizontal"><img src="/evento ph.png" alt="Evento VIP" class="horizontal-img w-full-img" onclick="openGalleryZoom(this)" /><div class="media-caption">Evento VIP PanHouse</div></div>
            <div class="media-card bento-horizontal"><img src="/manychat.png" alt="ManyChat" class="horizontal-img w-full-img" onclick="openGalleryZoom(this)" /><div class="media-caption">Flujos de automatización ManyChat</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 5: EUROBUILDING -->
  <div id="modal-eurobuilding" class="modal-overlay" onclick="closeModalOutside(event, 'modal-eurobuilding')">
    <div class="modal-window">
      <div class="modal-mac-bar">
        <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
        <div class="modal-search-bar">eurobuilding.com.ve</div>
        <button class="close-btn-text" onclick="closeModal('modal-eurobuilding')">Cerrar</button>
      </div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada-eurobuilding.png" alt="Eurobuilding" /></div>
        <div class="modal-title-row">
          <div class="title-text-group">
            <span class="project-counter">Experiencia Adicional</span>
            <h2>Eurobuilding — Business Center & B2B</h2>
          </div>
        </div>
        <div class="structured-brief">
          <div class="brief-item"><strong>Qué hice:</strong> Gestión de portafolio corporativo B2B, estándares hoteleros 5 estrellas y coordinación entre 7 departamentos operativos con 100% resolución de incidencias.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 6: DISLOCAL -->
  <div id="modal-dislocal" class="modal-overlay" onclick="closeModalOutside(event, 'modal-dislocal')">
    <div class="modal-window">
      <div class="modal-mac-bar">
        <div class="mac-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
        <div class="modal-search-bar">dislocal.org</div>
        <button class="close-btn-text" onclick="closeModal('modal-dislocal')">Cerrar</button>
      </div>
      <div class="modal-content-scroll">
        <div class="modal-hero-banner"><img src="/portada-dislocal.png" alt="Dislocal" /></div>
        <div class="modal-title-row">
          <div class="title-text-group">
            <span class="project-counter">Experiencia Adicional</span>
            <h2>Dislocal — Producción & Agile</h2>
          </div>
          <a href="https://www.dislocal.org/" target="_blank" class="simple-modal-link">🌐 Ver sitio web →</a>
        </div>
        <div class="structured-brief">
          <div class="brief-item"><strong>Qué hice:</strong> Planificación y ejecución logística de proyectos de impacto social con metodologías ágiles coordinando equipos multidisciplinarios.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- SCRIPTS GLOBALES -->
  <script is:inline>
    // Idioma ES / EN
    function setLanguage(lang) {
      document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
      if (event && event.target) event.target.classList.add('active');
      
      document.querySelectorAll('[data-es]').forEach(el => { 
        el.innerHTML = el.getAttribute(`data-${lang}`); 
      });

      const msgArea = document.getElementById('wa-message');
      if (msgArea) { 
        msgArea.placeholder = lang === 'es' ? msgArea.getAttribute('data-es-placeholder') : "Hi Grey, I'd like to work with you on..."; 
      }
    }

    // Modales
    function openModal(modalId) { 
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.add('active'); 
        document.body.style.overflow = 'hidden'; 
      }
    }
    function closeModal(modalId) { 
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.remove('active'); 
        document.body.style.overflow = 'auto'; 
      }
    }
    function closeModalOutside(event, modalId) { 
      if (event.target.id === modalId) { 
        closeModal(modalId); 
      } 
    }

    // Zoom Media
    function openGalleryZoom(element) {
      const overlay = document.getElementById('zoom-overlay');
      const container = document.getElementById('zoom-media-container');
      const caption = document.getElementById('zoom-caption');
      
      container.innerHTML = ''; 
      
      if (element.tagName === 'VIDEO') {
        const video = document.createElement('video');
        video.src = element.querySelector('source').src;
        video.controls = true; 
        video.autoplay = true;
        video.className = 'zoom-media';
        container.appendChild(video);
      } else {
        const img = document.createElement('img');
        img.src = element.src;
        img.className = 'zoom-media';
        container.appendChild(img);
      }
      
      caption.innerText = element.getAttribute('data-caption') || '';
      overlay.classList.add('active');
    }

    function closeZoom(e) {
      if (e.target.id === 'zoom-overlay' || e.target.classList.contains('zoom-close')) {
        document.getElementById('zoom-overlay').classList.remove('active');
        document.getElementById('zoom-media-container').innerHTML = ''; 
      }
    }

    // Envío a WhatsApp
    function sendToWhatsApp(event) {
      event.preventDefault();
      const acceptCheckbox = document.getElementById('privacy-accept');
      if (!acceptCheckbox.checked) {
        alert("Debes aceptar la política de privacidad para enviar el mensaje.");
        return;
      }
      const name = document.getElementById('wa-name').value;
      const email = document.getElementById('wa-email').value;
      const message = document.getElementById('wa-message').value;
      const phone = "584126339776";
      const text = `¡Hola Grey! Soy ${name} (${email}).%0A%0A${message}`;
      window.open(`https://wa.me/${phone}?text=${text}`, '_blank');
    }
  </script>

</body>
</html>

<style is:global>
  :root {
    --navy-dark: #0f172a;
    --navy-light: #1e293b;
    --pastel-yellow: #fef08a;
    --text-body: #475569;
    --border-subtle: #e2e8f0;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Montserrat', sans-serif;
    color: var(--navy-dark);
    background-color: #ffffff;
    overflow-x: hidden;
    position: relative;
    -webkit-font-smoothing: antialiased;
  }

  /* Footer */
  .site-footer {
    background: #000000;
    color: rgba(255, 255, 255, 0.45);
    padding: 30px 20px 100px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 500;
  }

  /* Dock Flotante Mac */
  .floating-dock {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 30px;
    padding: 8px 18px;
    z-index: 999;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }

  .dock-list {
    display: flex;
    gap: 16px;
    list-style: none;
    align-items: center;
  }

  .dock-item {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .mac-icon {
    width: 44px;
    height: 44px;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  .dock-link:hover .mac-icon {
    transform: scale(1.2) translateY(-4px);
  }

  .dock-item::before {
    content: attr(data-tooltip);
    position: absolute;
    top: -38px;
    background: var(--navy-dark);
    color: white;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s;
    white-space: nowrap;
    pointer-events: none;
  }

  .dock-item:hover::before {
    opacity: 1;
    visibility: visible;
    top: -44px;
  }

  /* Modales Estilizados */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10000;
    padding: 20px;
