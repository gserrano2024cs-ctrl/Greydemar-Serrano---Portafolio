---
import Hero from "../components/Hero.astro";
import DisciplineMarquee from "../components/DisciplineMarquee.astro";
import Services from "../components/Services.astro";
import Projects from "../components/Projects.astro";
import ClientMarquee from "../components/ClientMarquee.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>Greydemar Serrano | Growth Marketer & Front-End Developer</title>
  <meta name="title" content="Greydemar Serrano | Growth Marketer & Front-End Developer">
  <meta name="description" content="Growth Marketer especializado en creación de contenido, edición de video, gestión de comunidades y desarrollo web orientado a conversión con Astro.">
  <meta name="keywords" content="Social Media, Content Creator, Video Editor, Community Manager, Growth Marketing, Front-End Developer, Astro, Landing Pages">

  <meta property="og:title" content="Greydemar Serrano | Creative Growth Studio">
  <meta property="og:description" content="Sistemas digitales que atraen, retienen y convierten.">
  <meta property="og:type" content="website">

  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%230f172a%22 rx=%2212%22/><g transform=%22skewX(-15)%22><text x=%2260%22 y=%2272%22 font-size=%2265%22 font-weight=%22900%22 font-family=%22sans-serif%22 fill=%22%23ffffff%22 text-anchor=%22middle%22>G</text></g></svg>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="animate-on-load">

  <!-- SISTEMA DE ZOOM GLOBAL -->
  <div id="zoom-overlay" class="zoom-overlay" onclick="closeZoom(event)">
    <button class="zoom-close" onclick="closeZoom(event)">✕</button>
    <div class="zoom-content-wrapper">
      <div id="zoom-media-container"></div>
      <p id="zoom-caption"></p>
    </div>
  </div>

  <!-- FONDO ESTÁTICO GLOBAL -->
  <div class="global-fixed-bg">
    <svg class="sticker sticker-star" width="45" height="45" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <polyline points="3 3 3 21 21 21" stroke="#FEF08A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <polyline points="3 17 9 11 13 15 21 7" stroke="#FEF08A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <polyline points="14 7 21 7 21 14" stroke="#FEF08A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <svg class="sticker sticker-plant" width="65" height="65" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="3" width="20" height="14" rx="2" stroke="#bbf7d0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M8 21h8" stroke="#bbf7d0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12 17v4" stroke="#bbf7d0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <polyline points="8 8 5 11 8 14" stroke="#bbf7d0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <polyline points="16 8 19 11 16 14" stroke="#bbf7d0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <svg class="sticker sticker-sparkle" width="45" height="45" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" stroke="#fbcfe8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="12" cy="13" r="3" stroke="#fbcfe8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <!-- EL NUEVO ORDEN ESTRATÉGICO -->
  <Hero />
  <DisciplineMarquee />
  <Services />
  <Projects />
  <ClientMarquee />
  <About />
  <Contact />

  <!-- FOOTER NEGRO -->
  <footer class="site-footer black-footer">
    <div class="hidden-eyes-container" title="Lucas 24:31">
      <div style="display: flex; flex-direction: column; align-items: center;">
        <svg width="60" height="25" viewBox="0 0 100 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g class="blinking-eyes">
            <path d="M15,10 L10,0 M25,8 L25,-2 M35,10 L40,0" stroke="#ffffff" stroke-width="1.5"/>
            <path d="M10,20 Q25,5 40,20 Q25,35 10,20 Z" stroke="#ffffff" stroke-width="2.5" fill="none"/>
            <circle cx="25" cy="20" r="4.5" fill="#ffffff"/>
            <path d="M65,10 L60,0 M75,8 L75,-2 M85,10 L90,0" stroke="#ffffff" stroke-width="1.5"/>
            <path d="M60,20 Q75,5 90,20 Q75,35 60,20 Z" stroke="#ffffff" stroke-width="2.5" fill="none"/>
            <circle cx="75" cy="20" r="4.5" fill="#ffffff"/>
          </g>
        </svg>
        <span style="font-size: 9px; letter-spacing: 2px; color: #ffffff; margin-top: 6px; font-weight: 700;">LUCAS 24, 25-33</span>
      </div>
    </div>
    <p data-es="© 2026 Greydemar Serrano. Todos los derechos reservados." data-en="© 2026 Greydemar Serrano. All rights reserved.">© 2026 Greydemar Serrano. Todos los derechos reservados.</p>
  </footer>

  <!-- DOCK FLOTANTE ORIGINAL RESTAURADO -->
  <nav class="floating-dock">
    <ul class="dock-list">
      <li class="dock-item" data-tooltip="Servicios"><a href="#services" class="dock-link"><img src="/finder icon.png" class="mac-icon" alt="Finder"></a></li>
      <li class="dock-item" data-tooltip="Casos"><a href="#projects" class="dock-link"><img src="/foto.png" class="mac-icon" alt="Fotos"></a></li>
      <li class="dock-item" data-tooltip="Sobre mí"><a href="#about" class="dock-link"><img src="/notas.webp" class="mac-icon" alt="Notas"></a></li>
      <li class="dock-item" data-tooltip="Contacto"><a href="#contact" class="dock-link"><img src="/ICON MAIL.webp" class="mac-icon" alt="Mail"></a></li>
    </ul>
  </nav>

  <!-- (NOTA: AQUÍ ABAJO PEGAS LOS MODALES <div id="modal-yprealty">... QUE TENÍAS EN TU INDEX ORIGINAL PARA QUE SIGAN FUNCIONANDO IGUAL, NO LOS BORRES DEL INDEX TODAVÍA HASTA EL SIGUIENTE PASO) -->

  <!-- AQUÍ PEGAS TUS SCRIPTS ORIGINALES (<script is:inline>...</script>) Y LOS ESTILOS GLOBALES (<style is:global>...</style>) -->

  <!-- CSS EXTRA PARA LAS NUEVAS TARJETAS DE PROYECTOS -->
  <style is:global>
    .card-category { font-size: 11px; font-weight: 800; color: #3b82f6; text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.5px; }
    .card-desc { font-size: 13.5px; color: var(--text-muted); line-height: 1.5; margin-bottom: 16px; font-weight: 500; }
    .mini-result { background: #f8fafc; border: 1px solid var(--border-color); padding: 12px; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-top: auto; }
    .mini-result strong { font-size: 1.4rem; font-weight: 900; color: var(--navy-dark); line-height: 1; }
    .mini-result span { font-size: 11px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; margin-top: 4px; }
  </style>

</body>
</html>
