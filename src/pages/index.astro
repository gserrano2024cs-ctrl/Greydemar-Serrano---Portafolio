  <script is:inline>
    function setLanguage(lang, trigger) {
      document.documentElement.lang = lang;
      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.classList.toggle('active', btn === trigger);
        btn.setAttribute('aria-pressed', btn === trigger ? 'true' : 'false');
      });
      
      document.querySelectorAll('[data-es]').forEach(el => { 
        const value = el.getAttribute(`data-${lang}`);
        if (value !== null) el.innerHTML = value;
      });
      
      document.querySelectorAll('[data-tooltip-es]').forEach(el => { 
        el.setAttribute('data-tooltip', el.getAttribute(`data-tooltip-${lang}`)); 
      });
      
      const msgArea = document.getElementById('wa-message');
      if(msgArea) { 
        msgArea.placeholder = lang === 'es' ? msgArea.getAttribute('data-es-placeholder') : "Hi Grey, I'm working on..."; 
      }
    }

    function openModal(modalId) { 
      const modal = document.getElementById(modalId);
      if (!modal) return;
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('modal-open');
      const closeButton = modal.querySelector('.close-btn-text');
      closeButton?.focus({ preventScroll: true });
    }

    function closeModal(modalId) { 
      const modal = document.getElementById(modalId);
      if (!modal) return;
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      if (!document.querySelector('.modal-overlay.active') && !document.getElementById('zoom-overlay')?.classList.contains('active')) {
        document.body.classList.remove('modal-open');
      }
    }

    function closeModalOutside(event, modalId) {
      if (event.target.id === modalId) closeModal(modalId);
    }

    function openCardFromKeyboard(event, modalId) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openModal(modalId);
      }
    }

    function toggleProfileZoom(event) {
        event.stopPropagation();
        event.target.classList.toggle('zoomed');
    }
    
    function openImageBySelector(src, captionText) {
        const overlay = document.getElementById('zoom-overlay');
        const container = document.getElementById('zoom-media-container');
        const caption = document.getElementById('zoom-caption');
        if (!overlay || !container || !caption) return;
        container.innerHTML = '';
        const img = document.createElement('img');
        img.src = src;
        img.className = 'zoom-media';
        img.alt = captionText || '';
        container.appendChild(img);
        caption.innerText = captionText || '';
        overlay.classList.add('active');
        document.body.classList.add('modal-open');
    }

    function openGalleryZoom(element) {
        const overlay = document.getElementById('zoom-overlay');
        const container = document.getElementById('zoom-media-container');
        const caption = document.getElementById('zoom-caption');
        
        container.innerHTML = ''; 
        
        if (element.tagName === 'VIDEO') {
            const video = document.createElement('video');
            video.src = element.querySelector('source').src;
            video.controls = true; 
            video.autoplay = true;
            video.className = 'zoom-media';
            container.appendChild(video);
        } else {
            const img = document.createElement('img');
            img.src = element.src;
            img.className = 'zoom-media';
            container.appendChild(img);
        }
        
        caption.innerText = element.getAttribute('data-caption') || '';
        overlay.classList.add('active');
        document.body.classList.add('modal-open');
    }

    function closeZoom(e) {
        if (e.target.id === 'zoom-overlay' || e.target.classList.contains('zoom-close')) {
            document.getElementById('zoom-overlay').classList.remove('active');
            document.getElementById('zoom-media-container').innerHTML = '';
            if (!document.querySelector('.modal-overlay.active')) document.body.classList.remove('modal-open');
        }
    }

    document.addEventListener('click', function(event) {
        const profileImg = document.getElementById('heroProfileImg');
        if (profileImg && profileImg.classList.contains('zoomed') && event.target !== profileImg) {
            profileImg.classList.remove('zoomed');
        }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      const zoom = document.getElementById('zoom-overlay');
      if (zoom?.classList.contains('active')) {
        zoom.classList.remove('active');
        document.getElementById('zoom-media-container').innerHTML = '';
      }

      document.querySelectorAll('.modal-overlay.active').forEach(modal => {
        closeModal(modal.id);
      });

      document.getElementById('heroProfileImg')?.classList.remove('zoomed');
    });

    function sendToWhatsApp(event) {
      event.preventDefault();
      const acceptCheckbox = document.getElementById('privacy-accept');
      if(!acceptCheckbox.checked) {
          alert("Debes aceptar la política de privacidad para enviar el mensaje.");
          return;
      }
      const name = document.getElementById('wa-name').value;
      const email = document.getElementById('wa-email').value;
      const message = document.getElementById('wa-message').value;
      const phone = "584126339776";
      const text = encodeURIComponent(`¡Hola Grey! Soy ${name} (${email}).\n\n${message}`);
      window.open(`https://wa.me/${phone}?text=${text}`, '_blank', 'noopener,noreferrer');
    }

    document.addEventListener("DOMContentLoaded", () => {
      document.body.classList.add('loaded');

      const revealItems = document.querySelectorAll('.reveal-card');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        }, { threshold: 0.14, rootMargin: '0px 0px -30px 0px' });
        revealItems.forEach((item) => revealObserver.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }

      const sections = ['about', 'projects', 'services', 'contact']
        .map(id => document.getElementById(id))
        .filter(Boolean);
      const dockLinks = [...document.querySelectorAll('.dock-link')];
      if ('IntersectionObserver' in window) {
        const navObserver = new IntersectionObserver((entries) => {
          const visible = entries.filter(e => e.isIntersecting).sort((a,b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          dockLinks.forEach(link => link.classList.toggle('active', link.getAttribute('href') === `#${visible.target.id}`));
        }, { threshold: [0.18, 0.4, 0.65], rootMargin: '-20% 0px -55% 0px' });
        sections.forEach(section => navObserver.observe(section));
      }
    });
  </script>

</body>
</html>

<style is:global>
