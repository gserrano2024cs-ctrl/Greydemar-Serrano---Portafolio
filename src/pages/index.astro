  .hero-socials a:hover { transform: translateY(-2px); background: rgba(255,255,255,.88); }
  .hero-socials svg { width: 18px; height: 18px; fill: none; stroke: #111; stroke-width: 1.65; stroke-linecap: round; stroke-linejoin: round; }

  .hero-lang {
