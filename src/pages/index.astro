  .process-piece-d { width: 33%; height: 245px; right: 1%; bottom: 44px; transform: rotate(-5deg); }
  .process-piece-a:hover { transform: rotate(-1deg) translateY(-8px) scale(1.015); }
  .process-piece-b:hover { transform: rotate(1deg) translateY(-8px) scale(1.015); }
  .process-piece-c:hover { transform: rotate(0deg) translateY(-8px) scale(1.015); }
  .process-piece-d:hover { transform: rotate(-1deg) translateY(-8px) scale(1.015); }

  /* Skills: a clean 3×2 system instead of uneven accordions. */
  .services-container { max-width: 1180px; }
  .skills-section-header { max-width: 880px; }
  .capability-grid { width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .capability-card {
    min-height: 286px;
    padding: 26px;
    border-radius: 24px;
    background: rgba(255,255,255,.78);
    border: 1px solid rgba(15,23,42,.08);
    box-shadow: 0 12px 32px rgba(15,23,42,.055), inset 0 1px 0 rgba(255,255,255,.9);
    display: flex;
    flex-direction: column;
    transition: transform .4s cubic-bezier(.16,1,.3,1), box-shadow .35s ease;
  }
  .capability-card:hover { transform: translateY(-5px); box-shadow: 0 22px 48px rgba(15,23,42,.09), inset 0 1px 0 #fff; }
  .capability-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 42px; }
  .capability-index { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .75rem; color: #7b8797; }
  .capability-status { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 5px rgba(34,197,94,.08); }
  .capability-card h3 { font-size: clamp(1.4rem, 2vw, 1.82rem); line-height: 1.04; letter-spacing: -.045em; margin-bottom: 14px; }
  .capability-card p { font-size: 1rem; line-height: 1.55; color: #5d6877; margin-bottom: 26px; }
  .capability-tags { margin-top: auto; display: flex; flex-wrap: wrap; gap: 7px; }
  .capability-tags span { padding: 7px 10px; border-radius: 999px; background: #f1f5f9; border: 1px solid rgba(15,23,42,.06); color: #4f5d6e; font-size: .72rem; font-weight: 750; }

  /* Focused case modals. */
  .modal-window { max-width: 900px; border-radius: 22px; }
  .modal-content-scroll { padding: 36px; }
  .modal-hero-banner img,
  .modal-hero-banner video { width: 100%; max-height: 390px; aspect-ratio: 16 / 8.5; object-fit: cover; border-radius: 16px; margin-bottom: 28px; border: 1px solid rgba(15,23,42,.07); background: #0b1220; }
  .modal-video-hero video { display: block; }
  .modal-title-row h2 { font-size: clamp(1.8rem, 4vw, 2.7rem); line-height: 1.04; letter-spacing: -.045em; }
  .project-counter { font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: #7b8797; margin-bottom: 7px; }
  .modal-description { font-size: clamp(1rem, 1.4vw, 1.12rem); line-height: 1.72; max-width: 790px; color: #536071; }
  .metadata-grid { gap: 12px; padding: 18px; border-radius: 16px; }
  .meta-label { font-size: .7rem; }
  .meta-val { font-size: .94rem; line-height: 1.4; }
  .media-caption { font-size: .9rem; }
  .single-evidence-card { display: grid; grid-template-columns: .72fr 1.28fr; gap: 24px; align-items: center; background: #f7f9fc; border: 1px solid rgba(15,23,42,.08); border-radius: 20px; padding: 22px; }
  .single-evidence-card img { width: 100%; border-radius: 14px; cursor: zoom-in; box-shadow: 0 8px 25px rgba(15,23,42,.08); }
  .evidence-copy span { font-size: .72rem; text-transform: uppercase; letter-spacing: .09em; color: #8490a0; font-weight: 800; }
  .evidence-copy h3 { font-size: 1.45rem; line-height: 1.08; letter-spacing: -.035em; margin: 8px 0 12px; }
  .evidence-copy p { color: #647184; line-height: 1.55; font-size: .96rem; }
  .case-notes-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .case-notes-grid.two-up { grid-template-columns: repeat(2, 1fr); }
  .case-notes-grid > div { min-height: 170px; padding: 20px; border-radius: 18px; background: #f7f9fc; border: 1px solid rgba(15,23,42,.075); }
  .case-notes-grid span { display: block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: #94a0af; font-size: .72rem; margin-bottom: 28px; }
  .case-notes-grid strong { display: block; font-size: 1.12rem; margin-bottom: 8px; }
  .case-notes-grid p { font-size: .92rem; line-height: 1.5; color: #647184; }
  .compact-gallery { margin-top: 24px; }

  /* Dock: always floating, including iPhone safe area. */
  .floating-dock {
    position: fixed !important;
    top: auto !important;
    left: 50% !important;
    right: auto !important;
    bottom: max(18px, env(safe-area-inset-bottom)) !important;
    transform: translateX(-50%) !important;
    width: max-content;
    max-width: calc(100vw - 28px);
    padding: 8px 15px !important;
    border-radius: 26px !important;
    z-index: 9990 !important;
    transition: opacity .25s ease, transform .3s cubic-bezier(.16,1,.3,1) !important;
  }
  body.modal-open .floating-dock { opacity: 0; pointer-events: none; transform: translate(-50%, 18px) !important; }
  .dock-list { gap: 11px; }
  .mac-icon { width: 46px; height: 46px; }
  .dock-link { border-radius: 15px; padding: 2px; position: relative; }
  .dock-link.active::after { content: ''; position: absolute; width: 4px; height: 4px; border-radius: 50%; background: rgba(15,23,42,.65); left: 50%; bottom: -5px; transform: translateX(-50%); }
  .dock-link:hover .mac-icon { transform: translateY(-4px) scale(1.08); }

  /* Reveal motion: similar editorial rhythm, subtle and purposeful. */
  .reveal-card { opacity: 0; transform: translateY(24px) scale(.985); }
  .reveal-card.is-visible { opacity: 1; transform: none; transition: opacity .65s ease, transform .8s cubic-bezier(.16,1,.3,1); }

