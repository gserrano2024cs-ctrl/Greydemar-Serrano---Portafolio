---
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import HowIWork from "../components/HowIWork.astro";
import FAQ from "../components/FAQ.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>Greydemar Serrano (Grey) | Digital Content & Social Media Specialist</title>
  <meta name="title" content="Greydemar Serrano (Grey) | Digital Content & Social Media Specialist">
  <meta name="description" content="Portfolio of Greydemar Serrano, Digital Content Specialist focused on Social Media, Community Management, Video Editing and UX Landing Pages.">

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%230f172a%22 rx=%2212%22/><text x=%2250%22 y=%2268%22 font-size=%2260%22 font-weight=%22900%22 font-family=%22sans-serif%22 fill=%22%23b91c1c%22 text-anchor=%22middle%22>G</text></svg>">

  <!-- FUENTES EDITORIALES -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
</head>
<body>

  <!-- 1. LOADING SCREEN DE ESTUDIO CREATIVO -->
  <div id="studio-loader" class="studio-loader">
    <div class="loader-inner-content">
      <span class="loader-brand-name">GREY</span>
      <span class="loader-sub-discipline">DIGITAL CONTENT & SOCIAL MEDIA</span>
      <div class="loader-bar-progress"></div>
    </div>
  </div>

  <!-- 2. TEXTURA GLOBAL GRAIN EDITORIAL -->
  <div class="editorial-grain-overlay"></div>

  <!-- 3. ZOOM OVERLAY GLOBAL -->
  <div id="zoom-overlay" class="zoom-overlay" onclick="closeZoom(event)">
    <button class="zoom-close" onclick="closeZoom(event)">✕</button>
    <div class="zoom-content-wrapper">
      <div id="zoom-media-container"></div>
      <p id="zoom-caption"></p>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- NARRATIVA ESTRATÉGICA DEL PORTAFOLIO       -->
  <!-- ========================================== -->
  <Hero />
  <About />
  <Services />
  <HowIWork />
  <FAQ />
  <Projects />
  <Contact />

  <!-- ========================================== -->
  <!-- MODALES DE CASOS DE ESTUDIO PROFUNDOS      -->
  <!-- ========================================== -->

  <!-- MODAL 1: YARILIZ PIZARRO (YP REALTY) -->
  <div id="modal-yprealty" class="modal-backdrop" onclick="closeModalOutside(event, 'modal-yprealty')">
    <div class="modal-dialog-box">
      <div class="modal-top-bar">
        <span class="modal-tag">Caso de Estudio 01</span>
        <button class="modal-dismiss-btn" onclick="closeModal('modal-yprealty')">✕ Cerrar</button>
      </div>
      <div class="modal-scrollable-body">
        <div class="modal-banner"><img src="/portada-yprealty.png" alt="YP Realty Banner" /></div>
        <h2>Yariliz Pizarro · YP Realty</h2>
        <span class="modal-sub">Estrategia de Contenido, Video Editing y Crecimiento Orgánico</span>

        <div class="case-study-deep-dossier">
          <div class="dossier-row">
            <strong>Contexto:</strong>
            <p>Agencia inmobiliaria en Puerto Rico con necesidad de captar compradores e inquilinos de alto valor de forma orgánica en redes sociales sin depender exclusivamente de pauta publicitaria.</p>
          </div>
          <div class="dossier-row">
            <strong>Qué hice:</strong>
            <p>Diseñé la estrategia integral de contenido, rediseñé la narrativa de guiones con hooks visuales y produje piezas dinámicas en video vertical (Reels/TikToks) con edición milimétrica y SEO para bienes raíces.</p>
          </div>
          <div class="dossier-row highlight-row">
            <strong>Resultado:</strong>
            <p><span class="result-number">↑ 604.5%</span> de incremento en interacciones de contenido y <span class="result-number">↑ 56.1%</span> de alcance orgánico durante el periodo de ejecución.</p>
          </div>
        </div>

        <div class="modal-media-gallery">
          <h3>Material Audiovisual</h3>
          <div class="bento-gallery-grid">
            <div class="media-card bento-vert"><video playsinline loop muted autoplay class="v-vid" data-caption="Cisterna en PR" onclick="openGalleryZoom(this)"><source src="/VIDEO PARA PORTAFOLIO.webm" type="video/webm" /></video><span class="v-caption">Cisterna en PR</span></div>
            <div class="media-card bento-vert"><video playsinline loop muted autoplay class="v-vid" data-caption="Cierre de venta" onclick="openGalleryZoom(this)"><source src="/PARA-PORTAFOLIO.webm" type="video/webm" /></video><span class="v-caption">Cierre en Arecibo</span></div>
            <div class="media-card bento-horiz"><img src="/metricas.png" alt="Métricas" class="h-img" data-caption="Reporte oficial de analítica (+604.5% interacciones)" onclick="openGalleryZoom(this)" /><span class="v-caption">Reporte de métricas (+604.5% interacciones)</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 2: LANDING PAGES FREELANCE -->
  <div id="modal-freelance" class="modal-backdrop" onclick="closeModalOutside(event, 'modal-freelance')">
    <div class="modal-dialog-box">
      <div class="modal-top-bar">
        <span class="modal-tag">Caso de Estudio 02</span>
        <button class="modal-dismiss-btn" onclick="closeModal('modal-freelance')">✕ Cerrar</button>
      </div>
      <div class="modal-scrollable-body">
        <div class="modal-banner"><img src="/portada freelance.png" alt="Landing Pages" onerror="this.src='/landingpage plataforma.png'" /></div>
        <h2>Landing Pages — Casos de Autoridad</h2>
        <span class="modal-sub">Dra. Laura Navarro, Beatriz Briceño & Mario Briceño Iragorry</span>

        <div class="case-study-deep-dossier">
          <div class="dossier-row">
            <strong>Dra. Laura Navarro:</strong>
            <p>Psicóloga especializada en mindfulness y lectoescritura infantil en Puerto Rico. Proyecto: Diseño y desarrollo web enfocado en vender servicios profesionales de acompañamiento escolar y psicológico.</p>
            <a href="https://gserrano2024cs-ctrl.github.io/Dra.LauraNavarroActiveLearningEducationLeadership/" target="_blank" class="live-portal-btn">🌐 Visitar portal en vivo: Dra. Laura Navarro →</a>
          </div>

          <div class="dossier-row">
            <strong>Beatriz Briceño:</strong>
            <p>Periodista y humanista reconocida internacionalmente. Proyecto: Portal digital para organizar artículos, trayectoria, libros y conferencias con una arquitectura UX impecable.</p>
            <a href="https://beatriz-brice-o-pic-n.vercel.app/" target="_blank" class="live-portal-btn">🌐 Visitar portal en vivo: Beatriz Briceño →</a>
          </div>

          <div class="dossier-row">
            <strong>Mario Briceño Iragorry:</strong>
            <p>Portal histórico y documental para organizar ensayos, contenido inédito y memoria histórica.</p>
            <a href="https://mbihoy.vercel.app/?v=1" target="_blank" class="live-portal-btn">🌐 Visitar portal en vivo: Mario Briceño Iragorry →</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 3: IMPACTEMOS -->
  <div id="modal-impaktemos" class="modal-backdrop" onclick="closeModalOutside(event, 'modal-impaktemos')">
    <div class="modal-dialog-box">
      <div class="modal-top-bar">
        <span class="modal-tag">Caso de Estudio 03</span>
        <button class="modal-dismiss-btn" onclick="closeModal('modal-impaktemos')">✕ Cerrar</button>
      </div>
      <div class="modal-scrollable-body">
        <div class="modal-banner"><img src="/portada-impaktemos.png" alt="Impactemos" /></div>
        <h2>Impactemos — Plataforma Las Minitas</h2>
        <span class="modal-sub">UX / UI, Operaciones y Plataforma Digital</span>

        <div class="case-study-deep-dossier">
          <div class="dossier-row">
            <strong>Contexto:</strong>
            <p>Organización sin fines de lucro venezolana enfocada en programas nacionales de voluntariado y refuerzo escolar en comunidades vulnerables.</p>
          </div>
          <div class="dossier-row">
            <strong>Qué hice:</strong>
            <p>Diseño y desarrollo de la plataforma web 'Las Minitas' junto al equipo coordinador para organizar flujos de voluntarios, asignación de tareas operativas y monitoreo de campo en tiempo real.</p>
            <a href="https://minitas-mission-guide.lovable.app/" target="_blank" class="live-portal-btn">🌐 Ver plataforma Las Minitas →</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 4: PANHOUSE -->
  <div id="modal-panhouse" class="modal-backdrop" onclick="closeModalOutside(event, 'modal-panhouse')">
    <div class="modal-dialog-box">
      <div class="modal-top-bar"><button class="modal-dismiss-btn" onclick="closeModal('modal-panhouse')">✕ Cerrar</button></div>
      <div class="modal-scrollable-body">
        <h2>Editorial PanHouse</h2>
        <p><strong>Marketing y Comunicación editorial:</strong> Coordinación de operaciones entre Marketing, Ventas y Relaciones Públicas, incluyendo eventos internacionales como la FIL Guadalajara e integración de automatizaciones de atención con ManyChat.</p>
      </div>
    </div>
  </div>

  <!-- MODAL 5: DISLOCAL -->
  <div id="modal-dislocal" class="modal-backdrop" onclick="closeModalOutside(event, 'modal-dislocal')">
    <div class="modal-dialog-box">
      <div class="modal-top-bar"><button class="modal-dismiss-btn" onclick="closeModal('modal-dislocal')">✕ Cerrar</button></div>
      <div class="modal-scrollable-body">
        <h2>Dislocal — Project Manager</h2>
        <p><strong>Responsabilidades:</strong> Coordinación internacional de proyectos de impacto social comunitario, gestión ágil de tareas con Trello/Asana, comunicación estratégica y despliegue logístico en terreno.</p>
      </div>
    </div>
  </div>

  <!-- MODAL 6: EUROBUILDING -->
  <div id="modal-eurobuilding" class="modal-backdrop" onclick="closeModalOutside(event, 'modal-eurobuilding')">
    <div class="modal-dialog-box">
      <div class="modal-top-bar"><button class="modal-dismiss-btn" onclick="closeModal('modal-eurobuilding')">✕ Cerrar</button></div>
      <div class="modal-scrollable-body">
        <h2>Eurobuilding — Business Center & B2B</h2>
        <p><strong>Experiencia:</strong> Gestión de portafolio corporativo 5 estrellas, coordinación de ventas de salones corporativos y centralización de comunicaciones internas entre 7 departamentos críticos alcanzando 100% de resolución de incidencias.</p>
      </div>
    </div>
  </div>

  <!-- CONTROLADORES GLOBALES JS -->
  <script is:inline>
    // 1. Loading screen de estudio
    window.addEventListener('load', () => {
      const loader = document.getElementById('studio-loader');
      setTimeout(() => {
        if (loader) {
          loader.classList.add('fade-out');
          setTimeout(() => loader.remove(), 700);
        }
      }, 850);
    });

    // 2. Idioma ES / EN (Español por defecto)
    function setLanguage(lang) {
      document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
      if (event && event.target) event.target.classList.add('active');
      
      document.querySelectorAll('[data-es]').forEach(el => { 
        el.innerHTML = el.getAttribute(`data-${lang}`); 
      });
    }

    // 3. Modales con bloqueo de scroll detrás
    function openModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = 'auto';
      }
    }

    function closeModalOutside(e, id) {
      if (e.target.id === id) closeModal(id);
    }

    // 4. Zoom de Galería
    function openGalleryZoom(el) {
      const overlay = document.getElementById('zoom-overlay');
      const container = document.getElementById('zoom-media-container');
      const caption = document.getElementById('zoom-caption');
      container.innerHTML = '';
      if (el.tagName === 'VIDEO') {
        const vid = document.createElement('video');
        vid.src = el.querySelector('source').src;
        vid.controls = true;
        vid.autoplay = true;
        vid.className = 'zoom-media';
        container.appendChild(vid);
      } else {
        const img = document.createElement('img');
        img.src = el.src;
        img.className = 'zoom-media';
        container.appendChild(img);
      }
      caption.innerText = el.getAttribute('data-caption') || '';
      overlay.classList.add('active');
    }

    function closeZoom(e) {
      if (e.target.id === 'zoom-overlay' || e.target.classList.contains('zoom-close')) {
        document.getElementById('zoom-overlay').classList.remove('active');
      }
    }
  </script>

</body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Montserrat', sans-serif;
    color: #0f172a;
    background-color: #fcfcfc;
    overflow-x: hidden;
    position: relative;
    -webkit-font-smoothing: antialiased;
  }

  /* LOADING SCREEN CINEMÁTICA */
  .studio-loader {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background: #090d16;
    z-index: 999999;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: opacity 0.7s ease, visibility 0.7s ease;
  }

  .studio-loader.fade-out {
    opacity: 0;
    visibility: hidden;
  }

  .loader-inner-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .loader-brand-name {
    font-size: 3.4rem;
    font-weight: 900;
    letter-spacing: 0.28em;
    color: #ffffff;
    animation: fadeInDown 0.8s ease forwards;
  }

  .loader-sub-discipline {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    color: #fef08a;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards 0.2s;
  }

  .loader-bar-progress {
    width: 48px;
    height: 2px;
    background: #b91c1c;
    margin-top: 10px;
    transform: scaleX(0);
    animation: expandLine 0.9s ease forwards 0.4s;
  }

  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes expandLine {
    to { transform: scaleX(1); }
  }

  /* TEXTURA GRAIN EDITORIAL */
  .editorial-grain-overlay {
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.038'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 2;
  }

  /* MODALES PROFUNDOS */
  .modal-backdrop {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(10, 15, 29, 0.82);
    backdrop-filter: blur(10px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10000;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.35s ease;
  }

  .modal-backdrop.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-dialog-box {
    background: #ffffff;
    width: 100%;
    max-width: 860px;
    max-height: 88vh;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 30px 70px rgba(0,0,0,0.35);
    transform: translateY(24px) scale(0.98);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-backdrop.active .modal-dialog-box {
    transform: translateY(0) scale(1);
  }

  .modal-top-bar {
    background: #f8fafc;
    padding: 14px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e2e8f0;
  }

  .modal-tag {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #b91c1c;
  }

  .modal-dismiss-btn {
    background: none;
    border: none;
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
    cursor: pointer;
  }

  .modal-scrollable-body {
    overflow-y: auto;
    padding: 32px;
  }

  .modal-banner img {
    width: 100%;
    max-height: 280px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 22px;
  }

  .modal-scrollable-body h2 {
    font-size: 1.8rem;
    font-weight: 900;
    color: #0f172a;
    margin-bottom: 4px;
  }

  .modal-sub {
    font-size: 0.95rem;
    font-weight: 600;
    color: #64748b;
    display: block;
    margin-bottom: 24px;
  }

  .case-study-deep-dossier {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 22px;
    border-radius: 14px;
    margin-bottom: 30px;
  }

  .dossier-row strong {
    font-size: 1.05rem;
    color: #0f172a;
    display: block;
    margin-bottom: 4px;
  }

  .dossier-row p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  .highlight-row {
    border-top: 1px solid #e2e8f0;
    padding-top: 14px;
  }

  .result-number {
    font-weight: 900;
    color: #0f172a;
    background: #fef08a;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .live-portal-btn {
    display: inline-block;
    margin-top: 8px;
    color: #2563eb;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .live-portal-btn:hover {
    text-decoration: underline;
  }

  .modal-media-gallery h3 {
    font-size: 1.2rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 16px;
  }

  .bento-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .bento-vert { grid-column: span 1; }
  .bento-horiz { grid-column: 1 / -1; }

  .media-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .media-card video, .media-card img {
    width: 100%;
    border-radius: 8px;
    object-fit: cover;
    cursor: zoom-in;
  }

  .v-vid { aspect-ratio: 9/16; }
  .h-img { height: auto; max-height: 380px; object-fit: contain; }

  .v-caption {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-align: center;
  }

  /* ZOOM OVERLAY */
  .zoom-overlay {
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.94);
    z-index: 99999;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    padding: 20px;
  }

  .zoom-overlay.active { opacity: 1; visibility: visible; }
  .zoom-content-wrapper { position: relative; max-width: 90vw; }
  .zoom-media { max-width: 100%; max-height: 75vh; border-radius: 8px; object-fit: contain; }
  .zoom-caption { color: #ffffff; margin-top: 14px; font-size: 1rem; text-align: center; }
  .zoom-close { position: absolute; top: 25px; right: 35px; background: rgba(255,255,255,0.2); border: none; color: white; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; }
</style>
